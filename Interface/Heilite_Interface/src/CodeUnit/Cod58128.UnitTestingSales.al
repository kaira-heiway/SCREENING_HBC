        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        //SalesOrder.SalesLines."Location Code".SETVALUE(Location.Code); //HEI.19

        //Step 4: Receive Error for Release due to credit limit exceeded
