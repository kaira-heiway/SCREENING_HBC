        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        Bin: Record Bin;
        WarehouseShipmentLine: Record "Warehouse Shipment Line";
        Zone: Record Zone;
        ItemTrackingCode: Record "Item Tracking Code";
        EbfCombination: Record "Ebf Combination FND";
        SalesOrderTrackingLines: TestPage "Item Tracking Lines";//BC Upgrade 
    begin
        ClearVariables('OTC122'); //HEI.31
        //HEI.53>>
        //Update EBF Combination
        EbfCombination.RESET;
        EbfCombination.SETCURRENTKEY("GL Account No.", "Dimension Code", "Dimension Value Code");
        EbfCombination.SETRANGE("Dimension Code", GeneralLedgerSetup."Shortcut Dimension 3 Code");
        EbfCombination.SETFILTER("Combination Restriction", '%1|%2', EbfCombination."Combination Restriction"::"Allowed with Warn", EbfCombination."Combination Restriction"::"Not Allowed");
        EbfCombination.DELETEALL;
        //HEI.53<<
        //HEI.10>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        CustomerNoFilter := Customer."No.";
        //HEI.15>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Customer."Purchasing Code" <> '' THEN
        //     Customer."Purchasing Code" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF Customer."Shipping Advice" = Customer."Shipping Advice"::Partial THEN
            Customer."Shipping Advice" := Customer."Shipping Advice"::Complete;
        Customer.MODIFY;
        //HEI.15<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.15>>
        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN
            IF ItemTrackingCode."Strict Expiration Posting" THEN BEGIN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
                ItemTrackingCode.MODIFY;
            END;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Multiple Order Route" THEN BEGIN
            Route."Multiple Order Route" := FALSE;
            Route.MODIFY;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);

        //HEI.36>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // Route."Location Code" := Location.Code;
        // Route."Return Location Code" := Location.Code;
        //BC Upgrade VAMSIU01 replaced location code fields from route table with new fields >>
        Route."Shipping Location" := Location.Code;
        Route."Receipt Location" := Location.Code;
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.36<<

        //Check the default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::Bin);
        Bin.SETRANGE(Code, UnitTestingValues.Value);
        Bin.FINDFIRST;

        IF Location."Shipment Bin Code" <> Bin.Code THEN BEGIN
            Location."Shipment Bin Code" := Bin.Code;
            Location.MODIFY;
        END;

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Ship. Agent Serv. Mand. APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::"Shipping Agent Services");
            ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value);
        END;

        //Check the default value for Driver
        IF Route."Driver Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::Driver107FDW);
            Driver.GET(UnitTestingValues.Value);
        END;

        //Check the default value for Truck
        IF Route."Vehicle Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::Vehicle101FDW);
            Truck.GET(UnitTestingValues.Value);
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Location
        //UnitTestingValues.RESET;
        //UnitTestingValues.GET('OTC122',COMPANYNAME,DATABASE::Location);
        //Location.GET(UnitTestingValues.Value);
        //HEI.15<<
        IF Location."Sales Gate Entry Mandatory FND" THEN BEGIN
            Location."Sales Gate Entry Mandatory FND" := FALSE;
            Location.MODIFY;
        END;

        //Check default value for Lot
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::"Lot No. Information");
        LotNoFilter := UnitTestingValues.Value;

        //Step 1: Login
        //Disable Notifications for Credit Limit and Stockout
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        //HEI.15>>
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Activate CIS System FND" THEN
            SalesReceivablesSetup."Activate CIS System FND" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.15<<

        SundrySalesOrderStock.OPENVIEW;

        //Step 5: Create new Order
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        SalesOrder."No.".ASSISTEDIT;
        SalesOrder."Document Subtype Code".SETVALUE(SundrySalesOrderStock."Document Subtype Code".VALUE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);
        SalesOrder."External Document No.".SETVALUE('Unit Test OTC122');
        SalesOrder."Location Code".SETVALUE(Location.Code); //HEI.15

        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        SalesOrder.SalesLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure"); // BC Upgrade PATELP08 - added: force BASE UoM so line base qty=1 matches lot qty (else "Qty. to Handle must be 24")
        SalesOrder.SalesLines."Location Code".SETVALUE(Location.Code);

        //BC Upgrade VAMSIU01 Added
        IF Item."Item Tracking Code" <> '' THEN BEGIN
            // BC Upgrade PATELP08 - v28: TRAP threw "Unhandled UI: ModalPage 6510"; use ItemTrackingLinesModalPageHandler (fills from LotNoFilter + ItemTrackingQtyBase)
            ItemTrackingQtyBase := 1;
            SalesOrder.SalesLines.ItemTrackingLines.INVOKE;
            // SalesOrderTrackingLines.TRAP; // BC Upgrade PATELP08 - commented: TRAP -> "Unhandled UI: ModalPage 6510"
            // SalesOrderTrackingLines."Lot No.".SETVALUE(LotNoFilter); // BC Upgrade PATELP08 - now done in the handler
            // SalesOrderTrackingLines."Quantity (Base)".SETVALUE(1); // BC Upgrade PATELP08 - now done in the handler
            // SalesOrderTrackingLines.OK.INVOKE; // BC Upgrade PATELP08 - now done in the handler
        END;

        //HEI.15>>
        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38
             //HEI.15<<

        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;
        SalesOrder.Release.INVOKE;
        SalesOrderNo := SalesOrder."No.".VALUE;
        DocSubtypeCode := SalesOrder."Document Subtype Code".VALUE;//BC UPGRADE KUMARR78 >> Blocking DIT Code
        WarehouseShipment.TRAP;
        // SalesOrder.Action149.INVOKE; //BC UPGRADE KUMARR78 Blocking As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder."Create &Warehouse Shipment".INVOKE; //BC UPGRADE KUMARR78 Adding As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"

        // WarehouseShipment.Action1100076703.INVOKE;//BC UPGRADE KUMARR78 DIT Action
        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke();//BC Upgrade VAMSIU01 Added

        //HEI.15>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseShipment."Shipping Agent Code".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseShipment."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        WarehouseShipmentLine.SETRANGE("No.", WarehouseShipment."No.".VALUE);
        WarehouseShipmentLine.SETRANGE("Item No.", WarehouseShipment.WhseShptLines."Item No.".VALUE);
        IF WarehouseShipmentLine.FINDFIRST THEN BEGIN
            Zone.GET(Location.Code, WarehouseShipmentLine."Zone Code");
            IF Zone."Sales Gate Entry Mandatory FND" THEN BEGIN
                Zone."Sales Gate Entry Mandatory FND" := FALSE;
                Zone.MODIFY;
            END;
        END;
        //HEI.15<<

        /*IF Item."Item Tracking Code" <> '' THEN BEGIN
          ItemTrackingQtyBase := WarehouseShipment.WhseShptLines.Quantity.ASDECIMAL * WarehouseShipment.WhseShptLines."Qty. per Unit of Measure".ASDECIMAL;
          WarehouseShipment.WhseShptLines.ItemTrackingLines.INVOKE;
        END;*/
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"
        SalesOrderNo := SalesOrder."No.".VALUE;
        SalesOrder.Post.INVOKE;
        SalesInvoiceHeader.SETRANGE("Order No.", SalesOrderNo);
        SalesInvoiceHeader.SETRANGE("Document Subtype Code FND", DocSubtypeCode);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesInvoiceHeader.FINDFIRST;
        SalesOrderNo := SalesInvoiceHeader."No.";
        CustomerLedgerEntries.OPENEDIT;
        IF CustomerLedgerEntries.FINDFIRSTFIELD(CustomerLedgerEntries."Document No.", SalesInvoiceHeader."No.") THEN BEGIN
            DisputeCases.TRAP;
            CustLedgerEntry.SETRANGE("Document No.", SalesInvoiceHeader."No.");
            CustLedgerEntry.FINDFIRST;
            CustLedgerNo := CustLedgerEntry."Entry No.";
            CustomerLedgerEntries."<Page Dispute Case>".INVOKE;
            CustomerLedgerEntries."Dispute Case".ASSERTEQUALS(FALSE);
        END;

        // BC Upgrade PATELP08 - added LIFO close of pages still open after the modal returns
        // DisputeCases.Close(); // BC Upgrade PATELP08 - commented: "TestPage is not open" - modal handler auto-closes it
        CustomerLedgerEntries.Close(); // BC Upgrade PATELP08 - added: close CLE list (OPENEDIT)
        SundrySalesOrderStock.Close(); // BC Upgrade PATELP08 - added: close Sundry view (OPENVIEW)
        // CustomerLedgerEntries.OK.INVOKE; // BC Upgrade PATELP08 - commented: OK.INVOKE can't close stale CLE in v28; replaced by Close() above
        // HEI.10<<

    end;

