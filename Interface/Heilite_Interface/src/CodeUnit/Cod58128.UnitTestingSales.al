        //SalesOrder.SalesLines."Bin Code".SETVALUE(Bin.Code);

        //BackOrder Type is not visible on Page -> Cannot be updated
        //SalesOrder.SalesLines."Backorder Type".SETVALUE(BackOrderType::"No Backorder");

