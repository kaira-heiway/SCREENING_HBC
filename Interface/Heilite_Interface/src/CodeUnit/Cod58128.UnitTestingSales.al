        StdSalesOrderIncFreeGoods.OPENEDIT;
        StdSalesOrderIncFreeGoods.NEW;
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        SalesOrder."No.".ASSISTEDIT;
        //BC Upgrade PATELP08 >>
