    [HandlerFunctions('ConfirmationHandler,MessageHandler,ApprovalEntriesModalPageHandler')]
    procedure SLS013_ApprovalCustomerFinancialAndSalesData_CustomerEqualToSoldTo();
    var
        Customer: Record Customer;
        CustomerList: TestPage "Customer List";
        CustomerCard: TestPage "Customer Card";
        PaymentTerms: Record "Payment Terms";
        PaymentMethod: Record "Payment Method";
        MissingDataErr: Label 'Missing Customer information.';
        DefaultDimensions: TestPage "Default Dimensions";
        CustomerBankAccountList: TestPage "Customer Bank Account List";
        CustomerBankAccountCard: TestPage "Customer Bank Account Card";
        UserSetup: Record "User Setup";
        UserSetup2: Record "User Setup";
        WorkflowManagement: Codeunit "Workflow Management";
        WorkflowEventHandling: Codeunit "Workflow Event Handling";
        EventFilter: Text;
        NothingToApproveMsg: Label 'Nothing to approve.';
        WorkflowEnabled: Boolean;
        Workflow: Record Workflow;
        CustAccGroupText: Text[100];
    begin
        ClearVariables('SLS013'); //HEI.31
        //HEI.09>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS013', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);

        //Check default value for Payment Terms
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS013', COMPANYNAME, DATABASE::"Payment Terms");
        PaymentTerms.GET(UnitTestingValues.Value);

        //Check default value for Payment Method
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS013', COMPANYNAME, DATABASE::"Payment Method");
        PaymentMethod.GET(UnitTestingValues.Value);

        //HEI.21>>
        //Clear Approval Admin
        UserSetup2.SETRANGE("Approval Administrator", TRUE);
        UserSetup2.SETFILTER("User ID", '<>%1', USERID);
        IF UserSetup2.FINDFIRST THEN BEGIN
            UserSetup2."Approval Administrator" := FALSE;
            UserSetup2.MODIFY;
        END;

        //Clear Substitute for all Approvers
        UserSetup2.RESET;
        CLEAR(UserSetup2);
        UserSetup2.SETFILTER(Substitute, '<>%1', '');
        IF UserSetup2.FINDSET THEN
            REPEAT
                UserSetup2.Substitute := '';
                UserSetup2.MODIFY;
            UNTIL UserSetup2.NEXT = 0;

        //Setup Current User as Approval Admin
        IF UserSetup.GET(USERID) THEN BEGIN
            //BC UPGRADE KUMARR78 >> Blocking DIT Code
            // IF NOT UserSetup."Unlimited Cr. Limit Customer" THEN
            //     UserSetup."Unlimited Cr. Limit Customer" := TRUE;
            //BC UPGRADE KUMARR78 << Blocking DIT Code
            IF NOT UserSetup."Approval Administrator" THEN
                UserSetup."Approval Administrator" := TRUE;
            UserSetup.MODIFY;
        END;

        //Check if Workflow is enabled
        EventFilter := WorkflowEventHandling.RunWorkflowOnSendCustomerForApprovalCode + '|' +
         WorkflowEventHandling.RunWorkflowOnCustomerChangedCode;
        WorkflowEnabled := WorkflowManagement.EnabledWorkflowExist(DATABASE::Customer, EventFilter);
        //HEI.21<<

        //HEI.51>>
        CustAccGroupText := STRSUBSTNO('@*%1*', Customer."Account Group FND");  //HEI.84
        Workflow.RESET;
        Workflow.SETRANGE(Category, 'SALES');
        //HEI.83>>
        //Workflow.SETFILTER(Description,'@*',Customer."Account Group FND");
        //Workflow.SETFILTER(Description,'@*%1*',Customer."Account Group FND"); //HEI.84
        //HEI.83<<
        Workflow.SETFILTER(Description, CustAccGroupText); //HEI.84
        Workflow.SETRANGE(Enabled, FALSE);
        IF Workflow.FINDFIRST THEN
            WorkflowEnabled := FALSE;
        //HEI.51<<

        //Step 1 - Open Customer Card
        CustomerList.OPENVIEW;

        CustomerCard.OPENEDIT;
        //HEI.21>>
        //CustomerCard.FINDFIRSTFIELD("No.",Customer."No.");
        CustomerCard.FILTER.SETFILTER("No.", Customer."No.");
        //HEI.21<<

        //Step 2: Add: Credit Limit, Risk assesment, Payment Terms, Payment Method
        // CustomerCard."Credit Limit".SETVALUE(TRUE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        CustomerCard."Credit Limit (LCY)".SETVALUE(100000);
        CustomerCard."Risk Score".SETVALUE(44);
        CustomerCard."Payment Terms Code".SETVALUE(PaymentTerms.Code);
        CustomerCard."Payment Method Code".SETVALUE(PaymentMethod.Code);

        //Check: Posting Groups, VAT Information, Dimensions
        IF (CustomerCard."Gen. Bus. Posting Group".VALUE = '') OR
           (CustomerCard."VAT Bus. Posting Group".VALUE = '')
        THEN
            ERROR(MissingDataErr);

        DefaultDimensions.TRAP;
        // CustomerCard."Page Default Dimensions".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        CustomerCard.Dimensions.INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF NOT (DefaultDimensions.FINDFIRSTFIELD("Table ID", 18) AND
        //    DefaultDimensions.FINDFIRSTFIELD("No.", Customer."No."))
        // THEN
        //     ERROR(MissingDataErr);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Step 3: Add Bank Accounts
        CustomerBankAccountList.TRAP;

        // CustomerCard."Page Customer Bank Account List".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        CustomerCard."Bank Accounts".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        CustomerBankAccountList.NEW;
        CustomerBankAccountCard.OPENNEW;
        CustomerBankAccountCard.NEW;

        //Enter Code
        CustomerBankAccountCard.Code.SETVALUE('SLS013');

        //Enter Name
        CustomerBankAccountCard.Name.SETVALUE('SLS013_BankAcc');

        //Enter City
        CustomerBankAccountCard.City.SETVALUE('Amsterdam');

        //Enter Post Code
        CustomerBankAccountCard."Post Code".SETVALUE('12345');

        //Enter Bank Branch No.
        CustomerBankAccountCard."Bank Branch No.".SETVALUE('SLS013_Branch');

        //Enter Bank Account No.
        CustomerBankAccountCard."Bank Account No.".SETVALUE('SLS013_BankAccNo');

        //Enter Currency Code
        CustomerBankAccountCard."Currency Code".SETVALUE('EUR');

        //Enter Country/Region Code
        CustomerBankAccountCard."Country/Region Code".SETVALUE('NL');

        //Enter IBAN
        CustomerBankAccountCard.IBAN.SETVALUE('1234123412341234');

        //Enter SWIFT Code
        CustomerBankAccountCard."SWIFT Code".SETVALUE('SLS013_Swift');
        CustomerBankAccountCard.OK.INVOKE;
        CustomerBankAccountList.OK.INVOKE;

        //Step 4 - Approve first level approval
        //Send Approval Request
        IF WorkflowEnabled THEN //HEI.21
            CustomerCard.SendApprovalRequest.INVOKE;

        //Go to Approval Entries
        CustomerCard.ApprovalEntries.INVOKE;

        //Approve Approval Entry
        IF WorkflowEnabled THEN //HEI.21
            CustomerCard.Approve.INVOKE
        //HEI.21>>
        ELSE
            MESSAGE(NothingToApproveMsg);
        //HEI.21<<
        //HEI.57>>
        //HEI.59>>
        /*IF NOT (COMPANYNAME IN ['Brasco','20_PARBO_CENTRAL'] )THEN BEGIN //HEI.58
        //HEI.57<<
        //Step 5,6: Review Customer Contract
          IF CustomerCard."Customer Posting Group".VALUE = '' THEN
            ERROR(MissingDataErr);
        
        //Step 7: Confirm Price Group
          IF CustomerCard."Customer Price Group".VALUE = '' THEN
            ERROR(MissingDataErr);
        
        //Step 8: Confirm Deposit Group
          IF CustomerCard."Deposit Cust. Posting Group".VALUE = '' THEN
            ERROR(MissingDataErr);
        END;*/
        //HEI.59<<
        //HEI.57<<
        //Step 9: Confirm Discount Group
        //IF CustomerCard."Customer Disc. Group".VALUE = '' THEN
        //ERROR(MissingDataErr);

        //Step 10: Approve second approval
        OpenApprovalEntry := FALSE;
        CustomerCard.ApprovalEntries.INVOKE;
        IF OpenApprovalEntry THEN
            CustomerCard.Approve.INVOKE;
        //HEI.09<<

    end;

    [Test]
    [HandlerFunctions('MessageHandler,ApprovalEntriesModalPageHandler')]
    procedure SLS014_ApprovalCustomerFinancialAndSalesData_CustomerDifferentFromSoldTo();
    var
        Customer: Record Customer;
        CustomerList: TestPage "Customer List";
        CustomerCard: TestPage "Customer Card";
        CustomerCard2: TestPage "Customer Card";
        RequeststoApprove: TestPage "Requests to Approve";
        MissingDataErr: Label 'Missing Customer information.';
        NothingToApproveMsg: Label 'Nothing to approve.';
    begin
        ClearVariables('SLS014'); //HEI.31
        //HEI.09>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS014', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);

        //Step 1: Login

        //Step 2: Open Requests to Approve
        //Send Approval Request from Customer Card
        CustomerList.OPENVIEW;
        CustomerCard2.OPENEDIT;
        //HEI.21>>
        //CustomerCard2.FINDFIRSTFIELD("No.",Customer."No.");
        CustomerCard2.FILTER.SETFILTER("No.", Customer."No.");
        //HEI.21<<
        //HEI.57>>
        IF NOT (COMPANYNAME = 'Brasco') THEN
            CustomerCard2.SendApprovalRequest.INVOKE;
        //HEI.57<<
        CustomerCard2.ApprovalEntries.INVOKE;
        CustomerCard2.OK.INVOKE;

        //Open Requests to Approve
        RequeststoApprove.OPENVIEW;
        IF RequeststoApprove.FINDFIRSTFIELD(Status, 1) THEN BEGIN
            //Step 3: Open Record from Requests to Approve
            CustomerCard.TRAP;
            RequeststoApprove.Record.INVOKE;

            //Step 4: Review data before Approve
            //HEI.21>>
            //This Data is available for Bill-to Customers
            //IF (CustomerCard."Customer Posting Group".VALUE = '') OR
            //(CustomerCard."Customer Price Group".VALUE = '')
            //THEN
            //ERROR(MissingDataErr);
            //HEI.21<<

            //Step 5: Check Segmentation, Bill-to Customer No.,Prices Calculation, Tax Calculation
            //HEI.21>>
            //Check should not apply to Intercompany Customers
            IF (CustomerCard."Account Group FND".VALUE = 'Y002') OR
               (CustomerCard."Account Group FND".VALUE = 'Y010')
            THEN
                //HEI.21<<
                IF (CustomerCard."Bill-to Customer No.".VALUE = '') //HEI.21
                                                                    //HEI.21>>
                                                                    //This Data is available for Bill-to Customers
                                                                    //(CustomerCard."Customer Posting Group".VALUE = '') OR
                                                                    //(CustomerCard."Customer DTax Group Code".VALUE = '')
                                                                    //HEI.21<<
            THEN
                    ERROR(MissingDataErr);

            //Step 6: Approve
            IF OpenApprovalEntry THEN
                CustomerCard.Approve.INVOKE;
        END
        //HEI.21>>
        ELSE
            MESSAGE(NothingToApproveMsg);
        //HEI.21<<
        //HEI.09<<
    end;

    [Test]
    [HandlerFunctions('MessageHandler,ApprovalEntriesModalPageHandler')]
    procedure SLS015_CreateAndReleaseContractConditions_IndividualSalesConditions();
    var
        Customer: Record Customer;
        // DrinkDepositGroup: Record "2013612";//BC UPGRADE KUMARR78 Blocking DIT variable
        CustomerDiscountGroup: Record "Customer Discount Group";
        CustomerPriceGroup: Record "Customer Price Group";
        CustomerList: TestPage "Customer List";
        CustomerCard: TestPage "Customer Card";
        MissingDataErr: Label 'Missing Customer information: %1.';
        WorkflowManagement: Codeunit "Workflow Management";
        WorkflowEventHandling: Codeunit "Workflow Event Handling";
        EventFilter: Text;
        NothingToApproveMsg: Label 'Nothing to approve.';
        WorkflowEnabled: Boolean;
        Workflow: Record Workflow;
        CustAccGroupText: Text[100];
    begin
        ClearVariables('SLS015'); //HEI.31
        //HEI.09>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS015', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);

        //Check default value for Customer Price Group
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS015', COMPANYNAME, DATABASE::"Customer Price Group");
        CustomerPriceGroup.GET(UnitTestingValues.Value);

        //Check default value for Customer Disc. Group
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS015', COMPANYNAME, DATABASE::"Customer Discount Group");
        IF CustomerDiscountGroup.GET(UnitTestingValues.Value) THEN; //HEI.21

        //Check default value for Customer Deposit Group
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // UnitTestingValues.RESET;
        // UnitTestingValues.GET('SLS015', COMPANYNAME, DATABASE::"Drink Deposit Group");
        // DrinkDepositGroup.GET(1, UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.21>>
        //Check if Workflow is enabled
        EventFilter := WorkflowEventHandling.RunWorkflowOnSendCustomerForApprovalCode + '|' +
          WorkflowEventHandling.RunWorkflowOnCustomerChangedCode;
        WorkflowEnabled := WorkflowManagement.EnabledWorkflowExist(DATABASE::Customer, EventFilter);
        //HEI.21<<

        //HEI.51>>
        CustAccGroupText := STRSUBSTNO('@*%1*', Customer."Account Group FND");  //HEI.84
        Workflow.RESET;
        Workflow.SETRANGE(Category, 'SALES');
        //HEI.83>>
        //Workflow.SETFILTER(Description,'@*',Customer."Account Group FND");
        //Workflow.SETFILTER(Description,'@*%1*',Customer."Account Group FND"); //HEI.84
        //HEI.83>>
        Workflow.SETFILTER(Description, CustAccGroupText); //HEI.84
        Workflow.SETRANGE(Enabled, FALSE);
        IF Workflow.FINDFIRST THEN
            WorkflowEnabled := FALSE;
        //HEI.51<<

        //Step 1: Login

        //Step 2,3,4: Open Sold-to Customer Card
        CustomerList.OPENVIEW;
        CustomerCard.OPENEDIT;
        //HEI.21>>
        //CustomerCard.FINDFIRSTFIELD("No.",Customer."No.");
        CustomerCard.FILTER.SETFILTER("No.", Customer."No.");
        //HEI.21<<

        //Step 5: Change Price Group (Price List)
        CustomerCard."Customer Price Group".SETVALUE(CustomerPriceGroup.Code);

        //Step 6: Change Deposit Group
        // CustomerCard."Customer DDeposit Group Code".SETVALUE(DrinkDepositGroup.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code

        //Step 7: Change Discount Group
        IF CustomerDiscountGroup.Code <> '' THEN //HEI.21
            CustomerCard."Customer Disc. Group".SETVALUE(CustomerDiscountGroup.Code);

        //Step 8: Approve
        //Send Approval Request
        IF WorkflowEnabled THEN //HEI.21
            CustomerCard.SendApprovalRequest.INVOKE;

        //Go to Approval Entries
        CustomerCard.ApprovalEntries.INVOKE;

        //Approve Approval Entry
        IF WorkflowEnabled THEN //HEI.21
            CustomerCard.Approve.INVOKE
        //HEI.21>>
        ELSE
            MESSAGE(NothingToApproveMsg);
        //HEI.21<<

        //Step 9: Second level of approval
        //Customer is released just if:
        //Approved pricing is used
        IF CustomerCard."Customer Price Group".VALUE = '' THEN
            ERROR(MissingDataErr, CustomerCard."Customer Price Group".CAPTION);

        //There is a signed contract by the customer
        //The contract is based on prior quotation
        //Credit Check is performed for the customer"

        // IF CustomerCard."Credit Limit".ASBOOLEAN THEN //HEI.36//BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF CustomerCard."Credit Limit (LCY)".ASDECIMAL = 0 THEN
            ERROR(MissingDataErr, CustomerCard."Credit Limit (LCY)".CAPTION);

        //Approve second approval
        OpenApprovalEntry := FALSE;
        CustomerCard.ApprovalEntries.INVOKE;
        IF OpenApprovalEntry THEN
            CustomerCard.Approve.INVOKE;

        //Step 10: Release Customer for ordering: Ship
        //HEI.21>>
        //Check should not apply to Intercompany Customers
        IF (CustomerCard."Account Group FND".VALUE = 'Y002') OR
           (CustomerCard."Account Group FND".VALUE = 'Y010')
        THEN
            //HEI.21<<
            CustomerCard.Blocked.ASSERTEQUALS(1);
        //HEI.09<<
    end;

