    [HandlerFunctions('NoSeriesListModalPageHandler,ConfirmationHandler,MessageHandler,ShipInvoiceStrMenuHandler,ErrorMessagesPageHandler')]

    // [HandlerFunctions('NoSeriesListModalPageHandler,ItemTrackingLinesModalPageHandler,ConfirmationHandler,MessageHandler,ShipInvoiceStrMenuHandler')]
    procedure OTC159_CreateCashJournal_AddOrAdjustOrRemoveCashPaymentLines();
    var
        Customer: Record Customer;
        BillToCustomer: Record Customer;
        Item: Record Item;
        Location: Record Location;
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable
        Route: Record Route107FDW; // BC Upgrade PATELP08
        GenJournalTemplate: Record "Gen. Journal Template";
        GenJournalBatch: Record "Gen. Journal Batch";
        PaymentMethod: Record "Payment Method";
        GeneralJournalTemplates: TestPage "General Journal Templates";
        GeneralJournalBatches: TestPage "General Journal Batches";
        CashReceiptJournal: TestPage "Cash Receipt Journal";
        WarehouseShipment: TestPage "Warehouse Shipment";
        SalesOrder: TestPage "Sales Order";
        SalesInvoiceHeader: Record "Sales Invoice Header";
        GenJournalLine: Record "Gen. Journal Line";
        // DocumentSubtypeCode: Record "2014472";//BC UPGRADE KUMARR78 Blocking DIT variable
        DocumentSubtypeCode: Record "Document Subtype Code FND"; // BC Upgrade PATELP08
        DocumentNo: Code[20];
        SalesOrderNoL: Code[20];
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        Workflow: Record Workflow;
        SalesHeader: Record "Sales Header";
        GLAccount: Record "G/L Account";
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        Truck: Record Vehicle101FDW;// BC Upgrade PATELP08
        Driver: Record Driver107FDW;// BC Upgrade PATELP08
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        SalesReceivablesSetup: Record "Sales & Receivables Setup";
        Zone: Record Zone;
        Bin: Record Bin;
        ItemTrackingCode: Record "Item Tracking Code";
    begin
        ClearVariables('OTC159'); //HEI.31
        //HEI.04>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF NOT BillToCustomer.GET(Customer."Bill-to Customer No.") THEN
            BillToCustomer.GET(Customer."No.");
        IF BillToCustomer."Application Method" = BillToCustomer."Application Method"::"Apply to Oldest" THEN
            BillToCustomer."Application Method" := BillToCustomer."Application Method"::Manual;
        BillToCustomer.MODIFY;

        IF Customer."Shipping Advice" = Customer."Shipping Advice"::Partial THEN
            Customer."Shipping Advice" := Customer."Shipping Advice"::Complete;
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        Customer.MODIFY;

        //Check the default value for Truck

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Driver
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::Driver107FDW);
        IF Driver.GET(UnitTestingValues.Value) THEN;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::"Shipping Agent Services");
        IF ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value) THEN;
        //HEI.19<<

        //Check default value for Journal Template
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::"Gen. Journal Template");
        GenJournalTemplate.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF GenJournalTemplate."SO Cash Application FND" THEN BEGIN
            GenJournalTemplate."SO Cash Application FND" := FALSE;
            GenJournalTemplate.MODIFY;
        END;

        //Check default value for GL Account
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::"G/L Account");
        GLAccount.GET(UnitTestingValues.Value);
        //HEI.19<<

        //Check default value for Journal Batch
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::"Gen. Journal Batch");
        GenJournalBatch.GET(GenJournalTemplate.Name, UnitTestingValues.Value);

        //Check default value for Payment Method
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::"Payment Method");
        PaymentMethod.GET(UnitTestingValues.Value);

        //HEI.31>>
        //Update Payment Method Code on Customer
        BillToCustomer."Payment Method Code" := PaymentMethod.Code;
        // BillToCustomer."Free Item" := FALSE; //HEI.62>>//BC UPGRADE KUMARR78 >> Blocking DIT Code
        BillToCustomer.MODIFY;
        //HEI.31<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check default value for Route
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        IF Location."Sales Gate Entry Mandatory FND" THEN BEGIN
            Location."Sales Gate Entry Mandatory FND" := FALSE;
            Location.MODIFY;
        END;

        //HEI.36>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        Route."shipping location" := Location.Code;
        Route."receipt location" := Location.Code;
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.36<<

        //Check default value for Document Subtype Code
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::"Document Subtype Code FND");
        DocumentSubtypeCode.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.19>>
        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::Zone);
        Zone.GET(Location.Code, UnitTestingValues.Value);
        IF Zone."Sales Gate Entry Mandatory FND" THEN
            Zone."Sales Gate Entry Mandatory FND" := FALSE;
        Zone.MODIFY;

        //Check default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC159', COMPANYNAME, DATABASE::Bin);
        Bin.GET(Location.Code, UnitTestingValues.Value);

        IF Location."Shipment Bin Code" <> Bin.Code THEN
            Location."Shipment Bin Code" := Bin.Code;
        Location.MODIFY;

        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Strict Expiration Posting" THEN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Activate CIS System FND" THEN
            SalesReceivablesSetup."Activate CIS System FND" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.19<<

        //Disable Gen. Journal Batch Approval Workflow
        //HEI.79>>
        DisableGenJournalBatchApprovalWorkflow(GenJournalBatch);
        //HEI.79<<

        //Step 1: Login

        //Create and post Sales Invoice
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >> Unblocking DIT Code
        SalesOrder."Document Subtype Code".SETVALUE(DocumentSubtypeCode.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        // BC Upgrade PATELP08 <<
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 >>
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);
        SalesOrder."Location Code".SETVALUE(Location.Code); //HEI.19
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);// BC Upgrade PATELP08
        SalesOrder."External Document No.".SETVALUE('Unit Test OTC159');

        //HEI.19>>
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38
        //HEI.19<<

        //Create Sales Line
        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        // SalesOrder.SalesLines."Location Code".SETVALUE(Location.Code); //HEI.19
        SalesOrder.SalesLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure");//BC Upgrade VAMSIU01 added.
        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;

        //Release
        SalesOrder.Release.INVOKE;
        SalesOrderNoL := SalesOrder."No.".VALUE;//HEI.45

        //Create & Post Whse. Shipment
        WarehouseShipment.TRAP;
        // SalesOrder.Action149.INVOKE; //BC UPGRADE KUMARR78 Blocking As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder."Create &Warehouse Shipment".INVOKE; //BC UPGRADE KUMARR78 Adding As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"

        //Auto-FEFO
        // WarehouseShipment.Action1100076703.INVOKE;//BC UPGRADE KUMARR78 DIT Action
        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke();//BC Upgrade VAMSIU01 Added
        //HEI.19>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseShipment."Shipping Agent Code".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseShipment."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.19<<
        //Post
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"

        //Post Sales Order
        SalesOrder.Post.INVOKE;

        //Check Sales Invoice
        SalesInvoiceHeader.SETRANGE("Order No.", SalesOrderNoL);//HEI.45
        SalesInvoiceHeader.FINDFIRST;
        SalesInvoiceHeader.CALCFIELDS("Amount Including VAT");//HEI.45
        //Step 2,3,4: Access Cash Receipt Journal
        GeneralJournalTemplates.OPENVIEW;

        //Choose Template
        GeneralJournalBatches.TRAP;
        //HEI.19>>
        //GeneralJournalTemplates.FINDFIRSTFIELD(Name,GenJournalTemplate.Name);
        GeneralJournalTemplates.FILTER.SETFILTER(Name, GenJournalTemplate.Name);
        //HEI.19<<

        // GeneralJournalTemplates."Page General Journal Batches".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GeneralJournalTemplates."Batches".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //Step 5: Choose Batch
        CashReceiptJournal.TRAP;
        //HEI.19>>
        //GeneralJournalBatches.FINDFIRSTFIELD(Name,GenJournalBatch.Name);
        GeneralJournalBatches.FILTER.SETFILTER(Name, GenJournalBatch.Name);
        //HEI.19<<
        GeneralJournalBatches.EditJournal.INVOKE;

        //Remove existing lines in Journal to avoid errors
        GenJournalLine.SETRANGE("Journal Template Name", GenJournalTemplate.Name);
        GenJournalLine.SETRANGE("Journal Batch Name", GenJournalBatch.Name);
        IF GenJournalLine.FINDSET THEN //HEI.19
            GenJournalLine.DELETEALL;

        //Step 6: Create Journal Line
        CashReceiptJournal.NEW;

        //Posting Date
        CashReceiptJournal."Posting Date".SETVALUE(WORKDATE);

        //Document Type = Payment
        CashReceiptJournal."Document Type".SETVALUE(1);

        //Payment Type = collection
        //CashReceiptJournal."Payment Type".SETVALUE(1);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        //HEI.19>>
        IF CashReceiptJournal."Document No.".VALUE = '' THEN
            CashReceiptJournal."Document No.".SETVALUE('OTC159');
        IF GenJournalBatch."Bal. Account No." = '' THEN BEGIN
            CashReceiptJournal."Bal. Account Type".SETVALUE(0);
            CashReceiptJournal."Bal. Account No.".SETVALUE(GLAccount."No.");
        END;
        CashReceiptJournal."External Document No.".SETVALUE('OTC159');
        //HEI.19<<

        //Account Type = Customer
        CashReceiptJournal."Account Type".SETVALUE(1);

        //Account No
        //HEI.19>>
        //CashReceiptJournal."Account No.".SETVALUE(Customer."No.");
        CashReceiptJournal."Account No.".SETVALUE(BillToCustomer."No.");
        //HEI.19<<

        //Description
        CashReceiptJournal.Description.SETVALUE('OTC159_Payment');

        //Amount
        CashReceiptJournal.Amount.SETVALUE(-SalesInvoiceHeader."Amount Including VAT");

        //Payment Method = Cash Order
        //CashReceiptJournal."Payment Method Code".SETVALUE(PaymentMethod.Code); //HEI.31

        //Applies-to Document Type = Invoice
        CashReceiptJournal."Applies-to Doc. Type".SETVALUE(2);

        //Applies-to Document No.
        CashReceiptJournal."Applies-to Doc. No.".SETVALUE(SalesInvoiceHeader."No.");

        //Checks on Doc. No. and Bal. Account
        //Document No = (auto)
        //HEI.19>>
        //DocumentNo := CashReceiptJournal."Document No.".VALUE;
        //IF DocumentNo = '' THEN
        //ERROR('Document No. not setup.');
        //HEI.19<<

        IF GenJournalBatch."Bal. Account No." <> '' THEN BEGIN //HEI.19
                                                               //Bal Account Type (auto - template)
            CashReceiptJournal."Bal. Account Type".ASSERTEQUALS(GenJournalBatch."Bal. Account Type");
            //Bal Account No (auto - template)
            CashReceiptJournal."Bal. Account No.".ASSERTEQUALS(GenJournalBatch."Bal. Account No.");
        END; //HEI.19

        //Step 7: Post
        CashReceiptJournal.Post.INVOKE;
    end;


    [Test]
    [HandlerFunctions('ConfirmationHandler,MessageHandler')]
    procedure OTC161_CheckPostingFlowForCashJournalPostingProcess();
    var
        Customer: Record Customer;
        CustomerPostingGroup: Record "Customer Posting Group";
        GenJournalTemplate: Record "Gen. Journal Template";
        GenJournalBatch: Record "Gen. Journal Batch";
        PaymentMethod: Record "Payment Method";
        GeneralJournalTemplates: TestPage "General Journal Templates";
        GeneralJournalBatches: TestPage "General Journal Batches";
        CashReceiptJournal: TestPage "Cash Receipt Journal";
        CustomerLedgerEntries: TestPage "Customer Ledger Entries";
        GeneralLedgerEntries: TestPage "General Ledger Entries";
        DetailedCustLedgEntries: TestPage "Detailed Cust. Ledg. Entries";
        GenJournalLine: Record "Gen. Journal Line";
        Navigate: TestPage Navigate;
        DocumentNo: Code[20];
        TotalAmount: Decimal;
        GLAccount: Record "G/L Account";
    begin
        ClearVariables('OTC161'); //HEI.31
        //HEI.04>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC161', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF Customer."Application Method" = Customer."Application Method"::"Apply to Oldest" THEN
            Customer."Application Method" := Customer."Application Method"::Manual;
        IF Customer."Currency Code" <> '' THEN
            Customer."Currency Code" := '';
        Customer.MODIFY;
        //HEI.19<<
        CustomerPostingGroup.GET(Customer."Customer Posting Group");

        //Check default value for Journal Template
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC161', COMPANYNAME, DATABASE::"Gen. Journal Template");
        GenJournalTemplate.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF GenJournalTemplate."SO Cash Application FND" THEN BEGIN
            GenJournalTemplate."SO Cash Application FND" := FALSE;
            GenJournalTemplate.MODIFY;
        END;

        //Check default value for GL Account
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC161', COMPANYNAME, DATABASE::"G/L Account");
        GLAccount.GET(UnitTestingValues.Value);
        //HEI.19<<

        //Check default value for Journal Batch
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC161', COMPANYNAME, DATABASE::"Gen. Journal Batch");
        GenJournalBatch.GET(GenJournalTemplate.Name, UnitTestingValues.Value);
        //HEI.41>>
        IF GenJournalBatch."Bal. Account No." <> '' THEN BEGIN
            GenJournalBatch."Bal. Account No." := '';
            GenJournalBatch.MODIFY;
        END;
        //HEI.41<<

        //Check default value for Payment Method
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC161', COMPANYNAME, DATABASE::"Payment Method");
        PaymentMethod.GET(UnitTestingValues.Value);

        //HEI.31>>
        //Update Payment Method Code on Customer
        Customer."Payment Method Code" := PaymentMethod.Code;
        Customer.MODIFY;
        //HEI.31<<

        //Disable Gen. Journal Batch Approval Workflow
        //HEI.79>>
        DisableGenJournalBatchApprovalWorkflow(GenJournalBatch);
        //HEI.79<<

        //Step 1: Login

        //Create and Post Cash Receipt Journal
        //Access Cash Receipt Journal
        GeneralJournalTemplates.OPENVIEW;
        GeneralJournalBatches.TRAP;
        //HEI.19>>
        //GeneralJournalTemplates.FINDFIRSTFIELD(Name,GenJournalTemplate.Name);
        GeneralJournalTemplates.FILTER.SETFILTER(Name, GenJournalTemplate.Name);
        //HEI.19<<

        // GeneralJournalTemplates."Page General Journal Batches".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GeneralJournalTemplates."Batches".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        CashReceiptJournal.TRAP;
        //HEI.19>>
        //GeneralJournalBatches.FINDFIRSTFIELD(Name,GenJournalBatch.Name);
        GeneralJournalBatches.FILTER.SETFILTER(Name, GenJournalBatch.Name);
        //HEI.19<<
        GeneralJournalBatches.EditJournal.INVOKE;

        //Remove existing lines in Journal to avoid errors
        GenJournalLine.SETRANGE("Journal Template Name", GenJournalTemplate.Name);
        GenJournalLine.SETRANGE("Journal Batch Name", GenJournalBatch.Name);
        IF GenJournalLine.FINDSET THEN //HEI.19
            GenJournalLine.DELETEALL;

        //Create Journal Line
        CashReceiptJournal.NEW;
        CashReceiptJournal."Document Type".SETVALUE(1);
        //HEI.19>>
        IF CashReceiptJournal."Document No.".VALUE = '' THEN
            CashReceiptJournal."Document No.".SETVALUE('OTC161');
        IF GenJournalBatch."Bal. Account No." = '' THEN BEGIN
            CashReceiptJournal."Bal. Account Type".SETVALUE(0);
            CashReceiptJournal."Bal. Account No.".SETVALUE(GLAccount."No.");
        END;
        CashReceiptJournal."External Document No.".SETVALUE('OTC161');
        //HEI.19<<
        CashReceiptJournal."Account Type".SETVALUE(1);
        CashReceiptJournal."Account No.".SETVALUE(Customer."No.");
        CashReceiptJournal.Amount.SETVALUE(-100);
        //CashReceiptJournal."Payment Method Code".SETVALUE(PaymentMethod.Code); //HEI.31

        DocumentNo := CashReceiptJournal."Document No.".VALUE;

        //Post
        CashReceiptJournal.Post.INVOKE;

        //Step 2,3,4: Access Customer Ledger Entries
        CustomerLedgerEntries.OPENVIEW;

        //Step 5: Acess respective cash receipt that was posted already
        //HEI.19>>
        //CustomerLedgerEntries.FINDFIRSTFIELD("Customer No.",Customer."No.");
        //CustomerLedgerEntries.FINDFIRSTFIELD("Document Type",1);
        //CustomerLedgerEntries.FINDFIRSTFIELD("Document No.",DocumentNo);
        CustomerLedgerEntries.FILTER.SETFILTER("Customer No.", Customer."No.");
        CustomerLedgerEntries.FILTER.SETFILTER("Document Type", '1');
        CustomerLedgerEntries.FILTER.SETFILTER("Document No.", DocumentNo);
        //HEI.19<<

        //Check Payment Method
        CustomerLedgerEntries."Payment Method Code".ASSERTEQUALS(PaymentMethod.Code);

        //Step 6: Navigate
        Navigate.TRAP;
        // CustomerLedgerEntries.Action37.INVOKE; //BC UPGRADE KUMARR78 Blocking As Action Name Changed
        CustomerLedgerEntries."&Navigate".INVOKE; //BC UPGRADE KUMARR78 Adding with Change Action Name

        Navigate.FILTER.SETFILTER("Table Name", 'G/L Entry');
        GeneralLedgerEntries.TRAP;
        Navigate."No. of Records".DRILLDOWN;

        //Step 7: Check G/L Entries, Customer subledger
        //G/L Entry for Customer Receivable Account
        TotalAmount := 0;
        GeneralLedgerEntries.FILTER.SETFILTER("G/L Account No.", CustomerPostingGroup."Receivables Account");
        EVALUATE(TotalAmount, CustomerLedgerEntries.Amount.VALUE);
        GeneralLedgerEntries.Amount.ASSERTEQUALS(TotalAmount);

        //G/L Entry for Bal. Account
        TotalAmount := 0;
        //HEI.19>>
        IF GenJournalBatch."Bal. Account No." = '' THEN
            GeneralLedgerEntries.FILTER.SETFILTER("G/L Account No.", GLAccount."No.")
        ELSE
            //HEI.19<<
            GeneralLedgerEntries.FILTER.SETFILTER("G/L Account No.", GenJournalBatch."Bal. Account No.");
        EVALUATE(TotalAmount, CustomerLedgerEntries.Amount.VALUE);
        GeneralLedgerEntries.Amount.ASSERTEQUALS(-TotalAmount);

        GeneralLedgerEntries.OK.INVOKE;

        //Check Detailed Customer Ledger Entry
        Navigate.FILTER.SETFILTER("Table Name", 'Detailed Cust. Ledg. Entry');
        DetailedCustLedgEntries.TRAP;
        Navigate."No. of Records".DRILLDOWN;

        DetailedCustLedgEntries."Customer No.".ASSERTEQUALS(CustomerLedgerEntries."Customer No.".VALUE);
        DetailedCustLedgEntries.Amount.ASSERTEQUALS(CustomerLedgerEntries.Amount.VALUE);

        DetailedCustLedgEntries.OK.INVOKE;
        Navigate.OK.INVOKE;
        //HEI.04<<
    end;

    [Test]
    [HandlerFunctions('NoSeriesListModalPageHandler,ConfirmationHandler,MessageHandler,ShipInvoiceStrMenuHandler')]
    procedure OTC176_CheckPostingFlowForTheRefundProposalPosting();
    var
        Customer: Record Customer;
        BillToCustomer: Record Customer;
        CustomerPostingGroup: Record "Customer Posting Group";
        Item: Record Item;
        Location: Record Location;
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable 
        Route: Record Route107FDW;
        GenJournalTemplate: Record "Gen. Journal Template";
        GenJournalBatch: Record "Gen. Journal Batch";
        PaymentMethod: Record "Payment Method";
        GeneralJournalTemplates: TestPage "General Journal Templates";
        GeneralJournalBatches: TestPage "General Journal Batches";
        CashReceiptJournal: TestPage "Cash Receipt Journal";
        WarehouseShipment: TestPage "Warehouse Shipment";
        CustomerLedgerEntries: TestPage "Customer Ledger Entries";
        GeneralLedgerEntries: TestPage "General Ledger Entries";
        DetailedCustLedgEntries: TestPage "Detailed Cust. Ledg. Entries";
        SalesOrder: TestPage "Sales Order";
        Navigate: TestPage Navigate;
        SalesInvoiceHeader: Record "Sales Invoice Header";
        GenJournalLine: Record "Gen. Journal Line";
        // DocumentSubtypeCode: Record "2014472";//BC UPGRADE KUMARR78 Blocking DIT variable
        DocumentSubtypeCode: Record "Document Subtype Code FND";
        DocumentNo: Code[20];
        SalesOrderNo: Code[20];
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        TotalAmount: Decimal;
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        Workflow: Record Workflow;
        SalesHeader: Record "Sales Header";
        GLAccount: Record "G/L Account";
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        Truck: Record Vehicle101FDW;
        Driver: Record Driver107FDW;
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        SalesReceivablesSetup: Record "Sales & Receivables Setup";
        Zone: Record Zone;
        Bin: Record Bin;
        ItemTrackingCode: Record "Item Tracking Code";
    begin
        ClearVariables('OTC176'); //HEI.31
        //HEI.04>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF Customer."Shipping Advice" = Customer."Shipping Advice"::Partial THEN
            Customer."Shipping Advice" := Customer."Shipping Advice"::Complete;
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF Customer."Currency Code" <> '' THEN
            Customer."Currency Code" := '';
        Customer.MODIFY;

        IF NOT BillToCustomer.GET(Customer."Bill-to Customer No.") THEN
            BillToCustomer.GET(Customer."No.");
        IF BillToCustomer."Application Method" = BillToCustomer."Application Method"::"Apply to Oldest" THEN
            BillToCustomer."Application Method" := BillToCustomer."Application Method"::Manual;
        IF BillToCustomer."Currency Code" <> '' THEN
            BillToCustomer."Currency Code" := '';
        BillToCustomer.MODIFY;

        CustomerPostingGroup.GET(BillToCustomer."Customer Posting Group");

        //Check the default value for Truck
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::Vehicle101FDW);
        IF Truck.GET(UnitTestingValues.Value) THEN;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Driver
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::Driver107FDW);
        IF Driver.GET(UnitTestingValues.Value) THEN;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::"Shipping Agent Services");
        IF ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value) THEN;
        //HEI.19<<

        //Check default value for Journal Template
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::"Gen. Journal Template");
        GenJournalTemplate.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF GenJournalTemplate."SO Cash Application FND" THEN BEGIN
            GenJournalTemplate."SO Cash Application FND" := FALSE;
            GenJournalTemplate.MODIFY;
        END;

        //Check default value for GL Account
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::"G/L Account");
        GLAccount.GET(UnitTestingValues.Value);
        //HEI.19<<

        //Check default value for Journal Batch
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::"Gen. Journal Batch");
        GenJournalBatch.GET(GenJournalTemplate.Name, UnitTestingValues.Value);
        //HEI.41>>
        IF GenJournalBatch."Bal. Account No." <> '' THEN BEGIN
            GenJournalBatch."Bal. Account No." := '';
            GenJournalBatch.MODIFY;
        END;
        //HEI.41<<

        //Check default value for Payment Method
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::"Payment Method");
        PaymentMethod.GET(UnitTestingValues.Value);

        //HEI.31>>
        //Update Payment Method Code on Customer
        BillToCustomer."Payment Method Code" := PaymentMethod.Code;
        BillToCustomer.MODIFY;
        //HEI.31<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);
        //HEI.50>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Item."Sales Price Warning" <> Item."Sales Price Warning"::"No Warning" THEN
        //     Item."Sales Price Warning" := Item."Sales Price Warning"::"No Warning";
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        IF Item."Unit Price" = 0 THEN
            Item."Unit Price" := 100;
        Item.MODIFY;
        //HEI.50<<

        //Check default value for Route
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        IF Location."Sales Gate Entry Mandatory FND" THEN BEGIN
            Location."Sales Gate Entry Mandatory FND" := FALSE;
            Location.MODIFY;
        END;

        //HEI.36>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        Route."shipping location" := Location.Code;
        Route."receipt location" := Location.Code;
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.36<<

        //Check default value for Document Subtype Code
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::"Document Subtype Code FND");
        DocumentSubtypeCode.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.19>>
        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::Zone);
        Zone.GET(Location.Code, UnitTestingValues.Value);
        IF Zone."Sales Gate Entry Mandatory FND" THEN
            Zone."Sales Gate Entry Mandatory FND" := FALSE;
        Zone.MODIFY;

        //Check default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC176', COMPANYNAME, DATABASE::Bin);
        Bin.GET(Location.Code, UnitTestingValues.Value);

        IF Location."Shipment Bin Code" <> Bin.Code THEN
            Location."Shipment Bin Code" := Bin.Code;
        Location.MODIFY;

        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Strict Expiration Posting" THEN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Activate CIS System FND" THEN
            SalesReceivablesSetup."Activate CIS System FND" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.19<<

        //Disable Gen. Journal Batch Approval Workflow
        //HEI.79>>
        DisableGenJournalBatchApprovalWorkflow(GenJournalBatch);
        //HEI.79<<

        //Step 1: Login

        //Create and post Sales Invoice
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >> Unblocking DIT Code
        SalesOrder."Document Subtype Code".SETVALUE(DocumentSubtypeCode.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 >>
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);
        SalesOrder."Location Code".SETVALUE(Location.Code); //HEI.19
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);
        SalesOrder."External Document No.".SETVALUE('Unit Test OTC176');

        //HEI.19>>
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38
             //HEI.19<<

        //Create Sales Line
        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        SalesOrder.SalesLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure");//BC Upgrade VAMSIU01 added
        //SalesOrder.SalesLines."Location Code".SETVALUE(Location.Code); //HEI.19

        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;

        //Release
        SalesOrder.Release.INVOKE;
        SalesOrderNo := SalesOrder."No.".VALUE;

        //Create & Post Whse. Shipment
        WarehouseShipment.TRAP;
        // SalesOrder.Action149.INVOKE; //BC UPGRADE KUMARR78 Blocking As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder."Create &Warehouse Shipment".INVOKE; //BC UPGRADE KUMARR78 Adding As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"

        //Auto-FEFO
        // WarehouseShipment.Action1100076703.INVOKE;//BC UPGRADE KUMARR78 DIT Action
        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke();//BC Upgrade VAMSIU01 Added
        //HEI.19>>
        // BC Upgrade PATELP08 >> Unblocking DIT Code
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseShipment."Shipping Agent Code".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseShipment."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        // BC Upgrade PATELP08 <<
        //HEI.19<<

        //Post
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"

        //Post Sales Order
        SalesOrder.Post.INVOKE;

        //Check posted Sundry Sales Invoice
        SalesInvoiceHeader.SETRANGE("Order No.", SalesOrderNo);
        SalesInvoiceHeader.FINDFIRST;

        //Step 2,3,4: Access Refund Journal
        GeneralJournalTemplates.OPENVIEW;
        GeneralJournalBatches.TRAP;
        //HEI.19>>
        //GeneralJournalTemplates.FINDFIRSTFIELD(Name,GenJournalTemplate.Name);
        GeneralJournalTemplates.FILTER.SETFILTER(Name, GenJournalTemplate.Name);
        //HEI.19<<

        // GeneralJournalTemplates."Page General Journal Batches".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GeneralJournalTemplates."Batches".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name


        //Step 5: Choose OTC Batch
        CashReceiptJournal.TRAP;
        //HEI.19>>
        //GeneralJournalBatches.FINDFIRSTFIELD(Name,GenJournalBatch.Name);
        GeneralJournalBatches.FILTER.SETFILTER(Name, GenJournalBatch.Name);
        //HEI.19<<
        GeneralJournalBatches.EditJournal.INVOKE;

        //Remove existing lines in Journal to avoid errors
        GenJournalLine.SETRANGE("Journal Template Name", GenJournalTemplate.Name);
        GenJournalLine.SETRANGE("Journal Batch Name", GenJournalBatch.Name);
        IF GenJournalLine.FINDSET THEN //HEI.19
            GenJournalLine.DELETEALL;

        //Step 6: Add new line
        CashReceiptJournal.NEW;

        //Posting Date
        CashReceiptJournal."Posting Date".SETVALUE(WORKDATE);

        //Document Type (payment)
        CashReceiptJournal."Document Type".SETVALUE(1);

        //HEI.19>>
        IF CashReceiptJournal."Document No.".VALUE = '' THEN
            CashReceiptJournal."Document No.".SETVALUE('OTC176');
        IF GenJournalBatch."Bal. Account No." = '' THEN BEGIN
            CashReceiptJournal."Bal. Account Type".SETVALUE(0);
            CashReceiptJournal."Bal. Account No.".SETVALUE(GLAccount."No.");
        END;
        CashReceiptJournal."External Document No.".SETVALUE('OTC176');
        //HEI.19<<

        // Payment type (collection)
        // CashReceiptJournal."Payment Type".SETVALUE(1);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        //Account No
        CashReceiptJournal."Account Type".SETVALUE(1);
        //HEI.19>>
        //CashReceiptJournal."Account No.".SETVALUE(Customer."No.");
        CashReceiptJournal."Account No.".SETVALUE(BillToCustomer."No.");
        //HEI.19<<

        //Description
        CashReceiptJournal.Description.SETVALUE('OTC176');

        //Amount
        CashReceiptJournal.Amount.SETVALUE(-100);
        //CashReceiptJournal."Payment Method Code".SETVALUE(PaymentMethod.Code); //HEI.31

        //Applies-to Document Type = Invoice
        CashReceiptJournal."Applies-to Doc. Type".SETVALUE(2);

        //Applies-to Document No.
        CashReceiptJournal."Applies-to Doc. No.".SETVALUE(SalesInvoiceHeader."No.");

        //Check Document No.
        //HEI.19>>
        //DocumentNo := CashReceiptJournal."Document No.".VALUE;
        //IF DocumentNo = '' THEN
        //ERROR('Document No. not setup.');

        IF GenJournalBatch."Bal. Account No." <> '' THEN BEGIN
            //HEI.19<<
            //Bal Account Type (auto - template)
            CashReceiptJournal."Bal. Account Type".ASSERTEQUALS(GenJournalBatch."Bal. Account Type");
            //Bal Account No (auto - template)
            CashReceiptJournal."Bal. Account No.".ASSERTEQUALS(GenJournalBatch."Bal. Account No.");
        END; //HEI.19

        DocumentNo := CashReceiptJournal."Document No.".VALUE;

        //Step 7: Post
        CashReceiptJournal.Post.INVOKE;

        CustomerLedgerEntries.OPENVIEW;

        //Step 5: Acess respective cash receipt that was posted already
        //HEI.19>>
        //CustomerLedgerEntries.FINDFIRSTFIELD("Customer No.",Customer."No.");
        //CustomerLedgerEntries.FINDFIRSTFIELD("Document Type",1);
        //CustomerLedgerEntries.FINDFIRSTFIELD("Document No.",DocumentNo);
        CustomerLedgerEntries.FILTER.SETFILTER("Customer No.", BillToCustomer."No.");
        CustomerLedgerEntries.FILTER.SETFILTER("Document Type", '1');
        CustomerLedgerEntries.FILTER.SETFILTER("Document No.", DocumentNo);
        //HEI.19<<

        //Check Payment Method
        CustomerLedgerEntries."Payment Method Code".ASSERTEQUALS(PaymentMethod.Code);

        //Step 6: Navigate
        Navigate.TRAP;
        // CustomerLedgerEntries.Action37.INVOKE; //BC UPGRADE KUMARR78 Blocking As Action Name Changed
        CustomerLedgerEntries."&Navigate".INVOKE; //BC UPGRADE KUMARR78 Adding with Change Action Name

        Navigate.FILTER.SETFILTER("Table Name", 'G/L Entry');
        GeneralLedgerEntries.TRAP;
        Navigate."No. of Records".DRILLDOWN;

        //Step 7: Check G/L Entries, Customer subledger
        //G/L Entry for Customer Receivable Account
        TotalAmount := 0;
        GeneralLedgerEntries.FILTER.SETFILTER("G/L Account No.", CustomerPostingGroup."Receivables Account");
        EVALUATE(TotalAmount, CustomerLedgerEntries.Amount.VALUE);
        GeneralLedgerEntries.Amount.ASSERTEQUALS(TotalAmount);

        //G/L Entry for Bal. Account
        TotalAmount := 0;
        //HEI.19>>
        IF GenJournalBatch."Bal. Account No." = '' THEN
            GeneralLedgerEntries.FILTER.SETFILTER("G/L Account No.", GLAccount."No.")
        ELSE
            //HEI.19<<
            GeneralLedgerEntries.FILTER.SETFILTER("G/L Account No.", GenJournalBatch."Bal. Account No.");
        EVALUATE(TotalAmount, CustomerLedgerEntries.Amount.VALUE);
        GeneralLedgerEntries.Amount.ASSERTEQUALS(-TotalAmount);

        GeneralLedgerEntries.OK.INVOKE;

        //Check Detailed Customer Ledger Entry
        Navigate.FILTER.SETFILTER("Table Name", 'Detailed Cust. Ledg. Entry');
        DetailedCustLedgEntries.TRAP;
        Navigate."No. of Records".DRILLDOWN;

        DetailedCustLedgEntries."Customer No.".ASSERTEQUALS(CustomerLedgerEntries."Customer No.".VALUE);
        DetailedCustLedgEntries.Amount.ASSERTEQUALS(CustomerLedgerEntries.Amount.VALUE);
        DetailedCustLedgEntries.OK.INVOKE;

        Navigate.OK.INVOKE;
        //HEI.04<<
    end;

