    [HandlerFunctions('NoSeriesListModalPageHandler,MessageHandler,ConfirmationHandler,GateEntryOutbound_ModalPageHandler_LOG077,ShipInvoiceStrMenuHandler')]
    procedure LOG077_OutboundProcessSalesOrder();
    var
        Location: Record Location;
        Customer: Record Customer;
        Item: Record Item;
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable
        Route: Record Route107FDW;
        Bin: Record Bin;
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        Driver: Record Driver107FDW;
        Truck: Record Vehicle101FDW;
        SalesOrderList: TestPage "Sales Order List";
        SalesOrder: TestPage "Sales Order";
        WarehouseShipment: TestPage "Warehouse Shipment";
        GateEntryOutbound: TestPage "Gate Entry Outbound";
        Workflow: Record Workflow;
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        NoSeries: Record "No. Series";
        WarehouseSetup: Record "Warehouse Setup";
        // WarehouseEmployee: Record "Warehouse Employee";//BC UPGRADE KUMARR78 03-06-2026--
        WarehouseEmployee: Record "Warehouse Employee_DTW FND";//BC UPGRADE KUMARR78 03-06-2026++

        ItemTrackingCode: Record "Item Tracking Code";
        Zone: Record Zone;
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        SalesReceivablesSetup: Record "Sales & Receivables Setup";
        SalesHeader: Record "Sales Header";
        GateEntryHeader: Record "Gate Entry Header FND";
    begin
        ClearVariables('LOG077'); //HEI.31
        //HEI.08<<
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG077', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        Customer.MODIFY;
        //HEI.20<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG077', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG077', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF Route."Multiple Order Route" THEN
            Route."Multiple Order Route" := FALSE;
        //HEI.36>>
        // IF Route."Location Code" <> '' THEN
        // Route."Location Code" := '';
        Route."Shipping Location" := Location.Code;
        Route."Receipt Location" := Location.Code;
        //HEI.36<<
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.20<<

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG077', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF NOT Location."Sales Gate Entry Mandatory FND" THEN BEGIN
            Location."Sales Gate Entry Mandatory FND" := TRUE;
            Location.MODIFY;
        END;
        //HEI.20<<

        //Check default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG077', COMPANYNAME, DATABASE::Bin);
        Bin.GET(Location.Code, UnitTestingValues.Value);

        //BC UPGRADE KUMARR78 03-06-2026++
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG077', COMPANYNAME, DATABASE::Zone);
        Zone.GET(Location.Code, UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 03-06-2026++



        //HEI.20>>
        IF Location."Shipment Bin Code" <> Bin.Code THEN
            Location."Shipment Bin Code" := Bin.Code;
        Location.MODIFY;

        //Check default value for Truck

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG077', COMPANYNAME, DATABASE::Vehicle101FDW);
        IF NOT Truck.GET(UnitTestingValues.Value) THEN BEGIN
            Truck.INIT;
            Truck.Code := 'LOG077';
            Truck.INSERT;
        END ELSE
            //BC UPGRADE KUMARR78 << 02-06-2026

            IF Truck."Status FND" <> Truck."Status FND"::Open THEN BEGIN
                Truck."Status FND" := Truck."Status FND"::Open;
                Truck.MODIFY;
            END;
        //BC UPGRADE KUMARR78 << 02-06-2026

        //Check default value for Driver

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG077', COMPANYNAME, DATABASE::Driver107FDW);
        IF NOT Driver.GET(UnitTestingValues.Value) THEN BEGIN
            Driver.INIT;
            Driver.Code := 'LOG077';
            Driver.INSERT;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG077', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // UnitTestingValues.RESET;
        // UnitTestingValues.GET('LOG077', COMPANYNAME, DATABASE::"Shipping Agent Services");
        // IF ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value) THEN
        //     IF ShippingAgentServices."Allow Shipping Cost Per" <> ShippingAgentServices."Allow Shipping Cost Per"::" " THEN BEGIN
        //         ShippingAgentServices."Allow Shipping Cost Per" := ShippingAgentServices."Allow Shipping Cost Per"::" ";
        //         ShippingAgentServices.MODIFY;
        //     END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Gate Entry No. Series
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG077', COMPANYNAME, DATABASE::"No. Series");
        NoSeries.GET(UnitTestingValues.Value);
        IF NOT NoSeries."Manual Nos." THEN BEGIN
            NoSeries."Manual Nos." := TRUE;
            NoSeries.MODIFY;
        END;

        //Disable mandatory Expiration Date
        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Strict Expiration Posting" THEN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        //Add Gate Entry No. Series
        WarehouseSetup.GET;
        IF WarehouseSetup."Gate Entry Nos. FND" = '' THEN
            WarehouseSetup."Gate Entry Nos. FND" := NoSeries.Code;
        IF NOT WarehouseSetup."Allow Collect Lines FND" THEN
            WarehouseSetup."Allow Collect Lines FND" := TRUE;
        WarehouseSetup.MODIFY;

        //Add Default Location for UserID
        WarehouseEmployee.SETRANGE("User ID", USERID);
        WarehouseEmployee.SETRANGE("Location Code", Location.Code);
        // WarehouseEmployee.SETRANGE("Zone Code FND", Zone.Code);//BC UPGRADE KUMARR78 03-06-2026--
        WarehouseEmployee.SETRANGE("Zone Code", Zone.Code);//BC UPGRADE KUMARR78 03-06-2026++


        IF WarehouseEmployee.FINDFIRST THEN BEGIN
            IF NOT WarehouseEmployee.Default THEN BEGIN
                WarehouseEmployee.Default := TRUE;
                WarehouseEmployee.MODIFY;
            END;
        END ELSE BEGIN
            WarehouseEmployee.INIT;
            WarehouseEmployee."User ID" := USERID;
            WarehouseEmployee."Location Code" := Location.Code;
            // WarehouseEmployee."Zone Code FND" := Zone.Code;//BC UPGRADE KUMARR78 03-06-2026--
            WarehouseEmployee."Zone Code" := Zone.Code;//BC UPGRADE KUMARR78 03-06-2026++

            WarehouseEmployee.Default := TRUE;
            WarehouseEmployee.INSERT;
        END;

        //Disable Credit Limit
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.20<<

        //Step 1 - Required Setup: Either in Location on in Zone "Sales Gate Entry Mandatory FND" boolean is checked
        Location.TESTFIELD("Sales Gate Entry Mandatory FND", TRUE);

        //Step 2 - Create a Sales Order with complete information
        SalesOrderList.OPENEDIT;
        SalesOrder.OPENNEW;
        SalesOrder.NEW;
        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);
        SalesOrder."Location Code".SETVALUE(Location.Code); //HEI.20
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code);
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);
        SalesOrder."External Document No.".SETVALUE('Unit Test LOG077');

        //HEI.20>>
        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38
        //HEI.20<<

        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        SalesOrder.SalesLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure");//Bc Upgrade VAMSIU01
        //HEI.20>>
        //SalesOrder.SalesLines."Location Code".SETVALUE(Location.Code);

        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;
        //HEI.20<<

        //Step 3 - Release the Order
        SalesOrder.Release.INVOKE;

        //Step 4 - Create Warehouse Shipment
        WarehouseShipment.TRAP;
        // SalesOrder.Action149.INVOKE; //BC UPGRADE KUMARR78 Blocking As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder."Create &Warehouse Shipment".INVOKE; //BC UPGRADE KUMARR78 Adding As Changing Action 

        //WarehouseShipment.OPENVIEW;
        //WarehouseShipment.FILTER.SETFILTER("Source No.",SalesOrder."No.".VALUE);
        // WarehouseShipment.Action1100076703.INVOKE; //Auto FEFO//BC UPGRADE KUMARR78 DIT Action
        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke(); //BC UPGRADE KUMARR78 02-06-2026


        //HEI.20>>
        //--Take Driver, Truck from Unit Testing Values
        //IF WarehouseShipment."Truck Code".VALUE = '' THEN BEGIN
        //Truck.SETRANGE(Status,Truck.Status::Open);
        //Truck.FINDFIRST;
        //WarehouseShipment."Truck Code".SETVALUE(Truck.Code);
        //END;
        //IF WarehouseShipment."Driver Code".VALUE = '' THEN BEGIN
        //Driver.FINDFIRST;
        //WarehouseShipment."Driver Code".SETVALUE(Driver.Code);
        //END;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseShipment."Shipping Agent Code".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseShipment."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        IF Driver.Code <> '' THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Truck.Code <> '' THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.20<<

        //Release Whse. Shipment
        // WarehouseShipment.Action45.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        WarehouseShipment."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //Step 5 - Create Gate entry document from warehouse shipment
        //HEI.20>>
        IF NOT GateEntryHeader.FINDLAST THEN BEGIN
            GateEntryHeader.INIT;
            GateEntryHeader."Gate Entry Document No." := 'LOG077';
            GateEntryHeader.INSERT;
        END;
        //HEI.20<<
        WarehouseShipment.CreateGateEntryOutbound.INVOKE;

        //Step 6 - Post Whse. Shipment
        // -if  we post the Whse Ship now, we cannot modify the Gate Entry Document.

        //Step 7-22 are in function GateEntryOutbound_ModalPageHandler
        GateEntryOutbound.OPENVIEW;
        GateEntryOutbound.FILTER.SETFILTER("Gate Entry Document No.", WarehouseShipment."Gate Entry No.".VALUE);
        // GateEntryOutbound.Action55001.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        GateEntryOutbound.Register.INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //Step 6 - Post Whse. Shipment
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"
        //HEI.08>>
    end;

