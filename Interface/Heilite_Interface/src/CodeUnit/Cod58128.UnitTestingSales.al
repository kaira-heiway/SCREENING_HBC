    local procedure InitSetupData(TestScriptCode: Code[20]);
    var
        GeneralInterfaceSetup: Record "General Interface Setup INT";
        UserSetup: Record "User Setup";
        ApprovalUserSetup: Record "User Setup";
        JobQueueEntry: Record "Job Queue Entry";
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable
        Route: Record Route107FDW;
        CompanyInformation: Record "Company Information";
        Customer: Record Customer;
        BillToCustomer: Record Customer;
        Item: Record Item;
        SalesPrice: Record "Sales Price";
        SalesPrice2: Record "Sales Price";
        RestrictedRecord: Record "Restricted Record";
        WarehouseShipmentHeader: Record "Warehouse Shipment Header";
        SalesReceivablesSetup: Record "Sales & Receivables Setup";
        PurchaseHeader: Record "Purchase Header";
        GLAccount: Record "G/L Account";
        // PaymentStep: Record "10862";//BC UPGRADE KUMARR78 Blocking FNC Localisation variable
        InventoryPeriod: Record "Inventory Period";
        DefaultDimension: Record "Default Dimension";
        WarehouseReceiptHeader: Record "Warehouse Receipt Header";
        DimensionValues: Record "Dimension Value";
        EbfCombination: Record "Ebf Combination FND";
        ReservationEntry: Record "Reservation Entry";
        Location: Record Location;
        InterfaceSetup: Record "Interface Setup INT";
        Currency: Record Currency;
        LotNoInformation: Record "Lot No. Information";
        GeneralPostingSetup: Record "General Posting Setup";
        GeneralPostingSetup2: Record "General Posting Setup";
        SalesHeader: Record "Sales Header";
        SalesLine: Record "Sales Line";
    begin
        //HEI.45>>
        WarehouseShipmentHeader.DELETEALL();
        WarehouseReceiptHeader.DELETEALL();//HEI.51
        SalesPrice.DeleteAll(); //BC UPGRADE ATHUKS01 
        //HEI.54>>
        UnitTestingValues.RESET;
        UnitTestingValues.SETRANGE("Test Script Code", TestScriptCode);
        UnitTestingValues.SETRANGE("Table ID", DATABASE::Item);
        UnitTestingValues.SETFILTER(Value, '<>%1', '');
        IF UnitTestingValues.FINDFIRST THEN BEGIN
            ReservationEntry.SETRANGE("Item No.", UnitTestingValues.Value);
            ReservationEntry.DELETEALL;
        END;
        //HEI.54<<
        //HEI.55>>
        UnitTestingValues.RESET;
        UnitTestingValues.SETRANGE("Test Script Code", TestScriptCode);
        UnitTestingValues.SETRANGE("Table ID", DATABASE::Location);
        UnitTestingValues.SETFILTER(Value, '<>%1', '');
        IF UnitTestingValues.FINDFIRST THEN BEGIN
            IF Location.GET(UnitTestingValues.Value) THEN BEGIN
                Location."Require Shipment" := TRUE;
                Location."Require Receive" := TRUE;
                Location.MODIFY;
            END;
        END;
        //HEI.55<<
        SalesReceivablesSetup.GET;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF SalesReceivablesSetup."Item Exclusivity Warning" <> SalesReceivablesSetup."Item Exclusivity Warning"::"No Warning" THEN BEGIN
        //     SalesReceivablesSetup."Item Exclusivity Warning" := SalesReceivablesSetup."Item Exclusivity Warning"::"No Warning";
        //     SalesReceivablesSetup.MODIFY;
        // END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.45<<
        //HEI.47>>
        IF SalesReceivablesSetup."Ref Value for Cash Cust. FND" <> 0 THEN BEGIN
            SalesReceivablesSetup."Ref Value for Cash Cust. FND" := 0;
            SalesReceivablesSetup.MODIFY;
        END;
        //HEI.47<<
        //HEI.48>>
        DefaultDimension.SETRANGE("Value Posting", DefaultDimension."Value Posting"::"Code Mandatory");
        DefaultDimension.MODIFYALL("Value Posting", DefaultDimension."Value Posting"::" ");
        //HEI.48<<
        //HEI.51>>
        //HEI.52>>
        DimensionValues.RESET;
        DimensionValues.SETCURRENTKEY(Blocked);
        DimensionValues.SETRANGE("Dimension Code", 'CHANNEL');
        DimensionValues.SETRANGE(Blocked, TRUE);
        DimensionValues.MODIFYALL(Blocked, FALSE);
        //HEI.52<<
        //HEI.51<<
        //HEI.34>>
        //Setup current user for Interface Job Queue User ID
        GeneralInterfaceSetup.GET;
        IF GeneralInterfaceSetup."Interface Job Queue User ID" <> USERID THEN BEGIN
            GeneralInterfaceSetup."Interface Job Queue User ID" := USERID;
            GeneralInterfaceSetup.MODIFY;
        END;
        //HEI.46<<
        PurchaseHeader.SETRANGE("Document Type", PurchaseHeader."Document Type"::"Blanket Order");
        PurchaseHeader.MODIFYALL("Valid To FND", 0D);
        GLAccount.SETRANGE(Blocked, TRUE);
        GLAccount.MODIFYALL(Blocked, FALSE);

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // PaymentStep.SETRANGE("Action Type", PaymentStep."Action Type"::File);
        // PaymentStep.MODIFYALL("Action Type", PaymentStep."Action Type"::None);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        InventoryPeriod.SETRANGE(Closed, TRUE);
        InventoryPeriod.MODIFYALL(Closed, FALSE);
        //HEI.46>>
        //Start Job Queue Entry with category NOTIFYNOW
        JobQueueEntry.SETRANGE("Job Queue Category Code", 'NOTIFYNOW');
        JobQueueEntry.MODIFYALL(Status, JobQueueEntry.Status::Ready);

        //Update E-mail address for all User Setup
        UserSetup.SETFILTER("E-Mail", '<>%1', '');
        IF UserSetup.FINDSET THEN
            UserSetup.MODIFYALL("E-Mail", 'unittesting@heineken.com');
        //HEI.34<<

        //HEI.38>>
        ApprovalUserSetup.GET(USERID);
        UserSetup.RESET;
        UserSetup.SETRANGE("Unlimited Sales Approval", TRUE);
        IF UserSetup.FINDFIRST THEN
            ApprovalUserSetup."Approver ID" := UserSetup."User ID"
        ELSE BEGIN
            UserSetup.SETRANGE("Unlimited Sales Approval");
            UserSetup.SETRANGE("Unlimited Purchase Approval", TRUE);
            IF UserSetup.FINDFIRST THEN
                ApprovalUserSetup."Approver ID" := UserSetup."User ID";
        END;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // UserSetup.RESET;
        // UserSetup.SETRANGE("Unlimited Cr. Limit Customer", TRUE);
        // IF UserSetup.FINDFIRST THEN
        //     ApprovalUserSetup."Credit Limit Approver ID" := UserSetup."User ID";

        // UserSetup.RESET;
        // UserSetup.SETRANGE("Unlimited Deposit Limit Cust.", TRUE);
        // IF UserSetup.FINDFIRST THEN
        //     ApprovalUserSetup."Deposit Limit Approver ID" := UserSetup."User ID";

        // UserSetup.RESET;
        // UserSetup.SETRANGE("Unlimited Overdue Approval", TRUE);
        // IF UserSetup.FINDFIRST THEN
        //     ApprovalUserSetup."Overdue Approver ID" := UserSetup."User ID";
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        ApprovalUserSetup.MODIFY;
        //HEI.38<<

        //HEI.36>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // Route.SETRANGE("Multiple Order Route", TRUE);
        // Route.MODIFYALL("Multiple Order Route", FALSE);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        GeneralLedgerSetup.GET;
        IF GeneralLedgerSetup."Enable TIN By Location FND" THEN BEGIN
            GeneralLedgerSetup."Enable TIN By Location FND" := FALSE;
            GeneralLedgerSetup.MODIFY;
        END;

        //HEI.41>>
        CompanyInformation.GET;
        IF CompanyInformation."E-Mail" = '' THEN BEGIN
            CompanyInformation."E-Mail" := 'companyemail@heineken.com';
            CompanyInformation.MODIFY;
        END;
        //HEI.41<<

        //HEI.42>>
        PurchasesPayablesSetup.GET;
        //HEI.57>>
        IF PurchasesPayablesSetup."Exact Cost Reversing Mandatory" THEN
            PurchasesPayablesSetup."Exact Cost Reversing Mandatory" := FALSE;
        IF PurchasesPayablesSetup."Mandatory Region on Header FND" THEN
            PurchasesPayablesSetup."Mandatory Region on Header FND" := FALSE;
        PurchasesPayablesSetup.MODIFY;
        //HEI.57<<
        WarehouseSetup.GET;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF WarehouseSetup."Whse. Doc. per Phys. Location" THEN BEGIN
        //     WarehouseSetup."Whse. Doc. per Phys. Location" := FALSE;
        //     WarehouseSetup.MODIFY;
        // END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.42<<
        //HEI.65>>
        IF COMPANYNAME = '10_SierraLeone' THEN BEGIN
            IF Currency.GET('SLE') THEN
                Currency.MODIFYALL("Invoice Rounding Precision", Currency."Amount Rounding Precision");
        END;
        //HEI.65<<
        //HEI.43>>
        //Remove  Credit Limit of Customer, setup Shipping Advice = Complete
        UnitTestingValues.RESET;
        UnitTestingValues.SETRANGE("Test Script Code", TestScriptCode);
        UnitTestingValues.SETRANGE("Table ID", DATABASE::Customer);
        UnitTestingValues.SETFILTER(Value, '<>%1', '');
        IF UnitTestingValues.FINDFIRST THEN BEGIN
            Customer.GET(UnitTestingValues.Value);

            //BC UPGRADE KUMARR78 >> Blocking DIT Code
            // IF Customer."Credit Limit" THEN BEGIN
            //     Customer."Credit Limit" := FALSE;
            //     Customer."Credit Limit (LCY)" := 0;
            // END;
            //BC UPGRADE KUMARR78 << Blocking DIT Code

            IF Customer."Shipping Advice" = Customer."Shipping Advice"::Partial THEN
                Customer."Shipping Advice" := Customer."Shipping Advice"::Complete;
            Customer.MODIFY;

            IF Customer."Bill-to Customer No." <> '' THEN
                BillToCustomer.GET(Customer."Bill-to Customer No.")
            ELSE
                BillToCustomer.GET(Customer."No.");
            IF NOT BillToCustomer."Block Payment Tolerance" THEN BEGIN
                BillToCustomer."Block Payment Tolerance" := TRUE;
                BillToCustomer.MODIFY;
            END;
        END;
        //Add Sales Prices for Item
        UnitTestingValues.RESET;
        UnitTestingValues.SETRANGE("Test Script Code", TestScriptCode);
        UnitTestingValues.SETRANGE("Table ID", DATABASE::Item);
        UnitTestingValues.SETFILTER(Value, '<>%1', '');
        IF UnitTestingValues.FINDFIRST THEN BEGIN
            Item.GET(UnitTestingValues.Value);
            SalesPrice.RESET;
            SalesPrice.SETRANGE("Item No.", Item."No.");
            SalesPrice.SETRANGE("Unit of Measure Code", Item."Sales Unit of Measure");
            SalesPrice.SETRANGE("Starting Date", 0D, TODAY);
            SalesPrice.SETFILTER("Ending Date", '%1|>%2', 0D, TODAY);
            SalesPrice.SETFILTER("Unit Price", '>1', 0);
            //HEI.44>>
            SalesPrice.SETRANGE("Sales Type", SalesPrice."Sales Type"::"Customer Price Group");
            SalesPrice.SETRANGE("Sales Code", Customer."Customer Price Group");
            //HEI.44<<
            //IF SalesPrice.ISEMPTY THEN BEGIN
            if not SalesPrice.FINDFIRST then begin
                SalesPrice2.INIT;
                SalesPrice2."Item No." := Item."No.";
                SalesPrice2."Sales Type" := SalesPrice2."Sales Type"::"All Customers";
                SalesPrice2."Unit of Measure Code" := Item."Sales Unit of Measure";
                SalesPrice2."Unit Price" := 100;
                SalesPrice2."Starting Date" := CALCDATE('<-CM>', WORKDATE);
                SalesPrice2.INSERT;
            END;
        END;
        //HEI.43<<
        //HEI.56>>
        //HEI.64>>
        UnitTestingValues.RESET;
        UnitTestingValues.SETRANGE("Test Script Code", TestScriptCode);
        UnitTestingValues.SETRANGE("Table ID", DATABASE::Item);
        UnitTestingValues.SETFILTER(Value, '<>%1', '');
        IF UnitTestingValues.FINDFIRST THEN BEGIN
            Item.GET(UnitTestingValues.Value);
            DefaultDimension.RESET;
            DefaultDimension.SETRANGE("Table ID", 27);
            DefaultDimension.SETRANGE("No.", Item."No.");
            DefaultDimension.SETRANGE("Dimension Code", 'CCC');
            IF DefaultDimension.FINDFIRST THEN BEGIN
                EbfCombination.RESET;
                EbfCombination.SETCURRENTKEY("GL Account No.", "Dimension Code", "Dimension Value Code");
                EbfCombination.SETRANGE("Dimension Value Code", DefaultDimension."Dimension Value Code");//HEI.66>>
                                                                                                         //EbfCombination.SETRANGE("Dimension Code",GeneralLedgerSetup."Shortcut Dimension 3 Code");
                EbfCombination.SETFILTER("Combination Restriction", '%1|%2', EbfCombination."Combination Restriction"::"Allowed with Warn", EbfCombination."Combination Restriction"::"Not Allowed");
                IF EbfCombination.FINDFIRST THEN
                    EbfCombination.DELETEALL;
            END;
        END;
        //HEI.66>>
        IF COMPANYNAME = 'Bralirwa' THEN BEGIN
            EbfCombination.RESET;
            EbfCombination.SETRANGE("Dimension Code", 'MVMT');
            EbfCombination.SETFILTER("Combination Restriction", '%1|%2', EbfCombination."Combination Restriction"::"Allowed with Warn", EbfCombination."Combination Restriction"::"Not Allowed");
            EbfCombination.DELETEALL;
        END;
        //HEI.67>>
        //Specific fix for Haiti attenpted divided by zero error temporary solution
        IF COMPANYNAME = '10_Haiti' THEN BEGIN
            LotNoInformation.SETRANGE("Lot No.", 'L2071332I1');
            IF LotNoInformation.FINDFIRST THEN BEGIN
                // LotNoInformation."Quality Status" := LotNoInformation."Quality Status"::Quarantine;//BC UPGRADE KUMARR78 >> Blocking DIT Code
                LotNoInformation.Blocked := TRUE;
                LotNoInformation.MODIFY;
            END;
        END;
        GeneralPostingSetup.RESET;
        GeneralPostingSetup.SETFILTER("COGS Account", '');
        GeneralPostingSetup.SETFILTER("Gen. Bus. Posting Group", '<>%1', '');
        IF GeneralPostingSetup.FINDSET THEN
            REPEAT
                GeneralPostingSetup2.SETFILTER("COGS Account", '<>%1', '');
                IF GeneralPostingSetup2.FINDFIRST THEN BEGIN
                    GeneralPostingSetup."COGS Account" := GeneralPostingSetup2."COGS Account";
                    GeneralPostingSetup."COGS Account (Interim)" := GeneralPostingSetup2."COGS Account";
                    GeneralPostingSetup.MODIFY;
                END;
            UNTIL GeneralPostingSetup.NEXT = 0;
        //HEI.67<<
        //HEI.66<<
        //HEI.56<<
        //HEI.64<<
        //HEI.44>>
        //Remove Restricted Records
        IF NOT RestrictedRecord.ISEMPTY THEN
            RestrictedRecord.DELETEALL;
        //HEI.44>>
        //HEI.59>>
        IF Customer."Contract Type FND" <> Customer."Contract Type FND"::" " THEN BEGIN
            Customer."Contract Type FND" := Customer."Contract Type FND"::" ";
            Customer.MODIFY;
        END;
        IF SalesReceivablesSetup.GET THEN
            SalesReceivablesSetup.MODIFYALL("Check Credit Limit Release FND", FALSE);
        IF BVMInterfaceSetup.GET THEN
            IF InterfaceSetup.GET(BVMInterfaceSetup."BVM Customer Interface Code") THEN BEGIN
                InterfaceSetup.Enabled := FALSE;
                InterfaceSetup.MODIFY;
            END;
        //HEI.59<<
        COMMIT;
        //HEI.36<<
    end;

