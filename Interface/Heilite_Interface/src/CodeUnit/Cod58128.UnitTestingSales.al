        SalesOrderNo := SalesOrder."No.".VALUE;

        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.38

        //Create Sales Line
        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);

        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;

        //Release
        SalesOrder.Release.INVOKE;

        //Create & Post Whse. Shipment
        WarehouseShipment.TRAP;
        // SalesOrder.Action149.INVOKE; //BC UPGRADE KUMARR78 Blocking As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder."Create &Warehouse Shipment".INVOKE; //BC UPGRADE KUMARR78 Adding As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"

        //Auto-FEFO
        WarehouseShipment."Posting Date".SETVALUE(CALCDATE('<-1M>', WORKDATE));

        // WarehouseShipment.Action1100076703.INVOKE;//BC UPGRADE KUMARR78 DIT Action
        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke();//BC Upgrade VAMSIU01 Added

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseShipment."Shipping Agent Code".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseShipment."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Post
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"

        //Post Sales Order
        SalesOrder.Post.INVOKE;

        //Step 2,3- Open "Payment Slips List"

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // PaymentSlipList.OPENVIEW;
        // PaymentSlip.OPENNEW;

        // //Step 4- Click on “New” to get a new Payment Slip
        // PaymentSlip.NEW;

        // //Step 5 -Select “PRELEVEMENTS CLENTS SEPA” and click “OK”
        // PaymentSlip."Partner Type".SETVALUE(PartnerType::Person);

        // //Step 6 -Fill the fields of posting menu
        // IF (PaymentSlip."Account No.".VALUE = '') AND
        //    (BankAccount."No." <> '')
        // THEN BEGIN
        //     PaymentSlip."Account Type".SETVALUE(AccountType::"Bank Account");
        //     PaymentSlip."Account No.".SETVALUE(BankAccount."No.");
        // END;

        // //Step 7,8 - Click on “Suggest Customer Payment”
        // PaymentHeader.GET(PaymentSlip."No.".VALUE);
        // IF PaymentClass.GET(PaymentSlip."Payment Class".VALUE) THEN
        //     IF PaymentClass.Suggestions = PaymentClass.Suggestions::Customer THEN BEGIN
        //         CreateCustomerPmtSuggestion.SetGenPayLine(PaymentHeader);
        //         Customer2.SETRANGE("No.", BillToCustomer."No.");
        //         CreateCustomerPmtSuggestion.SETTABLEVIEW(Customer2);
        //         COMMIT;
        //         CreateCustomerPmtSuggestion.RUNMODAL;
        //     END;

        // //Step 9- Select the Bank Account number and the Direct Debit Mandate
        // PaymentSlip.Lines.FILTER.SETFILTER("Account No.", BillToCustomer."No.");
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        CustomerBankAccount.SETRANGE("Customer No.", BillToCustomer."No.");
        IF NOT CustomerBankAccount.FINDFIRST THEN BEGIN //HEI.29
            CustomerBankAccount2.SETFILTER(IBAN, '<>%1', ''); //HEI.29
            IF CustomerBankAccount2.FINDFIRST THEN BEGIN
                CustomerBankAccount.INIT;
                CustomerBankAccount := CustomerBankAccount2;
                CustomerBankAccount."Customer No." := BillToCustomer."No.";
                CustomerBankAccount.INSERT;
            END;
        END; //HEI.29

        // PaymentSlip.Lines."Bank Account Code".SETVALUE(CustomerBankAccount.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code

        SEPADirectDebitMandate.SETRANGE("Customer No.", BillToCustomer."No.");
        SEPADirectDebitMandate.SETRANGE("Customer Bank Account Code", CustomerBankAccount.Code);
        IF NOT SEPADirectDebitMandate.FINDFIRST THEN
            IF SEPADirectDebitMandate2.FINDFIRST THEN BEGIN
                SEPADirectDebitMandate.INIT;
                SEPADirectDebitMandate := SEPADirectDebitMandate2;
                SEPADirectDebitMandate."Customer No." := BillToCustomer."No.";
                SEPADirectDebitMandate."Customer Bank Account Code" := CustomerBankAccount.Code;
                SEPADirectDebitMandate.ID := 'OTCDD';
                SEPADirectDebitMandate.INSERT;
            END;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // PaymentSlip.Lines."Direct Debit Mandate ID".SETVALUE(SEPADirectDebitMandate.ID);
        // //HEI.60>>
        // PaymentStep.RESET;
        // PaymentStep.SETRANGE("Verify Due Date", TRUE);
        // PaymentStep.MODIFYALL("Verify Due Date", FALSE);
        // //HEI.60<<
        // //Step 10,11,12- Click on Actions > Print
        // PaymentSlip.Print.INVOKE;

        // //Step 13,14 - Click on “Generate file”:
        // PaymentSlip.GenerateFile.INVOKE;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.28<<
    end;

