        END;
        //HEI.58<<
        //HEI.22>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Customer."Purchasing Code" <> '' THEN
        //     Customer."Purchasing Code" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF Customer."Shipping Advice" = Customer."Shipping Advice"::Partial THEN
            Customer."Shipping Advice" := Customer."Shipping Advice"::Complete;
        Customer.MODIFY;

        IF Customer."Bill-to Customer No." <> '' THEN
            BillToCustomer.GET(Customer."Bill-to Customer No.")
        ELSE
            BillToCustomer.GET(Customer."No.");
        //HEI.23>>
        //IF BillToCustomer."Reminder Terms Code" = '' THEN BEGIN
        IF BillToCustomer."Reminder Terms Code" <> 'DOMESTIC' THEN
            //HEI.23<<
            BillToCustomer."Reminder Terms Code" := 'DOMESTIC';
        //HEI.23>>
        IF BillToCustomer."Currency Code" <> '' THEN
            BillToCustomer."Currency Code" := '';
        IF BillToCustomer."Application Method" = BillToCustomer."Application Method"::"Apply to Oldest" THEN
            BillToCustomer."Application Method" := BillToCustomer."Application Method"::Manual;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF BillToCustomer."Free Item" THEN
        //     BillToCustomer."Free Item" := FALSE;
        // IF BillToCustomer."Free Reason Code" <> '' THEN
        //     BillToCustomer."Free Reason Code" := '';
        // IF BillToCustomer."Gen. Bus. Posting Free Group" <> '' THEN
        //     BillToCustomer."Gen. Bus. Posting Free Group" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.23<<
        BillToCustomer.MODIFY;
        //END; //HEI.23
        IF CustomerAttributes.GET(BillToCustomer."No.") THEN BEGIN
            CustomerAttributes."Invoice Email Address" := 'OTC081@heineken.com';
            CustomerAttributes.MODIFY;
            //HEI.61>>
        END ELSE BEGIN
            CustomerAttributes.INIT;
            CustomerAttributes."Customer No." := BillToCustomer."No.";
            CustomerAttributes.INSERT;
            CustomerAttributes."Account Group" := BillToCustomer."Account Group FND";
            CustomerAttributes."Invoice Email Address" := 'OTC081@heineken.com';
            CustomerAttributes.MODIFY;
        END;
        //HEI.61<<
        //HEI.22<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC081', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);
        //HEI.50>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Item."Sales Price Warning" <> Item."Sales Price Warning"::"No Warning" THEN
        //     Item."Sales Price Warning" := Item."Sales Price Warning"::"No Warning";
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        IF Item."Unit Price" = 0 THEN
            Item."Unit Price" := 100;
        Item.MODIFY;
        //HEI.50<<

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC081', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        //HEI.23>>
        IF Location."Sales Gate Entry Mandatory FND" THEN BEGIN
            Location."Sales Gate Entry Mandatory FND" := FALSE;
            Location.MODIFY;
        END;
        //HEI.23<<

        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC081', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //HEI.22>>
        IF Route."Multiple Order Route" THEN
            Route."Multiple Order Route" := FALSE;
        //HEI.36>>
        // Route."Location Code" := Location.Code;
        // Route."Return Location Code" := Location.Code;
        //BC Upgrade VAMSIU01 replaced location code fields from route table with new fields >>
        Route."Shipping Location" := Location.Code;
        Route."Receipt Location" := Location.Code;
        //HEI.36<<
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        // END; //HEI.36
        //HEI.22<<

        //Check default value for Document Subtype Code

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC081', COMPANYNAME, DATABASE::"Document Subtype Code FND");
        DocumentSubtypeCode.GET(UnitTestingValues.Value);
        // BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Payment Terms
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC081', COMPANYNAME, DATABASE::"Payment Terms");
        PaymentTerms.GET(UnitTestingValues.Value);

        //HEI.22>>
        //Check the default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC081', COMPANYNAME, DATABASE::Bin);
        Bin.SETRANGE(Code, UnitTestingValues.Value);
        Bin.FINDFIRST;

        IF Location."Shipment Bin Code" <> Bin.Code THEN BEGIN
            Location."Shipment Bin Code" := Bin.Code;
            Location.MODIFY;
        END;

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC081', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Ship. Agent Serv. Mand. APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC081', COMPANYNAME, DATABASE::"Shipping Agent Services");
            ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value);
        END;

        //Check the default value for Driver
        IF Route."Driver Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC081', COMPANYNAME, DATABASE::Driver107FDW);
            Driver.GET(UnitTestingValues.Value);
        END;

        //Check the default value for Truck
        IF Route."Vehicle Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC081', COMPANYNAME, DATABASE::Vehicle101FDW);
            Truck.GET(UnitTestingValues.Value);
        END;

        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Disable Notifications for Credit Limit and Stockout
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Activate CIS System FND" THEN
            SalesReceivablesSetup."Activate CIS System FND" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;

        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Strict Expiration Posting" THEN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;
        //HEI.22<<

        //HEI.23>>
        //Additional Fee on Reminder Level removed
        ReminderLevel.SETRANGE("Reminder Terms Code", BillToCustomer."Reminder Terms Code");
        ReminderLevel.SETFILTER("Additional Fee (LCY)", '>%1', 0);
        IF ReminderLevel.FINDSET THEN
            REPEAT
                ReminderLevel."Additional Fee (LCY)" := 0;
                ReminderLevel.MODIFY;
            UNTIL ReminderLevel.NEXT = 0
        ELSE BEGIN
            ReminderLevel.SETFILTER("Add. Fee per Line Amount (LCY)", '>%1', 0);
            IF ReminderLevel.FINDFIRST THEN
                REPEAT
                    ReminderLevel."Add. Fee per Line Amount (LCY)" := 0;
                    ReminderLevel.MODIFY;
                UNTIL ReminderLevel.NEXT = 0;
        END;

        //Disable Gate Control
        Zone.SETRANGE("Location Code", Location.Code);
        Zone.SETRANGE("Sales Gate Entry Mandatory FND", TRUE);
        IF Zone.FINDSET THEN
            REPEAT
                Zone."Sales Gate Entry Mandatory FND" := FALSE;
                Zone.MODIFY;
            UNTIL Zone.NEXT = 0;

        IF CustomerPostingGroup.GET(BillToCustomer."Customer Posting Group") THEN
            IF GLAccount.GET(CustomerPostingGroup."Invoice Rounding Account") THEN
                IF GenProductPostingGroup.GET(GLAccount."Gen. Prod. Posting Group") THEN
                    IF GenProductPostingGroup."Auto Insert Default" THEN BEGIN
                        GenProductPostingGroup."Auto Insert Default" := FALSE;
                        GenProductPostingGroup.MODIFY;
                    END;
        //HEI.23<<

        //Step 1: Login

