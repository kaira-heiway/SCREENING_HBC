            EbfCombination.DELETEALL;
        END;
        //HEI.65<<
        //HEI.64<<

        //Update FA Template
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // FADepreciationBookTemplate.SETRANGE("FA Template Code", 'CTS');
        // IF FADepreciationBookTemplate.FINDSET THEN
        //     REPEAT
        //         FAPostingGroup.RESET;
        //         AcquisitionCostAcc.RESET;
        //         FAPostingGroup.GET(FADepreciationBookTemplate."FA Posting Group");
        //         AcquisitionCostAcc.GET(FAPostingGroup."Acquisition Cost Account");
        //         IF AcquisitionCostAcc.Blocked THEN
        //             AcquisitionCostAcc.Blocked := FALSE;
        //         IF NOT AcquisitionCostAcc."Direct Posting" THEN
        //             AcquisitionCostAcc."Direct Posting" := TRUE;
        //         AcquisitionCostAcc.MODIFY;
        //     UNTIL FADepreciationBookTemplate.NEXT = 0;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.29<<

        //Check default value for Journal Batch
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW22', COMPANYNAME, DATABASE::"Gen. Journal Batch");
        GenJournalBatch.GET(GenJournalTemplate.Name, UnitTestingValues.Value);
        IF GenJournalBatch."No. Series" <> '' THEN BEGIN
            GenJournalBatch."No. Series" := '';
            GenJournalBatch.MODIFY;
        END;

        //Disable mandatory Expiration Date
        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        PurchasesPayablesSetup.GET;
        IF PurchasesPayablesSetup."Requester ID Mandatory FND" THEN BEGIN
            PurchasesPayablesSetup."Requester ID Mandatory FND" := FALSE;
            PurchasesPayablesSetup.MODIFY;
        END;
        //HEI.49>>
        NoSeries.SETRANGE("Manual Nos.", FALSE);
        NoSeries.MODIFYALL("Manual Nos.", TRUE);
        //HEI.49<<
        //Step 1 - Create Fixed Asset
        // FixedAssetList.OPENVIEW;
        FixedAssetCard.OPENNEW;
        FixedAssetCard.NEW;
        FixedAssetCard."No.".SETVALUE('TESTFA');//HEI.45
        //BC UPGRADE ATHUKS01<< Stoping due to FA OnAfter Insert event trigger   
        // FixedAssetCard.Description.SETVALUE('LOGNEW22');
        // FixedAssetCard."Vendor No.".SETVALUE(Vendor."No.");
        //BC UPGRADE ATHUKS01 >> 
        // FixedAssetCard."FA Template Code".SETVALUE('CTS');//BC UPGRADE KUMARR78 >> Blocking DIT Code    
        FixedAssetNo := FixedAssetCard."No.".VALUE;
        FADepreciationBooks.TRAP();
        FixedAssetCard."Depreciation &Books".Invoke();
        // FADepreciationBooks.Filter.SETFILTER("FA No.", FixedAssetNo);
        FADepreciationBooks.OpenNew();
        FADepreciationBooks."FA No.".SETVALUE(FixedAssetNo);
        FADepreciationBooks."Depreciation Book Code".SETVALUE('LOCAL');
        FADepreciationBooks."FA Posting Group".Setvalue('LOC DB IN');
        FADepreciationBooks.close();
        FixedAssetCard.OK.INVOKE;
        //BC UPGRADE ATHUKS01 >> Moving here to avoid OnAfterInsert event trigger which is causing issue in test execution
        FixedAsset.GET(FixedAssetNo);
        FixedAsset.Validate(Description, 'LOGNEW22');
        FixedAsset.Validate("Vendor No.", Vendor."No.");
        FixedAsset.Validate("FA Posting Group", 'LOC DB IN');
        FixedAsset.modify();
        //BC UPGRADE ATHUKS01 >>


        //Step 2 - Create service item
        ServiceItemList.OPENVIEW;
        ServiceItemCard.OPENNEW;
        ServiceItemCard.NEW;
        //HEI.49>>
        //ServiceItemCard."No.".ASSISTEDIT;
        ServiceItemCard."No.".SETVALUE('TESTSI');
        //HEI.49<<
        ServiceItemCard.Description.SETVALUE('LOGNEW22');
        ServiceItemCard."Serial No.".SETVALUE('LOGNEW22');
        ServiceItemCard."Vendor No.".SETVALUE(Vendor."No.");
        ServiceItemCard."Item No.".SETVALUE(Item."No.");
        // ServiceItemCard."FA No.".SETVALUE(FixedAssetNo);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        ServiceItemCard.OK.INVOKE;

        //Step 3 - Create FA Journal lines posting
        GeneralJournalTemplates.OPENVIEW;
        GeneralJournalBatches.TRAP;
        GeneralJournalTemplates.FILTER.SETFILTER(Name, GenJournalTemplate.Name);

        // GeneralJournalTemplates."Page General Journal Batches".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GeneralJournalTemplates."Batches".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        FixedAssetGLJournal.TRAP;
        GeneralJournalBatches.FILTER.SETFILTER(Name, GenJournalBatch.Name);
        GeneralJournalBatches.EditJournal.INVOKE;

        //Remove existing lines in Journal to avoid errors
        GenJournalLine.SETRANGE("Journal Template Name", GenJournalTemplate.Name);
        GenJournalLine.SETRANGE("Journal Batch Name", GenJournalBatch.Name);
        IF GenJournalLine.FINDSET THEN
            GenJournalLine.DELETEALL;

        //Create Journal Line
        //Fixed Asset
        FixedAssetGLJournal.NEW;
        FixedAssetGLJournal."Document Type".SETVALUE(2);
        FixedAssetGLJournal."Document No.".SETVALUE('LOGNEW22');
        FixedAssetGLJournal."Account Type".SETVALUE(4);
        FixedAssetGLJournal."Account No.".SETVALUE(FixedAssetNo);
        FixedAssetGLJournal."FA Posting Type".SETVALUE(1);
        FixedAssetGLJournal."Depreciation Book Code".SETVALUE('LOCAL');
        FixedAssetGLJournal."Gen. Posting Type".SETVALUE(1);
        FixedAssetGLJournal."Gen. Prod. Posting Group".SETVALUE(GLAccount."Gen. Prod. Posting Group");
        //FixedAssetGLJournal."VAT Prod. Posting Group".SETVALUE(GLAccount."VAT Prod. Posting Group"); //HEI.31
        FixedAssetGLJournal.Amount.SETVALUE(1000);
        //Dimensions

        // FixedAssetGLJournal.Action122.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        FixedAssetGLJournal.Dimensions.INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name


        //GL Account
        FixedAssetGLJournal.NEW;
        FixedAssetGLJournal."Document Type".SETVALUE(2);
        FixedAssetGLJournal."Document No.".SETVALUE('LOGNEW22');
        FixedAssetGLJournal."Account Type".SETVALUE(0);
        FixedAssetGLJournal."Account No.".SETVALUE(GLAccount."No.");
        FixedAssetGLJournal."Gen. Posting Type".SETVALUE(1);
        FixedAssetGLJournal."Gen. Prod. Posting Group".SETVALUE(GLAccount."Gen. Prod. Posting Group");
        //FixedAssetGLJournal."VAT Prod. Posting Group".SETVALUE(GLAccount."VAT Prod. Posting Group"); //HEI.31
        FixedAssetGLJournal.Amount.SETVALUE(-1000);

        //HEI.31>>
        //Update VAT Prod. Posting Setup
        FixedAssetGLJournal.OK.INVOKE;
        GeneralJournalTemplates.OK.INVOKE;

        GenJournalLine2.SETRANGE("Document No.", 'LOGNEW22');
        GenJournalLine2.MODIFYALL("VAT Prod. Posting Group", GLAccount."VAT Prod. Posting Group");

        GeneralJournalTemplates.OPENVIEW;
        GeneralJournalBatches.TRAP;
        GeneralJournalTemplates.FILTER.SETFILTER(Name, GenJournalTemplate.Name);

        // GeneralJournalTemplates."Page General Journal Batches".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GeneralJournalTemplates."Batches".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        FixedAssetGLJournal.TRAP;
        GeneralJournalBatches.FILTER.SETFILTER(Name, GenJournalBatch.Name);
        GeneralJournalBatches.EditJournal.INVOKE;
        FixedAssetGLJournal.FILTER.SETFILTER("Document No.", 'LOGNEW22');
        //HEI.31<<

        //HEI.36>>
        //Remove Record Restrictions
        IF RestrictedRecord.FINDSET THEN
            RestrictedRecord.DELETEALL;
        //HEI.36<<

        //Post
        // FixedAssetGLJournal.Action50.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        FixedAssetGLJournal."P&ost".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name


        //Step 4 - Create Purchase order with the specific item
        PurchaseOrder.OPENNEW;
        PurchaseOrder.NEW;
        PurchaseOrder."No.".ASSISTEDIT;
        PurchaseOrder."Buy-from Vendor No.".SETVALUE(Vendor."No.");
        PurchaseOrder."Location Code".SETVALUE(Location.Code);
        // PurchaseOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        PurchaseOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED

        IF Route."Shipping Agent Mand. APS" AND
           (ShippingAgent.Code <> '') AND
           (PurchaseOrder."Shipping Agent Code 107FDW".VALUE <> ShippingAgent.Code)
        THEN
            PurchaseOrder."Shipping Agent Code 107FDW".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" AND
          (ShippingAgentServices.Code <> '') AND
          (PurchaseOrder."Shipping Agent Code 107FDW".VALUE <> ShippingAgentServices.Code)
       THEN
            PurchaseOrder."Shipping Agent Code 107FDW".SETVALUE(ShippingAgentServices.Code);

        IF (PurchaseOrder."LOG Vehicle Code 107FDW".VALUE = '') AND (Truck.Code <> '') THEN
            PurchaseOrder."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        IF (PurchaseOrder."Log Driver 107FDW".VALUE = '') AND (Driver.Code <> '') THEN
            PurchaseOrder."Log Driver 107FDW".SETVALUE(Driver.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        PurchaseOrder.PurchLines.NEW;
        PurchaseOrder.PurchLines.Type.SETVALUE(Type::Item);
        PurchaseOrder.PurchLines."No.".SETVALUE(Item."No.");
        PurchaseOrder.PurchLines."Location Code".SETVALUE(Location.Code);
        PurchaseOrder.PurchLines.Quantity.SETVALUE(1);
        PurchaseOrder.PurchLines.Dimensions.INVOKE;

        //Disable Workflows before Release
        PurchaseHeader.GET(PurchaseHeader."Document Type"::Order, PurchaseOrder."No.".VALUE);
        IF ApprovalsMgmt.IsPurchaseApprovalsWorkflowEnabled(PurchaseHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;

        //HEI.70>>
        //Check Import PO
        PurchaseHeaderAdditional.RESET;
        PurchaseHeaderAdditional.GET(PurchaseHeader."Document Type"::Order, PurchaseOrder."No.".VALUE);
        IF PurchaseHeaderAdditional."Import Identifier" THEN BEGIN
            PurchaseOrder."Expctd Physical Delvry Date(Imp)".SETVALUE(TODAY);
            PurchaseOrder.PurchLines."Location Code".SETVALUE(PurchasesPayablesSetup."Location Code Imp Proc. FND");
        END;
        //HEI.70<<

        PurchaseOrder.Release.INVOKE;

        //Step 5 - Create and post the purchase receipt with the serial Number
        WarehouseReceipt.TRAP;
        // PurchaseOrder.Action149.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        PurchaseOrder."Create &Whse. Receipt".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        WarehouseReceipt.WhseReceiptLines.FILTER.SETFILTER("Item No.", Item."No.");
        ItemTrackingQtyBase := 1;
        SerialNo := 'LOGNEW22';
        WarehouseReceipt.WhseReceiptLines.ItemTrackingLines.INVOKE;

        //HEI.31>>
        //Update Serial No. on Reservation Entry
        ReservationEntry.SETRANGE("Source Type", DATABASE::"Purchase Line");
        ReservationEntry.SETRANGE("Source Subtype", ReservationEntry."Source Subtype"::"1");
        ReservationEntry.SETRANGE("Source ID", PurchaseOrder."No.".VALUE);
        ReservationEntry.SETRANGE("Item No.", Item."No.");
        IF ReservationEntry.FINDFIRST THEN BEGIN
            ReservationEntry."Serial No." := SerialNo;
            ReservationEntry.MODIFY;
        END;
        //HEI.31<<

        WarehouseReceipt."Post Receipt".INVOKE;

        //Step 6 - Create and post the purchase invoice  with the " get receipt line
        PurchaseInvoice.OPENNEW;
        PurchaseInvoice.NEW;
        PurchaseInvoice."No.".ASSISTEDIT;
        PurchaseInvoice."Buy-from Vendor Name".SETVALUE(Vendor."No.");
        PurchaseInvoice."Location Code".SETVALUE(Location.Code);
        PurchaseInvoice.PurchLines.GetReceiptLines.INVOKE;
        PurchaseInvoice."Vendor Invoice No.".SETVALUE('LOGNEW22');
        //BC UPGRADE ATHUKS01 STP_FDD0007 >>
        PurchaseInvoice."Doc. Amount Incl. VAT IBM".SETVALUE(PurchaseInvoice.PurchLines."Total Amount Incl. VAT".VALUE);
        PurchaseInvoice."Doc. Amount VAT IBM".SETVALUE(PurchaseInvoice.PurchLines."Total VAT Amount".VALUE);
        //BC UPGRADE ATHUKS01 STP_FDD0007 <<
        //HEI.29>>
        IF (GeneralLedgerSetup."Inv. Rounding Precision (LCY)" = 1) AND
           (PurchaseInvoice."Currency Code".VALUE = '') //HEI.38
        THEN BEGIN
            decInvRoundAmount := -ROUND(PurchaseInvoice.PurchLines."Total Amount Incl. VAT".ASDECIMAL -
                                 ROUND(PurchaseInvoice.PurchLines."Total Amount Incl. VAT".ASDECIMAL, GeneralLedgerSetup."Inv. Rounding Precision (LCY)"),
                                 GeneralLedgerSetup."Amount Rounding Precision");
            //BC UPGRADE ATHUKS01 STP_FDD0007 >>
            PurchaseInvoice."Doc. Amount Incl. VAT IBM".SETVALUE(PurchaseInvoice.PurchLines."Total Amount Incl. VAT".ASDECIMAL + decInvRoundAmount);
            PurchaseInvoice."Doc. Amount VAT IBM".SETVALUE(PurchaseInvoice.PurchLines."Total VAT Amount".VALUE);
            //BC UPGRADE ATHUKS01 STP_FDD0007 <<
        END;
        PurchaseInvoice.Dimensions.INVOKE;
        PurchaseInvoice.PurchLines.FILTER.SETFILTER("No.", Item."No.");
        IF PurchaseInvoice.PurchLines."Planned Receipt Date".ASDATE = 0D THEN
            PurchaseInvoice.PurchLines."Planned Receipt Date".SETVALUE(WORKDATE);

        // PurchaseInvoice.PurchLines.Action1904974904.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        PurchaseInvoice.PurchLines.Dimensions.INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //HEI.29<<
        PurchaseInvoice.Post.INVOKE;

        //Check posted document
        PurchInvHeader.SETRANGE("Vendor Invoice No.", 'LOGNEW22');
        PurchInvHeader.FINDFIRST;

        //Check Item Leder Entry with Serial No.
        ItemLedgerEntry.SETRANGE("Item No.", Item."No.");
        ItemLedgerEntry.SETRANGE("Serial No.", SerialNo);
        ItemLedgerEntry.FINDFIRST;
        //HEI.26<<
    end;

