        SalesReceivablesSetup.GET;
        //BC UPGRADE KUMARR78 >> Blocking DIT Code 
        // IF SalesReceivablesSetup."Automatic Document Approval" THEN BEGIN
        //     SalesReceivablesSetup."Automatic Document Approval" := FALSE;
        //     SalesReceivablesSetup.MODIFY;
        // END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code 

        //HEI.19>>
        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38
             //HEI.19<<

        // BC Upgrade PATELP08 >> Blocking this ->  Guard ASSERTERROR with ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader), since release succeeds when no approval workflow is enabled.
        // // IF WorkflowManagement.CanExecuteWorkflow(SalesHeader, WorkflowEventHandling.RunWorkflowOnSendSalesDocForApprovalCodeCredit) THEN BEGIN//BC UPGRADE KUMARR78 >> Blocking DIT Event Removed.
        // ASSERTERROR SalesOrder.Release.INVOKE;

        // IF GETLASTERRORTEXT <> DocumentApprovalNeededErr THEN
