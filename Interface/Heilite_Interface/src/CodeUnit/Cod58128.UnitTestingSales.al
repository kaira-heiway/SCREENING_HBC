    [ModalPageHandler]
    procedure DisputecaseModalPageHandlerwithResolutionCode(var DisputeCases: TestPage "Dispute Cases");
    var
        DisputeCardCases: TestPage "Dispute Card Cases";
        DisputeReason: Record "Dispute Reason FND";
        DisputeResolution: Record "Dispute Resolution FND";
        DisputeCategory: Record "Dispute Category FND";
        Status: Option Open,Close;
    begin
        // HEI.10>>
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::"Dispute Category FND");
        DisputeCategory.GET(UnitTestingValues.Value);

        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::"Dispute Reason FND");
        DisputeReason.GET(DisputeCategory.Code, UnitTestingValues.Value);

        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC122', COMPANYNAME, DATABASE::"Dispute Resolution FND");
        DisputeResolution.GET(UnitTestingValues.Value);

        // BC Upgrade PATELP08 - original 2-session flow kept; only "Closing Date" uncommented (v28 needs it before Status::Close)
        DisputeCardCases.OPENNEW;
        DisputeCardCases."Cust. Ledger Entry No.".SETVALUE(CustLedgerNo);
        DisputeCardCases."Dispute Category Code".SETVALUE(DisputeCategory.Code);
        DisputeCardCases."Reason Code".SETVALUE(DisputeReason.Code);
        DisputeCardCases.OK.INVOKE;

        DisputeCardCases.OPENEDIT;
        DisputeCardCases.FINDFIRSTFIELD(DisputeCardCases."Cust. Ledger Entry No.", CustLedgerNo);
        DisputeCardCases."Resolution Code".SETVALUE(DisputeResolution.Code);
        DisputeCardCases."Closing Date".SETVALUE(WORKDATE); // BC Upgrade PATELP08 - uncommented: v28 requires Closing Date before Status::Close
        DisputeCardCases.Status.SETVALUE(Status::Close);
        DisputeCardCases.OK.INVOKE;
        // HEI.10<<
    end;

