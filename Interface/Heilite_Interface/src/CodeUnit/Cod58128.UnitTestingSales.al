    procedure RT_OTC017_CreateCustomerCreditMemo_QuantityCorrection_GoodsLost_GoodsDamaged_QualityIssues();
    var
        Customer: Record Customer;
        Customer2: Record Customer;
        Item: Record Item;
        Location: Record Location;
        ReturnReason: Record "Return Reason";
        Bin: Record Bin;
        SalesLine: Record "Sales Line";
        SalesReturnOrderList: TestPage "Sales Return Order List";
        SalesReturnOrder: TestPage "Sales Return Order";
        WarehouseReceipt: TestPage "Warehouse Receipt";
        ItemTrackingLines: TestPage "Item Tracking Lines";
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        Quantity: Decimal;
        SalesReturnOrderNo: Code[20];
        SalesCrMemoHeader: Record "Sales Cr.Memo Header";
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        Route: Record Route107FDW;
        Truck: Record Vehicle101FDW;
        Driver: Record Driver107FDW;
        ShippingAgent: Record "Shipping Agent";
        ShippingAgent2: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        Zone: Record Zone;
        EbfCombination: Record "Ebf Combination FND";
    begin
        ClearVariables('OTC017'); //HEI.31
        //HEI.04>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.15>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Customer."Purchasing Code" <> '' THEN
        //     Customer."Purchasing Code" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF NOT Customer."Additional RPM Return FND" THEN
            Customer."Additional RPM Return FND" := TRUE;
        Customer.MODIFY;

        //BC UPGRADE KUMARR78 << Blocking DIT Code
        // IF Customer2.GET(Customer."Bill-to Customer No.") THEN BEGIN
        //     IF Customer2."Free Item" THEN
        //         Customer2."Free Item" := FALSE;
        //     IF Customer2."Free Reason Code" <> '' THEN
        //         Customer2."Free Reason Code" := '';
        //     IF Customer2."Gen. Bus. Posting Free Group" <> '' THEN
        //         Customer2."Gen. Bus. Posting Free Group" := '';
        //     Customer2.MODIFY;
        // END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.15<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check default value for Return Reason Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::"Return Reason");
        ReturnReason.GET(UnitTestingValues.Value);

        //Check the default value for Route
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);

        //HEI.15>>
        IF Route."Multiple Order Route" THEN BEGIN
            Route."Multiple Order Route" := FALSE;
            Route.MODIFY;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code\

        //Check the default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);

        //HEI.36>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // Route."Location Code" := Location.Code;
        // Route."Return Location Code" := Location.Code;
        //BC Upgrade VAMSIU01 replaced location code fields from route table with new fields >>
        Route."Shipping Location" := Location.Code;
        Route."Receipt Location" := Location.Code;
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.36<<

        //Check the default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::Zone);
        IF Zone.GET(Location.Code, UnitTestingValues.Value) THEN
            IF Zone."Sales Gate Entry Mandatory FND" THEN BEGIN
                Zone."Sales Gate Entry Mandatory FND" := FALSE;
                Zone.MODIFY;
            END;

        //Check the default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::Bin);
        Bin.SETRANGE(Code, UnitTestingValues.Value);
        Bin.FINDFIRST;

        IF Location."Default Bin Code" <> Bin.Code THEN
            Location."Default Bin Code" := Bin.Code;
        IF Location."Receipt Bin Code" <> Bin.Code THEN
            Location."Receipt Bin Code" := Bin.Code;
        IF Location."Sales Gate Entry Mandatory FND" THEN
            Location."Sales Gate Entry Mandatory FND" := FALSE;
        Location.MODIFY;

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Code" <> '' THEN
            IF ShippingAgent2.GET(Route."Shipping Agent Code") THEN
                IF NOT ShippingAgent2."Own Logistics FND" THEN BEGIN
                    ShippingAgent2."Own Logistics FND" := TRUE;
                    ShippingAgent2.MODIFY;
                END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Shipping Agent Services
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Ship. Agent Serv. Mand. APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::"Shipping Agent Services");
            ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value);
        END;

        //Check the default value for Driver
        IF Route."Driver Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::Driver107FDW);
            Driver.GET(UnitTestingValues.Value);
        END;

        //Check the default value for Truck
        IF Route."Vehicle Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::Vehicle101FDW);
            Truck.GET(UnitTestingValues.Value);
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.15<<
        //HEI.57>>
        //HEI.64>>
        //HEI.65>>
        IF COMPANYNAME = '10_SURIN_BROUWERIJ' THEN BEGIN
            EbfCombination.RESET;
            EbfCombination.SETCURRENTKEY("GL Account No.", "Dimension Code", "Dimension Value Code");
            EbfCombination.SETFILTER("Combination Restriction", '%1|%2', EbfCombination."Combination Restriction"::"Allowed with Warn", EbfCombination."Combination Restriction"::"Not Allowed");
            EbfCombination.MODIFYALL("Combination Restriction", 0);
        END;
        //HEI.65<<
        //HEI.64<<
        //HEI.57<<
        //Step 1: Login

        //Step 2,3,4: Search for Sales Return Orders page and access it
        SalesReturnOrderList.OPENEDIT;

        //Step 5: Return Order with Status = Released, Shipping Status = Invoice, Shipped Not Invoiced = No
        //Create a new Sales Return Order
        SalesReturnOrder.OPENNEW;
        SalesReturnOrderList.NEW;

        //AssitEdit to create the Document No. & Add Customer No.
        SalesReturnOrder."No.".ASSISTEDIT;
        SalesReturnOrder."Sell-to Customer Name".SETVALUE(Customer."No.");

        SalesReturnOrderNo := SalesReturnOrder."No.".VALUE;

        //Add Location, Route, Shipment Date and External Document No.
        SalesReturnOrder."Route 107FDW".SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesReturnOrder."Location Code".SETVALUE(Location.Code);
        SalesReturnOrder.ShipmentDateNew.SETVALUE(WORKDATE);
        SalesReturnOrder."External Document No.".SETVALUE('Unit Test OTC017');

        //Create Sales Return Line: No., Quantity
        SalesReturnOrder.SalesLines.NEW;
        SalesReturnOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesReturnOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesReturnOrder.SalesLines."Location Code".SETVALUE(Location.Code); //HEI.15
        SalesReturnOrder.SalesLines.Quantity.SETVALUE(2);

        //Select Return Reason Code
        SalesReturnOrder.SalesLines."Return Reason Code".SETVALUE(ReturnReason.Code);

        //Release the Sales Return Order
        SalesReturnOrder.Release.INVOKE;

        //Create Whse. Receipt
        WarehouseReceipt.TRAP;
        // SalesReturnOrder.Action122.INVOKE;//BC UPGRADE KUMARR78 Replacing Action122 With Action Button Name.
        SalesReturnOrder."Create &Whse. Receipt".INVOKE; //BC UPGRADE KUMARR78 Replacing Action122 With "Create &Whse. Receipt"

        //HEI.15>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            IF WarehouseReceipt."Shipping Agent Code 107FDW".VALUE = '' THEN
                WarehouseReceipt."Shipping Agent Code 107FDW".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            IF WarehouseReceipt."LOG Shipping Agent Service 107FDW".VALUE = '' THEN
                WarehouseReceipt."LOG Shipping Agent Service 107FDW".SETVALUE(ShippingAgentServices.Code);
        //HEI.15<<

        IF Route."Driver Mandatory APS" THEN
            IF WarehouseReceipt."Log Driver 107FDW".VALUE = '' THEN
                WarehouseReceipt."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            IF WarehouseReceipt."LOG Vehicle Code 107FDW".VALUE = '' THEN
                WarehouseReceipt."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Go to the Whse. Receipt Line
        //WarehouseReceipt.WhseReceiptLines.FIRST;

        //Add Zone and Bin
        //WarehouseReceipt.WhseReceiptLines."Zone Code".SETVALUE(Bin."Zone Code");
        //WarehouseReceipt.WhseReceiptLines."Bin Code".SETVALUE(Bin.Code);

        //Post Receipt
        WarehouseReceipt."Post Receipt".INVOKE;

        //Check if Status = Released, Shipping Status = Invoice, Shipped Not Invoiced = No
        SalesReturnOrder.Status.ASSERTEQUALS(1);
        // SalesReturnOrder."Shipment status".ASSERTEQUALS(6);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        //Shipped Not Invoiced is not visible on Page. Cannot be tested

        //Step 6,7: Post with option = Invoice
        SalesReturnOrder.Post.INVOKE;

        //Step 8: Credit Memo is posted
        SalesCrMemoHeader.SETRANGE("Return Order No.", SalesReturnOrderNo);
        SalesCrMemoHeader.FINDFIRST;

        //Step 9: Generate copy of Posted Sales Credit Memo
        REPORT.RUNMODAL(Report::"Credit Note STD", FALSE, FALSE, SalesCrMemoHeader);

        //HEI.04<<
    end;

