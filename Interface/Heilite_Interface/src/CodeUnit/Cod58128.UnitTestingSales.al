    [ModalPageHandler]
    procedure ApprovalEntriesModalPageHandler(var ApprovalEntries: TestPage "Approval Entries");
    var
        UserSetup: Record "User Setup";
        UserSetup2: Record "User Setup";
        ApprovalEntry: Record "Approval Entry";
        ApprovalEntry2: Record "Approval Entry";
    begin
        //HEI.09>>
        IF ApprovalEntries.FINDFIRSTFIELD(Status, 1) THEN BEGIN
            OpenApprovalEntry := TRUE;

            //Update Substitute for Approver ID = USERID
            //HEI.83>>
            //UserSetup.GET(ApprovalEntries."Approver ID".VALUE);
            ApprovalEntry.GET(ApprovalEntries."Entry No.".VALUE);
            ApprovalEntry2.SETCURRENTKEY("Table ID", "Record ID to Approve", Status);
            ApprovalEntry2.SETRANGE("Table ID", 18);
            ApprovalEntry2.SETRANGE("Record ID to Approve", ApprovalEntry."Record ID to Approve");
            ApprovalEntry2.SETRANGE(Status, ApprovalEntry.Status::Open);
            IF ApprovalEntry2.FINDSET(FALSE, FALSE) THEN
                REPEAT
                    UserSetup.GET(ApprovalEntry2."Approver ID");
                    //HEI.83<<
                    UserSetup.Substitute := USERID;
                    UserSetup.MODIFY;
                UNTIL ApprovalEntry2.NEXT = 0; //HEI.83

            //Update Approval Limit for USERID
            //BC UPGRADE KUMARR78 >> Blocking DIT Code
            // UserSetup2.GET(USERID);
            // IF NOT UserSetup2."Unlimited Sales Approval" OR NOT UserSetup2."Unlimited Cr. Limit Customer" OR
            //     NOT UserSetup2."Unlimited Deposit Limit Cust." OR NOT UserSetup2."Unlimited Overdue Approval"
            // THEN BEGIN
            //     UserSetup2."Unlimited Sales Approval" := TRUE;
            //     UserSetup2."Unlimited Cr. Limit Customer" := TRUE;
            //     UserSetup2."Unlimited Deposit Limit Cust." := TRUE;
            //     UserSetup2."Unlimited Overdue Approval" := TRUE;
            //     UserSetup2.MODIFY;
            // END;
            //BC UPGRADE KUMARR78 << Blocking DIT Code

            //Delegate Approval Request
            // ApprovalEntries.Action35.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
            ApprovalEntries."&Delegate".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

            ApprovalEntries.OK.INVOKE;
        END
        ELSE IF ApprovalEntries.FINDFIRSTFIELD(Status, 0) THEN
            ERROR(ApprovalEntries.Status.VALUE);
        //HEI.09<<
    end;

