    procedure RT_OTC018_CreateCustomerDebitOrCreditMemo_PricingCorrectionOrRecharge_IncorrectPrice_IncorrectDiscounts_Recharges();
    var
        GeneralLedgerSetup: Record "General Ledger Setup";
        Customer: Record Customer;
