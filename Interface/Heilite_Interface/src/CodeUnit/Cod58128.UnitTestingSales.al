            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;
        //HEI.22<<

        //MVMT Dim Insert//
        DefaulDimensions.SetRange("Table ID", DATABASE::Customer);
        DefaulDimensions.SetRange("No.", Customer."No.");
        DefaulDimensions.SETRANGE("Dimension Code", 'MVMT');
        IF not DefaulDimensions.FINDFIRST THEN BEGIN
            DefaulDimensions.INIT;
            DefaulDimensions."Table ID" := DATABASE::Customer;
            DefaulDimensions."No." := Customer."No.";
