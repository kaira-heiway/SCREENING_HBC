        GateEntryHeader: Record "Gate Entry Header FND";
        SalesOrder: TestPage "Sales Order";
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        Truck: Record Vehicle101FDW;
        Driver: Record Driver107FDW;
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        Location: Record Location;
        Bin: Record Bin;
        ItemTrackingCode: Record "Item Tracking Code";
        SalesReceivablesSetup: Record "Sales & Receivables Setup";
        Zone: Record Zone;
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        Workflow: Record Workflow;
        PostedSalesShipments: TestPage "Posted Sales Shipments";
        SalesOrderNo: Code[20];
        UpdateActualDeliveryDate: TestPage "Update Actual Delivery Date";
    begin
        ClearVariables('LOGNEW11'); //HEI.31
        //HEI.20>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW11', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        Customer.MODIFY;

        //Check the default value for Truck

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW11', COMPANYNAME, DATABASE::Vehicle101FDW);
        IF Truck.GET(UnitTestingValues.Value) THEN;

        //Check the default value for Driver
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW11', COMPANYNAME, DATABASE::Driver107FDW);
        IF Driver.GET(UnitTestingValues.Value) THEN;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW11', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW11', COMPANYNAME, DATABASE::"Shipping Agent Services");
        IF ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value) THEN;

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW11', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        IF Location."Sales Gate Entry Mandatory FND" THEN
            Location."Sales Gate Entry Mandatory FND" := FALSE;
        Location.MODIFY;

        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW11', COMPANYNAME, DATABASE::Zone);
        Zone.GET(Location.Code, UnitTestingValues.Value);
        IF Zone."Sales Gate Entry Mandatory FND" THEN
            Zone."Sales Gate Entry Mandatory FND" := FALSE;
        Zone.MODIFY;

        //Check default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW11', COMPANYNAME, DATABASE::Bin);
        Bin.GET(Location.Code, UnitTestingValues.Value);

        IF Location."Shipment Bin Code" <> Bin.Code THEN
            Location."Shipment Bin Code" := Bin.Code;
        Location.MODIFY;

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW11', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Strict Expiration Posting" THEN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW11', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);

        //HEI.36>>
        Route."shipping location" := Location.Code;
        Route."receipt location" := Location.Code;
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.36<<

        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        SalesReceivablesSetup.MODIFY;

        //Step 1: Login

        //Open Sales Order List Page
        SalesOrderList.OPENEDIT;

        //Create new Sales Order
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        //AssitEdit to create the Document No. & Add Customer No.
        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);

        //Add Route, Shipment Date and External Document No.
        SalesOrder."Location Code".SETVALUE(Location.Code);
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);
        SalesOrder."External Document No.".SETVALUE('Unit Test LOGNEW11');
        SalesOrderNo := SalesOrder."No.".VALUE;

        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38

        //Create Sales Line: No., Quantity, Backorder Type
        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        SalesOrder.SalesLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure");//Bc Upgrade VAMSIU01

        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;

        SalesOrder.Release.INVOKE;
        // BC UPGRADE PATELP08 >> added trap
        WarehouseShipment.TRAP;
        // BC UPGRADE PATELP08 <<
        //Create Warehouse Shipment
        // SalesOrder.Action149.INVOKE; //BC UPGRADE KUMARR78 Blocking As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder."Create &Warehouse Shipment".INVOKE; //BC UPGRADE KUMARR78 Adding As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"

        //Open Whse Shipment page //BC UPGRADE PATELP08 >> COMMENTED below 2 lines
        // WarehouseShipment.OPENVIEW;
        // WarehouseShipment.FILTER.SETFILTER("Source No. FND", SalesOrder."No.".VALUE);
        WarehouseShipment."Posting Date".SETVALUE(CALCDATE('<-1M>', WORKDATE)); // BC UPGRADE PATELP08 ADDED
        // WarehouseShipment.Action1100076703.INVOKE;//BC UPGRADE KUMARR78 DIT Action
        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke();//BC Upgrade VAMSIU01 Added

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseShipment."Shipping Agent Code".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseShipment."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Release Whse. Shipment
        // WarehouseShipment.Action45.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        WarehouseShipment."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //Post Whse. Shipment
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"
        SalesOrder.OK.INVOKE;

        //Open Posted Sales Shipment page
        PostedSalesShipments.OPENVIEW;
        PostedSalesShipments.FILTER.SETFILTER("Order No.", SalesOrderNo);
        PostedSalesShipments.First();// BC Upgrade PATELP08 position on filtered shipment before invoking the row action

        //Open 'Update Actual Delivery Date' page
        UpdateActualDeliveryDate.TRAP;
        // PostedSalesShipments."Page Update Actual Delivery Date".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        PostedSalesShipments."Update Actual Delivery Date".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //Add Actual Delivery Date
        // BC Upgrade PATELP08 >> page opens filtered to Posting Date = WORKDATE..WORKDATE (max 7-day window); shipment posted 1M back, so set start to its posting date -> page auto-sets end = start+7, loading the row
        UpdateActualDeliveryDate."Starting Date Filter".SETVALUE(CALCDATE('<-1M>', WORKDATE));// BC Upgrade PATELP08 matches whse shipment Posting Date; valid 7-day window
        UpdateActualDeliveryDate.FILTER.SETFILTER("Order No.", SalesOrderNo);// BC Upgrade PATELP08 narrow to the test order's shipment row
        UpdateActualDeliveryDate.First();// BC Upgrade PATELP08 position on the shipment row (else SETVALUE fails 'row does not exist')
        UpdateActualDeliveryDate."Actual Delivery Date".SETVALUE(WORKDATE);
        //HEI.20>>
    end;

    [Test]
    [HandlerFunctions('ConfirmationHandler,MessageHandler,ReverseTransactionModalPageHandler')]
    procedure OTC179_ReverseChequePostings();
    var
        Customer: Record Customer;
        CustomerPostingGroup: Record "Customer Posting Group";
        GenJournalTemplate: Record "Gen. Journal Template";
        GenJournalBatch: Record "Gen. Journal Batch";
        PaymentMethod: Record "Payment Method";
        GeneralJournalTemplates: TestPage "General Journal Templates";
        GeneralJournalBatches: TestPage "General Journal Batches";
        CashReceiptJournal: TestPage "Cash Receipt Journal";
        CustomerLedgerEntries: TestPage "Customer Ledger Entries";
        GeneralLedgerEntries: TestPage "General Ledger Entries";
        GenJournalLine: Record "Gen. Journal Line";
        Navigate: TestPage Navigate;
        DocumentNo: Code[20];
        GLAccount: Record "G/L Account";
    begin
        ClearVariables('OTC179'); //HEI.31
        //HEI.07>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC179', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.20>>
        //CustomerPostingGroup.GET(Customer."Gen. Bus. Posting Group");
        IF Customer."Application Method" = Customer."Application Method"::"Apply to Oldest" THEN BEGIN
            Customer."Application Method" := Customer."Application Method"::Manual;
            Customer.MODIFY;
        END;
        //HEI.20<<

        //Check default value for Journal Template
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC179', COMPANYNAME, DATABASE::"Gen. Journal Template");
        GenJournalTemplate.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF GenJournalTemplate."SO Cash Application FND" THEN BEGIN
            GenJournalTemplate."SO Cash Application FND" := FALSE;
            GenJournalTemplate.MODIFY;
        END;

        //Check default value for GL Account
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC179', COMPANYNAME, DATABASE::"G/L Account");
        GLAccount.GET(UnitTestingValues.Value);
        //HEI.20<<

        //Check default value for Journal Batch
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC179', COMPANYNAME, DATABASE::"Gen. Journal Batch");
        GenJournalBatch.GET(GenJournalTemplate.Name, UnitTestingValues.Value);

        //Check default value for Payment Method
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC179', COMPANYNAME, DATABASE::"Payment Method");
        PaymentMethod.GET(UnitTestingValues.Value);

        //HEI.31>>
        //Update Payment Method Code on Customer
        Customer."Payment Method Code" := PaymentMethod.Code;
        Customer.MODIFY;
        //HEI.31<<

        //Disable Gen. Journal Batch Approval Workflow
        //HEI.79>>
        DisableGenJournalBatchApprovalWorkflow(GenJournalBatch);
        //HEI.79<<

        //Step 1: Login

        //Create and Post Cash Receipt Journal
        //Access Cash Receipt Journal
        GeneralJournalTemplates.OPENVIEW;
        GeneralJournalBatches.TRAP;
        //HEI.20>>
        //GeneralJournalTemplates.FINDFIRSTFIELD(Name,GenJournalTemplate.Name);
        GeneralJournalTemplates.FILTER.SETFILTER(Name, GenJournalTemplate.Name);
        //HEI.20<<

        // GeneralJournalTemplates."Page General Journal Batches".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GeneralJournalTemplates."Batches".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        CashReceiptJournal.TRAP;
        //HEI.20>>
        //GeneralJournalBatches.FINDFIRSTFIELD(Name,GenJournalBatch.Name);
        GeneralJournalBatches.FILTER.SETFILTER(Name, GenJournalBatch.Name);
        //HEI.20<<
        GeneralJournalBatches.EditJournal.INVOKE;

        //Remove existing lines in Journal to avoid errors
        GenJournalLine.SETRANGE("Journal Template Name", GenJournalTemplate.Name);
        GenJournalLine.SETRANGE("Journal Batch Name", GenJournalBatch.Name);
        IF GenJournalLine.FINDSET THEN //HEI.20
            GenJournalLine.DELETEALL;

        //Create Journal Line
        CashReceiptJournal.NEW;
        CashReceiptJournal."Document Type".SETVALUE(1);
        //HEI.20>>
        IF CashReceiptJournal."Document No.".VALUE = '' THEN
            CashReceiptJournal."Document No.".SETVALUE('OTC179');

        CashReceiptJournal."External Document No.".SETVALUE('OTC179');
        IF GenJournalBatch."Bal. Account No." = '' THEN BEGIN
            CashReceiptJournal."Bal. Account Type".SETVALUE(0);
            CashReceiptJournal."Bal. Account No.".SETVALUE(GLAccount."No.");
        END;
        //HEI.20<<
        CashReceiptJournal."Account Type".SETVALUE(1);
        CashReceiptJournal."Account No.".SETVALUE(Customer."No.");
        CashReceiptJournal.Amount.SETVALUE(-100);
        //CashReceiptJournal."Payment Method Code".SETVALUE(PaymentMethod.Code); //HEI.31

        DocumentNo := CashReceiptJournal."Document No.".VALUE;

        //Post
        CashReceiptJournal.Post.INVOKE;

        //Step 2,3,4: Access Customer Ledger Entries
        CustomerLedgerEntries.OPENVIEW;

        //Step 5: Filter on Customer No, Document No, Document Type (Payment)
        //HEI.20>>
        //CustomerLedgerEntries.FINDFIRSTFIELD("Customer No.",Customer."No.");
        //CustomerLedgerEntries.FINDFIRSTFIELD("Document Type",1);
        //CustomerLedgerEntries.FINDFIRSTFIELD("Document No.",DocumentNo);
        CustomerLedgerEntries.FILTER.SETFILTER("Customer No.", Customer."No.");
        CustomerLedgerEntries.FILTER.SETFILTER("Document Type", '1');
        CustomerLedgerEntries.FILTER.SETFILTER("Document No.", DocumentNo);
        //HEI.20<<

        //Step 6: Reverse transaction
        CustomerLedgerEntries.ReverseTransaction.INVOKE;
        CustomerLedgerEntries.OK.INVOKE;
        //HEI.07<<
    end;

