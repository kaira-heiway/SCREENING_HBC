    procedure OTC029_CreateSundryCreditMemoAndSundryCreditNote();
    var
        Customer: Record Customer;
        Resource: Record Resource;
        Location: Record Location;
        // DocumentSubtypeCode: Record "2014472";//BC UPGRADE KUMARR78 Blocking DIT variable
        DocumentSubtypeCode: Record "Document Subtype Code FND"; // BC Upgrade PATELP08
        SalesCrMemoHeader: Record "Sales Cr.Memo Header";
        SalesCreditMemos: TestPage "Sales Credit Memos";
        SalesCreditMemo: TestPage "Sales Credit Memo";
        PostedSalesCreditMemo: TestPage 134;
        SalesCreditMemoNo: Code[20];
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        GeneralLedgerSetup: Record "General Ledger Setup";
        GeneralPostingSetup: Record "General Posting Setup";
        BillToCustomer: Record Customer;
        DefaultDimension: Record "Default Dimension";
        SalesHeader: Record "Sales Header";
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        Workflow: Record Workflow;
        EBMSInterfaceSetup: Record "EBMS Interface Setup INT";
    begin
        ClearVariables('OTC029'); //HEI.31
        //HEI.04>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC029', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);

        //Check default value for Resource
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC029', COMPANYNAME, DATABASE::Resource);
        Resource.GET(UnitTestingValues.Value);

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC029', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);

        //Check default value for Document Subtype
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // UnitTestingValues.RESET;
        // UnitTestingValues.GET('OTC029', COMPANYNAME, DATABASE::"Document Subtype Code");
        // DocumentSubtypeCode.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.17>>
        //Check default value for CCC Dimension Value
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC029', COMPANYNAME, DATABASE::"Dimension Value");
        GeneralLedgerSetup.GET;
        IF DimensionValue.GET(GeneralLedgerSetup."Cost Center Dimension Code FND", UnitTestingValues.Value) THEN;
        //HEI.38>>
        IF Customer."Bill-to Customer No." <> '' THEN
            BillToCustomer.GET(Customer."Bill-to Customer No.")
        ELSE
            BillToCustomer.GET(Customer."No.");

        GeneralPostingSetup.GET(BillToCustomer."Gen. Bus. Posting Group", Resource."Gen. Prod. Posting Group");
        IF DefaultDimension.GET(15, GeneralPostingSetup."Sales Credit Memo Account", GeneralLedgerSetup."Cost Center Dimension Code FND") THEN
            IF (DefaultDimension."Value Posting" = DefaultDimension."Value Posting"::"Same Code") AND
               (DefaultDimension."Dimension Value Code" <> '')
            THEN
                DimensionValue.GET(GeneralLedgerSetup."Cost Center Dimension Code FND", DefaultDimension."Dimension Value Code");
        //HEI.38<<
        IF DimensionValue2.GET(GeneralLedgerSetup."Brand Dimension Code FND", UnitTestingValues."Value 2") THEN;
        IF DimensionValue3.GET(GeneralLedgerSetup."SKU Dimension Code FND", UnitTestingValues."Value 3") THEN;

        DimensionValue4.SETRANGE("Dimension Code", 'INV_LEV');
        DimensionValue4.SETRANGE(Blocked, FALSE);
        IF DimensionValue4.FINDFIRST THEN;
        //HEI.17<<

        //HEI.73>>
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Enable EBMS Interface FND" THEN BEGIN
            SalesReceivablesSetup."Enable EBMS Interface FND" := FALSE;
            SalesReceivablesSetup.MODIFY;
        END;
        IF EBMSInterfaceSetup.GET THEN BEGIN
            EBMSInterfaceSetup."EBMS Interface Enabled" := FALSE;
            EBMSInterfaceSetup.MODIFY;
        END;
        //HEI.73<<

        //Step 1: Login

        //Step 2,3,4: Open Sales Credit Memos
        SalesCreditMemos.OPENVIEW;

        //Step 5: Create Sales Credit Memo
        SalesCreditMemo.OPENNEW;
        SalesCreditMemo.NEW;

        //Step 6: Add Customer No. and create new line
        SalesCreditMemo."Sell-to Customer Name".SETVALUE(Customer."No.");
        SalesCreditMemo."Location Code".SETVALUE(Location.Code);

        SalesCreditMemo.SalesLines.NEW;
        SalesCreditMemo.SalesLines.Type.SETVALUE(Type::Resource);
        SalesCreditMemo.SalesLines."No.".SETVALUE(Resource."No.");
        SalesCreditMemo.SalesLines.Quantity.SETVALUE(1);
        SalesCreditMemo.SalesLines."Unit Price".SETVALUE(100);

        //Add CCC Dimension
        // SalesCreditMemo.SalesLines.Action1902740304.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        SalesCreditMemo.SalesLines.Dimensions.INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //Step 7: Add Document Subtype Code = SO2
        // SalesCreditMemo."Document Subtype Code".SETVALUE(DocumentSubtypeCode.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesCreditMemoNo := SalesCreditMemo."No.".VALUE;
        //HEI.57>>
        //Disable Workflows before Release
        CLEAR(SalesHeader);
        SalesHeader.GET(SalesHeader."Document Type"::"Credit Memo", SalesCreditMemo."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;
        //HEI.57>>
        //Step 8: Release
        SalesCreditMemo.Release.INVOKE;

        //Step 10: Post
        SalesCreditMemo.Post.INVOKE;

        //Step 11: View Posted Credit Memo
        SalesCrMemoHeader.SETRANGE("Pre-Assigned No.", SalesCreditMemoNo);
        SalesCrMemoHeader.FINDFIRST;

        PostedSalesCreditMemo.OPENVIEW;
        //HEI.17>>
        //PostedSalesCreditMemo.GOTORECORD(SalesCrMemoHeader);
        PostedSalesCreditMemo.FILTER.SETFILTER("No.", SalesCrMemoHeader."No.");
        //HEI.17<<

        //Check Document Subtype Code
        // PostedSalesCreditMemo."Document Subtype Code".ASSERTEQUALS(DocumentSubtypeCode.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
    end;

