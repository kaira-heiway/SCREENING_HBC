        //Check if Reminder was created for the Invoice posted
        Reminder.OPENVIEW;
        //HEI.22>>
        //Reminder.FINDFIRSTFIELD("Customer No.",Customer."No.");
        //Reminder.FINDFIRSTFIELD("Posting Date",WORKDATE);
        Reminder.FILTER.SETFILTER("Customer No.", BillToCustomer."No.");
        //      Reminder.FILTER.SETFILTER("Posting Date", FORMAT(WORKDATE));
        //HEI.22<<
        DocNo := Reminder."No.".VALUE;

        //HEI.22>>
        //Reminder.ReminderLines.FINDFIRSTFIELD(Type,2);
        //Reminder.ReminderLines.FINDFIRSTFIELD("Document Type",2);
        //Reminder.ReminderLines.FINDFIRSTFIELD("Document No.",SalesInvoiceHeader."No.");
        Reminder.ReminderLines.FILTER.SETFILTER(Type, '2');
        Reminder.ReminderLines.FILTER.SETFILTER("Document Type", '2');
