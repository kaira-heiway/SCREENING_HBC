                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;
        //HEI.33>>

        //Step 1: Login

        //Step 2 - "In the Search box, enter Sales Orders
        SalesOrderList.OPENEDIT;

        //Step 3 - On Home Tab, select New
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        //Step 4 - "On General FastTab, in Customer field press tab to generate sales
        //order number. In this field select a customer number or type the name for Account group Y008 as Employees
        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);

        //Steps 5 - "On General FastTab, in Route field select one or validate it in case that
        //was already assigned in Customer Card of defaulted."
        SalesOrder."Location Code".SETVALUE(Location.Code);
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED

        //Steps 6 - "On General FastTab, select delivery date in Shipment Date field."
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);
        //Steps 7 - "(Optional Step) On General FastTab in External Document No. field, you can add notes for the Invoice such as Customer PO."
        //SalesOrder."External Document No.".SETVALUE('Unit Test SLSNEW1_' + SalesOrder."No.".VALUE);  //HEI.33
        SalesOrder."External Document No.".SETVALUE('SLSNEW1_' + SalesOrder."No.".VALUE);  //HEI.33

        //Steps 8 - Create Sales Line: No., Free Reason Code
        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        //SalesOrder.SalesLines."Free Reason Code".SETVALUE(FreeReasonCode.Code); //HEI.31

        //Step 9 - Expand the lines
        SalesOrder.SalesLines.EXPAND(TRUE);

        //Step 10 - Availabilty Check
        // IF SalesOrder."Sales Line FactBox"."Item Availability".ASDECIMAL > 0 THEN;//BC UPGRADE KUMARR78 >> Blocking DIT Code

        //Step 11 - Credit Limit and Overdue Limit Check
        // IF SalesOrder."Customer Details FactBox"."Credit Limit (LCY)".ASDECIMAL = Customer."Credit Limit (LCY)" THEN;//BC UPGRADE KUMARR78 >> Blocking DIT Code
        //HEI.30>>
    end;

