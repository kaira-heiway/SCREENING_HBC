    procedure RT_OTC022_IssueCustomerBonusCreditMemo_3rdPartyBonusCalculation();
    var
        GeneralLedgerSetup: Record "General Ledger Setup";
        Customer: Record Customer;
        ItemCharge: Record "Item Charge";
        Location: Record Location;
        // DocumentSubtypeCode: Record "2014472";//BC UPGRADE KUMARR78 Blocking DIT Variable.
        DocumentSubtypeCode: Record "Document Subtype Code FND"; // BC Upgrade PATELP08
        SalesLine: Record "Sales Line";
        SalesCreditMemos: TestPage "Sales Credit Memos";
        SalesCreditMemo: TestPage "Sales Credit Memo";
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        SalesHeader: Record "Sales Header";
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        Workflow: Record Workflow;
        EBMSInterfaceSetup: Record "EBMS Interface Setup INT";
    begin
        ClearVariables('OTC022'); //HEI.31
        //HEI.04>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC022', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.15>>
        CustomerNoFilter := Customer."Bill-to Customer No.";
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Customer."Purchasing Code" <> '' THEN
        //     Customer."Purchasing Code" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF NOT Customer."Additional RPM Return FND" THEN
            Customer."Additional RPM Return FND" := TRUE;
        Customer.MODIFY;
        //HEI.15<<

        //HEI.73>>
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Enable EBMS Interface FND" THEN BEGIN
            SalesReceivablesSetup."Enable EBMS Interface FND" := FALSE;
            SalesReceivablesSetup.MODIFY;
        END;
        IF EBMSInterfaceSetup.GET THEN BEGIN
            EBMSInterfaceSetup."EBMS Interface Enabled" := FALSE;
            EBMSInterfaceSetup.MODIFY;
        END;
        //HEI.73<<

        //Check default value for Item Charge
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC022', COMPANYNAME, DATABASE::"Item Charge");
        ItemCharge.GET(UnitTestingValues.Value);
        ItemChargeNo := ItemCharge."No."; //HEI.15

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC022', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);

        //Check default value for Trading Partner and SKU Dimension Values Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC022', COMPANYNAME, DATABASE::"Dimension Value");
        GeneralLedgerSetup.GET;
        DimensionValue.GET(GeneralLedgerSetup."Shortcut Dimension 7 Code", UnitTestingValues.Value);
        DimensionValue2.GET(GeneralLedgerSetup."SKU Dimension Code FND", UnitTestingValues."Value 2");
        DimensionValue3.GET(GeneralLedgerSetup."Cost Center Dimension Code FND", UnitTestingValues."Value 3");

        DimensionValue4.RESET;  //HEI.69
        DimensionValue4.SETRANGE("Dimension Code", 'INV_LEV');
        DimensionValue4.SETRANGE(Blocked, FALSE);
        IF DimensionValue4.FINDFIRST THEN;

        //Check default value for Document Subtype
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC022', COMPANYNAME, DATABASE::"Document Subtype Code FND");
        DocumentSubtypeCode.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Step 1: Login

        //Step 2,3,4: Search for Sales Credit Memo page and access it
        // SalesCreditMemos.OPENVIEW; //HEI.69

        //Step 5: Create new Sales Cr Memo
        SalesCreditMemo.OPENNEW;
        // SalesCreditMemo.NEW;

        //Step 6: Add Customer No. to create the Sales Credit Memo document
        SalesCreditMemo."Sell-to Customer Name".SETVALUE(Customer."No.");
        SalesCreditMemo."Location Code".SETVALUE(Location.Code);

        //Create new line
        SalesCreditMemo.SalesLines.NEW;

        //Select Type = Charge (Item)"
        SalesCreditMemo.SalesLines.Type.SETVALUE(Type::"Charge (Item)");

        //Add Item Charge No
        SalesCreditMemo.SalesLines."No.".SETVALUE(ItemCharge."No.");

        //Add Quantity = 1
        SalesCreditMemo.SalesLines.Quantity.SETVALUE(1);

        //Add Unit Price Excl VAT
        SalesCreditMemo.SalesLines."Unit Price".SETVALUE(10);
        //Check default value for Trading Partner and SKU Dimension Values Code

        //Add Trading Partner Dimension
        // SalesCreditMemo.SalesLines.Action1902740304.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        SalesCreditMemo.SalesLines.Dimensions.INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name


        //Step 7: Add Document Subtype Code = BC1
        SalesCreditMemo."Document Subtype Code".SETVALUE(DocumentSubtypeCode.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code

        //Step 8: Item Charge Assignment
        // SalesCreditMemo.SalesLines.Action1907184504.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        SalesCreditMemo.SalesLines."Item Charge &Assignment".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::"Credit Memo", SalesCreditMemo."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            //HEI.69>>
            Workflow.RESET;
            Workflow.SETCURRENTKEY(Enabled);
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET(TRUE) THEN
                //HEI.69<<
                //    REPEAT
                //      Workflow.Enabled := FALSE;
                //      Workflow.MODIFY;
                //    UNTIL Workflow.NEXT = 0;
                Workflow.MODIFYALL(Enabled, FALSE);  //HEI.69
        END;

        //Release
        SalesCreditMemo.Release.INVOKE;

        //Post
        SalesCreditMemo.Post.INVOKE;

        //HEI.04<<
    end;

