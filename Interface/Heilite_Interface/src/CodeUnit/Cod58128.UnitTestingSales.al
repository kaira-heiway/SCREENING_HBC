            REPEAT
                ReminderLevel."Additional Fee (LCY)" := 0;
                ReminderLevel.MODIFY;
            UNTIL ReminderLevel.NEXT = 0
        ELSE BEGIN
            ReminderLevel.SETFILTER("Add. Fee per Line Amount (LCY)", '>%1', 0);
            IF ReminderLevel.FINDFIRST THEN
                REPEAT
                    ReminderLevel."Add. Fee per Line Amount (LCY)" := 0;
                    ReminderLevel.MODIFY;
                UNTIL ReminderLevel.NEXT = 0;
        END;

