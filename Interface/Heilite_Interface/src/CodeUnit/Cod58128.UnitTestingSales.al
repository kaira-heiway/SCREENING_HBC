            Truck.INSERT;
        END ELSE
            IF Truck."Status FND" <> Truck."Status FND"::Open THEN BEGIN
                Truck."Status FND" := Truck."Status FND"::Open;
                Truck.MODIFY;
            END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //BC UPGRADE KUMARR78 << Unblocking 01-06-2026


        //Check the default value for Driver

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG078', COMPANYNAME, DATABASE::Driver107FDW);
        IF NOT Driver.GET(UnitTestingValues.Value) THEN BEGIN
            Driver.INIT;
            Driver.Code := 'LOG078';
            Driver.INSERT;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG078', COMPANYNAME, DATABASE::Zone);
        Zone.GET(TransferFromLocation.Code, UnitTestingValues.Value);
        IF NOT Zone."Transf.Gate EntryMandatory FND" THEN BEGIN
            Zone."Transf.Gate EntryMandatory FND" := TRUE;
            Zone.MODIFY;
        END;

        //Check the default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG078', COMPANYNAME, DATABASE::Bin);
        Bin.GET(TransferFromLocation.Code, UnitTestingValues.Value);

        IF TransferFromLocation."Shipment Bin Code" <> Bin.Code THEN BEGIN
            TransferFromLocation."Shipment Bin Code" := Bin.Code;
            TransferFromLocation.MODIFY;
        END;

        IF (TransferToLocation."Receipt Bin Code" = '') OR
           (TransferToLocation."Receipt Bin Code" <> Bin.Code)
        THEN BEGIN
            Bin2.SETRANGE("Location Code", TransferToLocation.Code);
            IF Bin2.FINDSET THEN BEGIN
                Zone2.SETRANGE("Location Code", TransferToLocation.Code);
                Zone2.SETRANGE(Code, Bin2."Zone Code");
                IF Zone2.FINDFIRST THEN BEGIN
                    IF Zone2."Use As In-Transit FND" THEN
                        Zone2."Use As In-Transit FND" := FALSE;
                    IF Zone2."Default Receipt Bin Code FND" <> Bin2.Code THEN
                        Zone2."Default Receipt Bin Code FND" := Bin2.Code;
                    IF Zone2."Transf.Gate EntryMandatory FND" THEN
                        Zone2."Transf.Gate EntryMandatory FND" := FALSE;
                    Zone2.MODIFY;
                END;
                TransferToLocation."Receipt Bin Code" := Bin2.Code;
                TransferToLocation.MODIFY;
            END;
        END;

        BinContent.SETRANGE("Location Code", TransferFromLocation.Code);
        BinContent.SETRANGE("Item No.", Item."No.");
        BinContent.SETRANGE(Default, TRUE);
        IF BinContent.FINDFIRST THEN BEGIN
            IF BinContent."Bin Code" <> Bin.Code THEN
                BinContent.Default := FALSE;
            BinContent.MODIFY;
        END;

        BinContent2.SETRANGE("Location Code", TransferFromLocation.Code);
        BinContent2.SETRANGE("Item No.", Item."No.");
        BinContent2.SETRANGE("Bin Code", Bin.Code);
        BinContent2.FINDFIRST;
        BinContent2.Default := TRUE;
        BinContent2.MODIFY;

        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Strict Expiration Posting" THEN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;

        //Add Default Location for UserID
        WarehouseEmployee.SETRANGE("User ID", USERID);
        WarehouseEmployee.SETRANGE("Location Code", TransferFromLocation.Code);
        // WarehouseEmployee.SETRANGE("Zone Code FND", Zone.Code);//BC UPGRADE KUMARR78--
        WarehouseEmployee.SETRANGE("Zone Code", Zone.Code);//BC UPGRADE KUMARR78++

        IF WarehouseEmployee.FINDFIRST THEN BEGIN
            IF NOT WarehouseEmployee.Default THEN BEGIN
                WarehouseEmployee.Default := TRUE;
                WarehouseEmployee.MODIFY;
            END;
        END ELSE BEGIN
            WarehouseEmployee.INIT;
            WarehouseEmployee."User ID" := USERID;
            WarehouseEmployee."Location Code" := TransferFromLocation.Code;
            // WarehouseEmployee."Zone Code FND" := Zone.Code;//BC UPGRADE KUMARR78--
            WarehouseEmployee."Zone Code" := Zone.Code;//BC UPGRADE KUMARR78++

            WarehouseEmployee.Default := TRUE;
            WarehouseEmployee.INSERT;
        END;
        //HEI.20<<

        //HEI.23>>
        //Check default value for Gate Entry No. Series
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG078', COMPANYNAME, DATABASE::"No. Series");
        NoSeries.GET(UnitTestingValues.Value);
        IF NOT NoSeries."Manual Nos." THEN BEGIN
            NoSeries."Manual Nos." := TRUE;
            NoSeries.MODIFY;
        END;

        //Add Gate Entry No. Series
        WarehouseSetup.GET;
        IF WarehouseSetup."Gate Entry Nos. FND" = '' THEN
            WarehouseSetup."Gate Entry Nos. FND" := NoSeries.Code;
        IF NOT WarehouseSetup."Allow Collect Lines FND" THEN
            WarehouseSetup."Allow Collect Lines FND" := TRUE;
        WarehouseSetup.MODIFY;
        //HEI.23<<

        //Step 1 - Required Setup: Either in Location on in Zone "Transfer Gate Entry Mandatory" boolean is checked
        TransferFromLocation.TESTFIELD("Transfer Gate Entry Mandat FND", TRUE);

        //Step 2 - Create a Transfer Order with complete information
        TransferList.OPENEDIT;
        TransferOrder.OPENNEW;
        TransferOrder.NEW;
        TransferOrder."No.".ASSISTEDIT;
        TransferOrder."Transfer-from Code".SETVALUE(TransferFromLocation.Code);
        TransferOrder."Transfer-to Code".SETVALUE(TransferToLocation.Code);
        TransferOrder."In-Transit Code".SETVALUE(InTransitLocation.Code);
        TransferOrder."Shipping Agent Code".SETVALUE(ShippingAgent.Code);
        TransferOrder."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        TransferOrder.TransferLines.NEW;
        TransferOrder.TransferLines."Item No.".SETVALUE(Item."No.");
        TransferOrder.TransferLines.Quantity.SETVALUE(1);
        TransferOrder.TransferLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure");//BC Upgrade KUMARR78 08-06-2026++

        //Step 3 - Release the Order
        // TransferOrder."Codeunit Release Transfer Document".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        TransferOrder."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //Auto-FEFO
        // TransferOrder.Action1111000002.INVOKE;//BC UPGRADE KUMARR78 DIT Action

        //Step 4 - Create Warehouse Shipment
        WarehouseShipment.TRAP;
        // TransferOrder.Action5778.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        TransferOrder."Create Whse. S&hipment".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name


        // WarehouseShipment.Action1100076703.INVOKE; //Auto FEFO//BC UPGRADE KUMARR78 DIT Action
        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke(); //BC UPGRADE KUMARR78 01-06-2026


        //HEI.20>>
        //--Take Driver, Truck from Unit Testing Values
        //IF WarehouseShipment."Truck Code".VALUE = '' THEN BEGIN
        //Truck.SETRANGE(Status,Truck.Status::Open);
        //Truck.FINDFIRST;
        //WarehouseShipment."Truck Code".SETVALUE(Truck.Code);
        //END;
        //IF WarehouseShipment."Driver Code".VALUE = '' THEN BEGIN
        //Driver.FINDFIRST;
        //WarehouseShipment."Driver Code".SETVALUE(Driver.Code);
        //END;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Driver.Code <> '' THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Truck.Code <> '' THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        // BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.20<<

        //Release Whse. Shipment
        // WarehouseShipment.Action45.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        WarehouseShipment."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //Step 5 - Create Gate entry document from warehouse shipment
        //HEI.20>>
        IF NOT GateEntryHeader.FINDLAST THEN BEGIN
            GateEntryHeader.INIT;
            GateEntryHeader."Gate Entry Document No." := 'LOG078';
            GateEntryHeader.INSERT;
        END;
        //HEI.20<<
        WarehouseShipment.CreateGateEntryOutbound.INVOKE;

        //Step 6 - Post Whse. Shipment
        // -if  we post the Whse Ship now, we cannot modify the Gate Entry Document.

        //Step 7-22 are in function GateEntryOutbound_ModalPageHandler
        GateEntryOutbound.OPENVIEW;
        GateEntryOutbound.FILTER.SETFILTER("Gate Entry Document No.", WarehouseShipment."Gate Entry No.".VALUE);
        // GateEntryOutbound.Action55001.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        GateEntryOutbound.Register.INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //BC Upgrade KUMARR78 >> Remove any blank-"Item No." transfer line before posting. The Aptean IntlInventoryHook101FDW runs on every Transfer Shipment Line during posting and does Item.GET("Item No.") with NO blank guard, throwing "The Item does not exist. No.=''". A blank (description/phantom) transfer line produces no whse-shipment line but is still posted by TransferOrder-Post Shipment, feeding the unguarded hook. The real item line (with assigned lot) is kept.
        TransferLine.RESET;
        TransferLine.SETRANGE("Document No.", TransferOrder."No.".VALUE);
        TransferLine.SETRANGE("Item No.", '');
        IF NOT TransferLine.ISEMPTY THEN
            TransferLine.DELETEALL(FALSE);
        //BC Upgrade KUMARR78 <<
        //Step 6 - Post Whse. Shipment
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"
        //HEI.08>>
    end;

    [Test]
    [HandlerFunctions('NoSeriesListModalPageHandler,MessageHandler,ConfirmationHandler,ShipInvoiceStrMenuHandler,ItemTrackingLinesModalPageHandler')]//BC Upgrade KUMARR78 added ItemTrackingLinesModalPageHandler
    procedure LOG079_InboundProcessTransferOrder();
    var
        TransferFromLocation: Record Location;
        TransferToLocation: Record Location;
        InTransitLocation: Record Location;
        Item: Record Item;
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        TransferList: TestPage "Transfer Orders";
        TransferOrder: TestPage "Transfer Order";
        WarehouseReceipt: TestPage "Warehouse Receipt";
        WarehouseShipment: TestPage "Warehouse Shipment";
        GateEntryOutbound: TestPage "Gate Entry Outbound";
        GateEntryInbound: TestPage "Gate Entry Inbound";
        GateEntryInboundList: TestPage "Gate Entry Inbound List";
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        Driver: Record Driver107FDW;
        Truck: Record Vehicle101FDW;
        GateEntry_DocumentType: Option " ","Purchase Order","Transfer Order","Sales Return Order","Warehouse Receipt","Sales Order","Purchase Return Order","Warehouse Shipment";
        Type: Option " ",Item,"Fixed Asset","Service Item";
        GateEntryNo: Code[20];
        Zone: Record Zone;
        Zone2: Record Zone;
        Bin: Record Bin;
        Bin2: Record Bin;
        BinContent: Record "Bin Content";
        BinContent2: Record "Bin Content";
        ItemTrackingCode: Record "Item Tracking Code";
        SalesReceivablesSetup: Record "Sales & Receivables Setup";
        WarehouseSetup: Record "Warehouse Setup";
        NoSeries: Record "No. Series";
        GateEntryHeader: Record "Gate Entry Header FND";
        // WarehouseEmployee: Record "Warehouse Employee";
        WarehouseEmployee: Record "Warehouse Employee_DTW FND";//BC UPGRADE KUMARR78++

        InventoryPostingSetup: Record "Inventory Posting Setup";
        InventoryPostingSetup2: Record "Inventory Posting Setup";

        //BC UPGRADE KUMARR78 <<
        WarehouseEntry: Record "Warehouse Entry";
        WarehouseEntry2: Record "Warehouse Entry";
        TransferLine: Record "Transfer Line";
        LotNoInformation: Record "Lot No. Information";
        BestLotNo: Code[50];
        BestQtyBase: Decimal;
        BestLot: Code[50];
    //BC UPGRADE KUMARR78 >>


    begin
        ClearVariables('LOG079'); //HEI.31
        //HEI.08<<
        //Check default value for Transfer-from Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG079', COMPANYNAME, DATABASE::Location);
        TransferFromLocation.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF TransferFromLocation."Transfer Gate Entry Mandat FND" THEN
            TransferFromLocation."Transfer Gate Entry Mandat FND" := FALSE;
        IF TransferFromLocation."Zone Mandatory FND" THEN
            TransferFromLocation."Zone Mandatory FND" := FALSE;
        TransferFromLocation.MODIFY;
        //HEI.20<<

        //Check default value for Transfer-to Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG079', COMPANYNAME, DATABASE::Location);
        TransferToLocation.GET(UnitTestingValues."Value 2");
        //HEI.20>>
        IF NOT TransferToLocation."Transfer Gate Entry Mandat FND" THEN
            TransferToLocation."Transfer Gate Entry Mandat FND" := TRUE;
        IF TransferToLocation."Zone Mandatory FND" THEN
            TransferToLocation."Zone Mandatory FND" := FALSE;
        TransferToLocation.MODIFY;
        //HEI.20<<

        //Check default value for In-Transit Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG079', COMPANYNAME, DATABASE::Location);
        InTransitLocation.GET(UnitTestingValues."Value 3");
        //HEI.20>>
        IF InTransitLocation."Zone Mandatory FND" THEN
            InTransitLocation."Zone Mandatory FND" := FALSE;
        InTransitLocation.MODIFY;
        //HEI.20<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG079', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //HEI.51>>
        IF InventoryPostingSetup.GET(TransferFromLocation.Code, Item."Inventory Posting Group") THEN BEGIN
            //HEI.58>>
            IF InventoryPostingSetup."Inventory Account" <> '' THEN BEGIN
                InventoryPostingSetup2.GET(InTransitLocation.Code, Item."Inventory Posting Group");
                IF InventoryPostingSetup2."Inventory Account" = '' THEN
                    InventoryPostingSetup2."Inventory Account" := InventoryPostingSetup."Inventory Account";
                InventoryPostingSetup2.MODIFY;
            END ELSE BEGIN
                InventoryPostingSetup2.RESET;
                InventoryPostingSetup2.SETFILTER("Inventory Account", '<>%1', '');
                IF InventoryPostingSetup2.FINDFIRST THEN
                    InventoryPostingSetup.MODIFYALL("Inventory Account", InventoryPostingSetup2."Inventory Account");
            END;
        END;
        IF InventoryPostingSetup.GET(TransferToLocation.Code, Item."Inventory Posting Group") THEN BEGIN
            IF InventoryPostingSetup."Inventory Account" <> '' THEN BEGIN
                InventoryPostingSetup2.GET(InTransitLocation.Code, Item."Inventory Posting Group");
                IF InventoryPostingSetup2."Inventory Account" = '' THEN
                    InventoryPostingSetup2."Inventory Account" := InventoryPostingSetup."Inventory Account";
                InventoryPostingSetup2.MODIFY;
            END ELSE BEGIN
                InventoryPostingSetup2.RESET;
                InventoryPostingSetup2.SETFILTER("Inventory Account", '<>%1', '');
                IF InventoryPostingSetup2.FINDFIRST THEN
                    InventoryPostingSetup.MODIFYALL("Inventory Account", InventoryPostingSetup2."Inventory Account");
            END;
            //HEI.58<<
        END;
        //HEI.51<<

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG079', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // UnitTestingValues.RESET;
        // UnitTestingValues.GET('LOG079', COMPANYNAME, DATABASE::"Shipping Agent Services");
        // //HEI.20>>
        // //ShippingAgentServices.GET(ShippingAgent.Code,UnitTestingValues.Value);
        // IF ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value) THEN
        //     IF ShippingAgentServices."Allow Shipping Cost Per" <> ShippingAgentServices."Allow Shipping Cost Per"::" " THEN BEGIN
        //         ShippingAgentServices."Allow Shipping Cost Per" := ShippingAgentServices."Allow Shipping Cost Per"::" ";
        //         ShippingAgentServices.MODIFY;
        //     END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Truck
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG079', COMPANYNAME, DATABASE::Vehicle101FDW);
        IF NOT Truck.GET(UnitTestingValues.Value) THEN BEGIN
            Truck.INIT;
            Truck.Code := 'LOG079';
            Truck.INSERT;
            //BC UPGRADE KUMARR78 << 01-06-2026
        END ELSE
            IF Truck."Status FND" <> Truck."Status FND"::Open THEN BEGIN
                Truck."Status FND" := Truck."Status FND"::Open;
                Truck.MODIFY;
                //BC UPGRADE KUMARR78 << 01-06-2026

            END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Driver

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG079', COMPANYNAME, DATABASE::Driver107FDW);
        IF NOT Driver.GET(UnitTestingValues.Value) THEN BEGIN
            Driver.INIT;
            Driver.Code := 'LOG079';
            Driver.INSERT;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG079', COMPANYNAME, DATABASE::Zone);
        Zone.GET(TransferFromLocation.Code, UnitTestingValues.Value);
        IF Zone."Transf.Gate EntryMandatory FND" THEN
            Zone."Transf.Gate EntryMandatory FND" := FALSE;
        IF Zone."Inbound Auto. Registration FND" THEN
            Zone."Inbound Auto. Registration FND" := FALSE;
        Zone.MODIFY;

        //Check the default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG079', COMPANYNAME, DATABASE::Bin);
        Bin.GET(TransferFromLocation.Code, UnitTestingValues.Value);

        IF TransferFromLocation."Shipment Bin Code" <> Bin.Code THEN BEGIN
            TransferFromLocation."Shipment Bin Code" := Bin.Code;
            TransferFromLocation.MODIFY;
        END;

        IF (TransferToLocation."Receipt Bin Code" = '') OR
           (TransferToLocation."Receipt Bin Code" <> Bin.Code)
        THEN BEGIN
            Bin2.SETRANGE("Location Code", TransferToLocation.Code);
            IF Bin2.FINDSET THEN BEGIN
                Zone2.SETRANGE("Location Code", TransferToLocation.Code);
                Zone2.SETRANGE(Code, Bin2."Zone Code");
                IF Zone2.FINDFIRST THEN BEGIN
                    IF Zone2."Use As In-Transit FND" THEN
                        Zone2."Use As In-Transit FND" := FALSE;
                    IF Zone2."Default Receipt Bin Code FND" <> Bin2.Code THEN
                        Zone2."Default Receipt Bin Code FND" := Bin2.Code;
                    IF Zone2."Transf.Gate EntryMandatory FND" THEN
                        Zone2."Transf.Gate EntryMandatory FND" := FALSE;
                    IF Zone2."Inbound Auto. Registration FND" THEN
                        Zone2."Inbound Auto. Registration FND" := FALSE;
                    Zone2.MODIFY;
                END;
                TransferToLocation."Receipt Bin Code" := Bin2.Code;
                TransferToLocation.MODIFY;
            END;
        END;

        BinContent.SETRANGE("Location Code", TransferFromLocation.Code);
        BinContent.SETRANGE("Item No.", Item."No.");
        BinContent.SETRANGE(Default, TRUE);
        IF BinContent.FINDFIRST THEN BEGIN
            IF BinContent."Bin Code" <> Bin.Code THEN
                BinContent.Default := FALSE;
            BinContent.MODIFY;
        END;

        BinContent2.SETRANGE("Location Code", TransferFromLocation.Code);
        BinContent2.SETRANGE("Item No.", Item."No.");
        BinContent2.SETRANGE("Bin Code", Bin.Code);
        BinContent2.FINDFIRST;
        BinContent2.Default := TRUE;
        BinContent2.MODIFY;

        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Strict Expiration Posting" THEN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        //Check default value for Gate Entry No. Series
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG079', COMPANYNAME, DATABASE::"No. Series");
        NoSeries.GET(UnitTestingValues.Value);

        //Disable mandatory Expiration Date
        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        //Add Gate Entry No. Series
        WarehouseSetup.GET;
        IF WarehouseSetup."Gate Entry Nos. FND" = '' THEN
            WarehouseSetup."Gate Entry Nos. FND" := NoSeries.Code;
        IF NOT WarehouseSetup."Allow Collect Lines FND" THEN
            WarehouseSetup."Allow Collect Lines FND" := TRUE;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF WarehouseSetup."Copy Route Planning Code" THEN
        //     WarehouseSetup."Copy Route Planning Code" := FALSE;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        WarehouseSetup.MODIFY;

        //Disable Credit Limit
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;

        //Add Default Location for UserID
        WarehouseEmployee.RESET; // BC Upgrade PATELP08 >> ADDED
        WarehouseEmployee.SETRANGE("User ID", USERID);
        WarehouseEmployee.SETRANGE("Location Code", TransferToLocation.Code);
        IF WarehouseEmployee.FINDFIRST THEN BEGIN
            // BC Upgrade PATELP08 >> Update existing Warehouse Employee for same User ID and Location Code instead of inserting duplicate record
            IF WarehouseEmployee."Zone Code" <> Zone.Code THEN
                WarehouseEmployee."Zone Code" := Zone.Code;
            IF NOT WarehouseEmployee.Default THEN
                WarehouseEmployee.Default := TRUE;
            WarehouseEmployee.MODIFY;
            // BC Upgrade PATELP08 << 
        END ELSE BEGIN
            WarehouseEmployee.INIT;
            WarehouseEmployee."User ID" := USERID;
            WarehouseEmployee."Location Code" := TransferToLocation.Code;
            WarehouseEmployee."Zone Code" := Zone2.Code;
            WarehouseEmployee.Default := TRUE;
            WarehouseEmployee.INSERT;
        END;
        //HEI.20<<

        //Step 1 - Required Setup: Either in Location on in Zone "Transfer Gate Entry Mandatory" boolean is checked
        //HEI.20>>
        //TransferFromLocation.TESTFIELD("Transfer Gate Entry Mandatory",TRUE);
        TransferToLocation.TESTFIELD("Transfer Gate Entry Mandat FND", TRUE);
        //HEI.20<<

        //Step 2 - Create a Transfer Order with complete information
        TransferList.OPENEDIT;
        TransferOrder.OPENNEW;
        TransferOrder.NEW;
        TransferOrder."No.".ASSISTEDIT;
        TransferOrder."Transfer-from Code".SETVALUE(TransferFromLocation.Code);
        TransferOrder."Transfer-to Code".SETVALUE(TransferToLocation.Code);
        TransferOrder."In-Transit Code".SETVALUE(InTransitLocation.Code);
        TransferOrder."Shipping Agent Code".SETVALUE(ShippingAgent.Code);
        TransferOrder."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        TransferOrder.TransferLines.NEW;
        TransferOrder.TransferLines."Item No.".SETVALUE(Item."No.");
        TransferOrder.TransferLines.Quantity.SETVALUE(1);
        TransferOrder.TransferLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure");//BC Upgrade KUMARR78 08-06-2026++

        //BC Upgrade KUMARR78 >> Assign lot tracking on the TRANSFER ORDER line. The legacy DIT Auto-FEFO ran on the Transfer Order and auto-assigned a lot; KUMARR78 replaced it with the sales-oriented WarehouseShipment."&Automatic FEFO Tracking for Order" action, which does NOT assign tracking to a transfer line and spawns a blank-"Item No." line that crashes the Aptean IntlInventoryHook101FDW (No.=''). Pick a lot that physically has warehouse stock in the source SHIPMENT BIN (Bin.Code) - not just at the location - so the whse register has bin content to consume, then assign it via the outbound ("Shipment") Item Tracking action.
        BestLotNo := '';
        BestQtyBase := 0;

        LotNoInformation.RESET;
        LotNoInformation.SETRANGE("Item No.", Item."No.");
        LotNoInformation.SETFILTER("Lot No.", '<>%1', '');
        LotNoInformation.SETRANGE(Blocked, false);
        LotNoInformation.SETFILTER("Expiration Date 101FDW", '>=%1', TODAY);
        IF LotNoInformation.FINDSET THEN
            REPEAT
                WarehouseEntry.RESET;
                WarehouseEntry.SETRANGE("Item No.", Item."No.");
                WarehouseEntry.SETRANGE("Location Code", TransferFromLocation.Code);
                WarehouseEntry.SETRANGE("Bin Code", Bin.Code);
                WarehouseEntry.SETRANGE("Lot No.", LotNoInformation."Lot No.");
                WarehouseEntry.CALCSUMS("Qty. (Base)");

                IF WarehouseEntry."Qty. (Base)" >= 1 THEN
                    IF WarehouseEntry."Qty. (Base)" > BestQtyBase THEN BEGIN
                        BestQtyBase := WarehouseEntry."Qty. (Base)";
                        BestLotNo := LotNoInformation."Lot No.";
                    END;
            UNTIL LotNoInformation.NEXT = 0;

        LotNoFilter := BestLotNo;
        ItemTrackingQtyBase := 1;
        TransferOrder.TransferLines.Shipment.INVOKE;//"Shipment" = outbound Item Tracking Lines action on the Transfer Order Subform
        //BC Upgrade KUMARR78 <<


        //Step 3 - Release the Order
        // TransferOrder."Codeunit Release Transfer Document".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        TransferOrder."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name
        //Auto-FEFO
        // TransferOrder.Action1111000002.INVOKE;//BC UPGRADE KUMARR78 DIT Action

        //Create Warehouse Shipment
        WarehouseShipment.TRAP;
        // TransferOrder.Action5778.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        TransferOrder."Create Whse. S&hipment".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //Release Whse. Shipment
        //HEI.20>>
        //--Take Driver, Truck from Unit Testing Values
        //IF WarehouseShipment."Truck Code".VALUE = '' THEN BEGIN
        //Truck.SETRANGE(Status,Truck.Status::Open);
        //Truck.FINDFIRST;
        //WarehouseShipment."Truck Code".SETVALUE(Truck.Code);
        //END;
        //IF WarehouseShipment."Driver Code".VALUE = '' THEN BEGIN
        //Driver.FINDFIRST;
        //WarehouseShipment."Driver Code".SETVALUE(Driver.Code);
        //END;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Driver.Code <> '' THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Truck.Code <> '' THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        // BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.20<<

        //Release Whse. Shipment
        // WarehouseShipment.Action45.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        WarehouseShipment."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //HEI.20>>
        //Gate Entry should be created for Receipt, not for Shipment
        //WarehouseShipment.CreateGateEntryOutbound.INVOKE;

        //GateEntryOutbound.OPENVIEW;
        //GateEntryOutbound.FILTER.SETFILTER("Gate Entry Document No.", WarehouseShipment."Gate Entry No.".VALUE);
        //GateEntryOutbound.Action55001.INVOKE;
        //HEI.20<<
        //BC Upgrade KUMARR78 >> Remove any blank-"Item No." transfer line before posting. The Aptean IntlInventoryHook101FDW runs on every Transfer Shipment Line during posting and does Item.GET("Item No.") with NO blank guard, throwing "The Item does not exist. No.=''". A blank (description/phantom) transfer line produces no whse-shipment line but is still posted by TransferOrder-Post Shipment, feeding the unguarded hook. The real item line (with assigned lot) is kept.
        TransferLine.RESET;
        TransferLine.SETRANGE("Document No.", TransferOrder."No.".VALUE);
        TransferLine.SETRANGE("Item No.", '');
        IF NOT TransferLine.ISEMPTY THEN
            TransferLine.DELETEALL(FALSE);
        //BC Upgrade KUMARR78 <<

        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"  // post Whse Shipment

        //Step 4,5 - Create new Gate Entry Document, Click in Gate Entry Document No. and press tab.
        GateEntryInboundList.OPENEDIT;
        GateEntryInbound.OPENNEW;
        GateEntryInbound.NEW;
        GateEntryInbound."Gate Entry Document No.".SETVALUE('');
        GateEntryInbound."Location Code".SETVALUE(TransferToLocation.Code); //HEI.20
        GateEntryInbound."Zone Code".SETVALUE(Zone2.Code); //HEI.20

        //Step 7 - In the box of Vehicle No. enter the respective trucks from the list
        // GateEntryInbound."Vehicle No.".SETVALUE(TransferOrder."Truck Code".VALUE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        // GateEntryInbound."Vehicle No.".SETVALUE(TransferOrder."LOG Vehicle Code 107FDW".VALUE);//BC UPGRADE KUMARR78 >> --
        GateEntryInbound."Vehicle No.".SETVALUE(Truck.Code);//BC UPGRADE KUMARR78 >> ++


        //Step 8 - In the box of Driver select respective driver from the list.
        // GateEntryInbound."Driver Code".SETVALUE(TransferOrder."Driver Code".VALUE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        // GateEntryInbound."Driver Code".SETVALUE(TransferOrder."Log Driver 107FDW".VALUE);//BC UPGRADE KUMARR78 >> --
        GateEntryInbound."Driver Code".SETVALUE(Driver.Code);//BC UPGRADE KUMARR78 >> ++

        //Step 9 - In the box Document Type chose from the list.
        GateEntryInbound."Document Type".SETVALUE(GateEntry_DocumentType::"Transfer Order");

        //Step 10 - In the field Total Weight on arrival type the weight if applicable.

        //Step 11 - Add all the Items in Line with physical varified Quantity
        GateEntryInbound.GateEntryLine.NEW;
        GateEntryInbound.GateEntryLine.Type.SETVALUE(Type::Item);
        GateEntryInbound.GateEntryLine."No.".SETVALUE(Item."No.");
        GateEntryInbound.GateEntryLine."Quantity on Arrival".SETVALUE(1);

        //Step 12 - Click on release document.
        // GateEntryInbound.Action1000000034.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GateEntryInbound."Release".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name
        GateEntryNo := GateEntryInbound."Gate Entry Document No.".VALUE;

        //Step 13 - Create Warehouse receipt document and attached Gate entry after filling all required information
        WarehouseReceipt.TRAP;
        // TransferOrder.Action84.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        TransferOrder."Create &Whse. Receipt".INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.

        WarehouseReceipt."Gate Entry No.".SETVALUE(GateEntryNo);
        WarehouseReceipt.WhseReceiptLines.FIRST;

        //HEI.20>>
        //Steps not required
        //Step 15 - Modify the Warehouse quantity as it should not match with Gate Entry Quantity
        //WarehouseReceipt.WhseReceiptLines."Qty. to Receive".SETVALUE(2);

        //Step 16 - Post the Warehouse Receipt
        //ASSERTERROR WarehouseReceipt."Post Receipt".INVOKE;
        //HEI.20<<

        //Step 17 - Again modify the Warehouse quantity as it should  match with Gate Entry Quantity
        WarehouseReceipt.WhseReceiptLines."Qty. to Receive".SETVALUE(1);

        //Step 18 - Post the Warehouse Receipt
        WarehouseReceipt."Post Receipt".INVOKE;

        //Step 19 - Gate entry is also registerd
        // GateEntryInbound.Action55001.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GateEntryInbound.Register.INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name
        //HEI.08>>
    end;


    [Test]
    [HandlerFunctions('GateEntryOutbound_ModalPageHandler_LOG080,ItemTrackingLinesModalPageHandler,MessageHandler,ShipInvoiceStrMenuHandler,GateEntryRegisterConfirmHandler,DimensionSetEntriesModalPageHandler')]
    procedure LOG080_OutboundProcessPurchaseReturnOrder();
    var
        Vendor: Record Vendor;
        Item: Record Item;
        Location: Record Location;
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable
        Route: Record Route107FDW;
        Bin: Record Bin;
        Zone: Record Zone;
        ReturnReason: Record "Return Reason";
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        Driver: Record Driver107FDW;
        Truck: Record Vehicle101FDW;
        PurchaseReturnOrder: TestPage "Purchase Return Order";
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        WarehouseShipment: TestPage "Warehouse Shipment";
        GateEntryOutbound: TestPage "Gate Entry Outbound";
        GateEntryNo: Code[20];
        Workflow: Record Workflow;
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        PurchaseHeader: Record "Purchase Header";
        NoSeries: Record "No. Series";
        WarehouseSetup: Record "Warehouse Setup";
        // WarehouseEmployee: Record "Warehouse Employee";//BC UPGRADE KUMARR78--
        WarehouseEmployee: Record "Warehouse Employee_DTW FND";//BC UPGRADE KUMARR78++

        ItemUnitofMeasure: Record "Item Unit of Measure";
        ItemTrackingCode: Record "Item Tracking Code";
        GateEntryHeader: Record "Gate Entry Header FND";
        GeneralLedgerSetup: Record "General Ledger Setup";
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)"; // BC Upgrade PATELP08
    begin
        ClearVariables('LOG080'); //HEI.31
        //HEI.08<<
        //Check default value for Vendor
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::Vendor);
        Vendor.GET(UnitTestingValues.Value);

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF NOT Location."Purchase Gate Entry Mandat FND" THEN
            Location."Purchase Gate Entry Mandat FND" := TRUE;
        IF NOT Location."Enable Inbound Validation FND" THEN
            Location."Enable Inbound Validation FND" := TRUE;
        IF NOT Location."InBound Auto Registration FND" THEN
            Location."InBound Auto Registration FND" := TRUE;
        //IF Location."Shipment Bin Code" <> Bin.Code THEN
        //Location."Shipment Bin Code" := Bin.Code;
        Location.MODIFY;
        //HEI.20<<

        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF Route."Multiple Order Route" THEN
            Route."Multiple Order Route" := FALSE;
        //HEI.36>>
        Route."shipping location" := Location.Code;
        Route."receipt location" := Location.Code;
        //HEI.36<<
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //END; //HEI.36
        //HEI.20<<

        //Check default value for Return Reasons
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::"Return Reason");
        ReturnReason.GET(UnitTestingValues.Value);

        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::Zone);
        Zone.GET(Location.Code, UnitTestingValues.Value);
        //HEI.20>>
        IF NOT Zone."Purch. GateEntry Mandatory FND" THEN
            Zone."Purch. GateEntry Mandatory FND" := TRUE;
        IF NOT Zone."Inbound Auto. Registration FND" THEN
            Zone."Inbound Auto. Registration FND" := TRUE;
        Zone.MODIFY;
        //HEI.20<<

        //Check default value for Lot
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::"Lot No. Information");
        LotNoFilter := UnitTestingValues.Value;

        //Check the default value for Truck

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::Vehicle101FDW);
        //HEI.20>>
        //Truck.GET(UnitTestingValues.Value);
        //Truck.TESTFIELD(Status,Truck.Status::Open);
        IF NOT Truck.GET(UnitTestingValues.Value) THEN BEGIN
            Truck.INIT;
            Truck.Code := 'LOG080';
            Truck.INSERT;
        END ELSE
            IF Truck."Status FND" <> Truck."Status FND"::Open THEN BEGIN
                Truck."Status FND" := Truck."Status FND"::Open;
                Truck.MODIFY;
            END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.20<<

        //Check the default value for Driver

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::Driver107FDW);
        //HEI.20>>
        IF NOT Driver.GET(UnitTestingValues.Value) THEN BEGIN
            Driver.INIT;
            Driver.Code := 'LOG080';
            Driver.INSERT;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.20<<

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // UnitTestingValues.RESET;
        // UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::"Shipping Agent Services");
        // //HEI.20>>
        // //ShippingAgentServices.GET(ShippingAgent.Code,UnitTestingValues.Value);
        // IF ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value) THEN
        //     IF ShippingAgentServices."Allow Shipping Cost Per" <> ShippingAgentServices."Allow Shipping Cost Per"::" " THEN BEGIN
        //         ShippingAgentServices."Allow Shipping Cost Per" := ShippingAgentServices."Allow Shipping Cost Per"::" ";
        //         ShippingAgentServices.MODIFY;
        //     END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.20>>
        //Check default value for CCC Dimension Value Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::"Dimension Value");
        GeneralLedgerSetup.GET;
        IF DimensionValue.GET(GeneralLedgerSetup."Cost Center Dimension Code FND", UnitTestingValues.Value) THEN;

        //Check default value for Gate Entry No. Series
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::"No. Series");
        NoSeries.GET(UnitTestingValues.Value);

        //Disable mandatory Expiration Date
        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        //Add Gate Entry No. Series
        WarehouseSetup.GET;
        IF WarehouseSetup."Gate Entry Nos. FND" = '' THEN
            WarehouseSetup."Gate Entry Nos. FND" := NoSeries.Code;
        IF NOT WarehouseSetup."Allow Collect Lines FND" THEN
            WarehouseSetup."Allow Collect Lines FND" := TRUE;
        IF NOT WarehouseSetup."Auto Insert Qty.CollectLin FND" THEN
            WarehouseSetup."Auto Insert Qty.CollectLin FND" := TRUE;
        WarehouseSetup.MODIFY;

        //Add Default Location for UserID
        WarehouseEmployee.RESET; // BC Upgrade PATELP08 filter by real PK (User+Location) and modify existing to avoid duplicate insert at release
        WarehouseEmployee.SETRANGE("User ID", USERID);
        WarehouseEmployee.SETRANGE("Location Code", Location.Code);
        IF WarehouseEmployee.FINDFIRST THEN BEGIN
            IF WarehouseEmployee."Zone Code" <> Zone.Code THEN
                WarehouseEmployee."Zone Code" := Zone.Code;
            IF NOT WarehouseEmployee.Default THEN
                WarehouseEmployee.Default := TRUE;
            WarehouseEmployee.MODIFY;
        END ELSE BEGIN
            WarehouseEmployee.INIT;
            WarehouseEmployee."User ID" := USERID;
            WarehouseEmployee."Location Code" := Location.Code;
            WarehouseEmployee."Zone Code" := Zone.Code;
            WarehouseEmployee.Default := TRUE;
            WarehouseEmployee.INSERT;
        END;
        //HEI.20<<

        //Step 1 - Required Setup: Either in Location on in Zone "Purchase Gate Entry Mandatory FND" boolean is checked
        Location.TESTFIELD("Purchase Gate Entry Mandat FND", TRUE);
        Zone.TESTFIELD("Purch. GateEntry Mandatory FND", TRUE);

        //Step 2 - Create a Sales Return Order with complete information
        PurchaseReturnOrder.OPENNEW;
        PurchaseReturnOrder.NEW;

        PurchaseReturnOrder."Buy-from Vendor Name".SETVALUE(Vendor."No.");
        //PurchaseReturnOrder.Route.SETVALUE(Route.Code);
        PurchaseReturnOrder."Location Code".SETVALUE(Location.Code);

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        PurchaseReturnOrder."Shipping Agent Code 107FDW".SETVALUE(ShippingAgent.Code);
        PurchaseReturnOrder."LOG Shipping Agent Service 107FDW".SETVALUE(ShippingAgentServices.Code);
        PurchaseReturnOrder."Log Driver 107FDW".SETVALUE(Driver.Code);
        PurchaseReturnOrder."Log Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        PurchaseReturnOrder.PurchLines.NEW;
        PurchaseReturnOrder.PurchLines.Type.SETVALUE(Type::Item); // BC Upgrade PATELP08 set line type Item before No. else No. validates against Standard Text
        PurchaseReturnOrder.PurchLines."No.".SETVALUE(Item."No.");
        PurchaseReturnOrder.PurchLines."Location Code".SETVALUE(Location.Code);

        //Check default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG080', COMPANYNAME, DATABASE::Bin);
        Bin.GET(PurchaseReturnOrder.PurchLines."Location Code".VALUE, UnitTestingValues.Value);
        //HEI.20>>
        //PurchaseReturnOrder.PurchLines."Bin Code".SETVALUE(Bin.Code);
        IF Location."Shipment Bin Code" <> Bin.Code THEN
            Location."Shipment Bin Code" := Bin.Code;
        Location.MODIFY;
        //HEI.20<<

        PurchaseReturnOrder.PurchLines.Quantity.SETVALUE(1);
        PurchaseReturnOrder.PurchLines."Return Reason Code".SETVALUE(ReturnReason.Code);

        //HEI.20>>
        PurchaseReturnOrder.PurchLines.Dimensions.INVOKE;

        //Disable Workflows before Release
        PurchaseHeader.GET(PurchaseHeader."Document Type"::"Return Order", PurchaseReturnOrder."No.".VALUE);
        IF ApprovalsMgmt.IsPurchaseApprovalsWorkflowEnabled(PurchaseHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;
        //HEI.20<<

        //Step 3 - Release the Order
        // PurchaseReturnOrder.Release.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        PurchaseReturnOrder."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name


        //Step 4 - Create Warehouse Shipment document and fill all required information
        WarehouseShipment.TRAP;
        // PurchaseReturnOrder.Action93.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        PurchaseReturnOrder."Create &Warehouse Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //HEI.20>>
        //WarehouseShipment.Action1100076703.INVOKE; //Auto FEFO
        WarehouseShipment."Zone Code".SETVALUE(Zone.Code);
        WarehouseShipment.WhseShptLines.FILTER.SETFILTER("Item No.", Item."No.");
        ItemUnitofMeasure.SETRANGE(Code, Item."Purch. Unit of Measure"); //HEI.45
        ItemUnitofMeasure.SETRANGE("Item No.", Item."No.");
        IF ItemUnitofMeasure.FINDFIRST THEN
            ItemTrackingQtyBase := WarehouseShipment.WhseShptLines."Qty. to Ship".ASDECIMAL * ItemUnitofMeasure."Qty. per Unit of Measure"
        ELSE
            //HEI.20<<
            ItemTrackingQtyBase := 1;
        WarehouseShipment.WhseShptLines.ItemTrackingLines.INVOKE;
        // WarehouseShipment.Action45.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        WarehouseShipment."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //Step 5 - Create Gate entry document from warehouse shipment
        //HEI.20>>
        IF NOT GateEntryHeader.FINDLAST THEN BEGIN
            GateEntryHeader.INIT;
            GateEntryHeader."Gate Entry Document No." := 'LOG080';
            GateEntryHeader.INSERT;
        END;
        //HEI.20<<
        WarehouseShipment.CreateGateEntryOutbound.INVOKE;

        //Step 6 - Post Whse. Shipment
        GateEntryNo := WarehouseShipment."Gate Entry No.".VALUE;
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"

        //Step 7-22 are in function GateEntryOutbound_ModalPageHandler
        GateEntryOutbound.OPENVIEW;
        GateEntryOutbound.FILTER.SETFILTER("Gate Entry Document No.", GateEntryNo);
        // GateEntryOutbound.Action55001.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        GateEntryOutbound.Register.INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name
        //HEI.08>>
    end;

    [Test]
    [HandlerFunctions('NoSeriesListModalPageHandler,MessageHandler,ConfirmationHandler,ItemTrackingLinesModalPageHandler,DimensionSetEntriesModalPageHandler')]
    procedure LOG081_InboundProcessPurchaseOrder();
    var
        Location: Record Location;
        Vendor: Record Vendor;
        Item: Record Item;
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable
        Route: Record Route107FDW;
        Bin: Record Bin;
        Zone: Record Zone;
        ReturnReason: Record "Return Reason";
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        Driver: Record Driver107FDW;
        Truck: Record Vehicle101FDW;
        PurchaseOrder: TestPage "Purchase Order";
        GateEntryInbound: TestPage "Gate Entry Inbound";
        GateEntryInboundList: TestPage "Gate Entry Inbound List";
        WarehouseReceipt: TestPage "Warehouse Receipt";
        ItemTrackingLines: TestPage "Item Tracking Lines";
        GateEntry_DocumentType: Option " ","Purchase Order","Transfer Order","Sales Return Order","Warehouse Receipt","Sales Order","Purchase Return Order","Warehouse Shipment";
        TypeGE: Option " ",Item,"Fixed Asset","Service Item";
        GateEntryNo: Code[20];
        Workflow: Record Workflow;
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        PurchaseHeader: Record "Purchase Header";
        NoSeries: Record "No. Series";
        WarehouseSetup: Record "Warehouse Setup";
        WarehouseEmployee: Record "Warehouse Employee";
        ItemUnitofMeasure: Record "Item Unit of Measure";
        ItemTrackingCode: Record "Item Tracking Code";
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        PurchasesPayablesSetup: Record "Purchases & Payables Setup";
        GeneralLedgerSetup: Record "General Ledger Setup";
    begin
        ClearVariables('LOG081'); //HEI.31
        //HEI.08<<
        //Check default value for Vendor
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::Vendor);
        Vendor.GET(UnitTestingValues.Value);

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);
        //HEI.20>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Item."Strength 3 Code 101FDW" = 'EXT.[%W/W]' THEN BEGIN
            Item."Strength 3 Code 101FDW" := '';
            Item.MODIFY;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.20<<

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        //HEI.20>>
        //Check default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::Bin);
        Bin.GET(Location.Code, UnitTestingValues.Value);

        IF NOT Location."Purchase Gate Entry Mandat FND" THEN
            Location."Purchase Gate Entry Mandat FND" := TRUE;
        IF NOT Location."Enable Inbound Validation FND" THEN
            Location."Enable Inbound Validation FND" := TRUE;
        IF NOT Location."InBound Auto Registration FND" THEN
            Location."InBound Auto Registration FND" := TRUE;
        IF Location."Receipt Bin Code" <> Bin.Code THEN
            Location."Receipt Bin Code" := Bin.Code;
        Location.MODIFY;
        //HEI.20<<


        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF Route."Multiple Order Route" THEN
            Route."Multiple Order Route" := FALSE;
        // //HEI.36>>
        // //IF Route."Location Code" <> '' THEN
        // //Route."Location Code" := '';
        Route."Shipping Location" := Location.Code;
        Route."Receipt Location" := Location.Code;
        // //HEI.36<<
        // //HEI.71>>
        // // IF COMPANYNAME = '10_SURIN_BROUWERIJ' THEN BEGIN //HEI.77
        // //HEI.77>>

        PurchasesPayablesSetup.GET;
        IF (PurchasesPayablesSetup."Excluded Incoterms FND" <> '') AND NOT (Route."Shipment Method" IN [PurchasesPayablesSetup."Excluded Incoterms FND"]) THEN BEGIN
            //HEI.77<<
            IF Route."Shipment Method" <> '' THEN
                Route."Shipment Method" := '';
        END;
        //HEI.71<<
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.20<<

        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::Zone);
        Zone.GET(Location.Code, UnitTestingValues.Value);
        //HEI.20>>
        IF NOT Zone."Purch. GateEntry Mandatory FND" THEN
            Zone."Purch. GateEntry Mandatory FND" := TRUE;
        IF Zone."Inbound Auto. Registration FND" THEN
            Zone."Inbound Auto. Registration FND" := FALSE;
        Zone.MODIFY;
        //HEI.02<<

        //Check default value for Lot
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::"Lot No. Information");
        LotNoFilter := UnitTestingValues.Value;

        //HEI.20>>
        //Check default value for Truck

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::Vehicle101FDW);
        IF NOT Truck.GET(UnitTestingValues.Value) THEN BEGIN
            Truck.INIT;
            Truck.Code := 'LOG081';
            Truck.INSERT;
        END ELSE
            IF Truck."Status FND" <> Truck."Status FND"::Open THEN BEGIN
                Truck."Status FND" := Truck."Status FND"::Open;
                Truck.MODIFY;
            END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Driver

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::Driver107FDW);
        IF NOT Driver.GET(UnitTestingValues.Value) THEN BEGIN
            Driver.INIT;
            Driver.Code := 'LOG081';
            Driver.INSERT;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::"Shipping Agent Services");
        IF ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value) THEN begin
            // IF ShippingAgentServices."Allow Shipping Cost Per" <> ShippingAgentServices."Allow Shipping Cost Per"::" " THEN BEGIN
            //     ShippingAgentServices."Allow Shipping Cost Per" := ShippingAgentServices."Allow Shipping Cost Per"::" ";
            ShippingAgentServices.MODIFY;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for CCC Dimension Value Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::"Dimension Value");
        GeneralLedgerSetup.GET;
        IF DimensionValue.GET(GeneralLedgerSetup."Cost Center Dimension Code FND", UnitTestingValues.Value) THEN;

        //Check default value for Gate Entry No. Series
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::"No. Series");
        NoSeries.GET(UnitTestingValues.Value);

        //Disable mandatory Expiration Date
        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        //Add Gate Entry No. Series
        WarehouseSetup.GET;
        IF WarehouseSetup."Gate Entry Nos. FND" = '' THEN BEGIN
            WarehouseSetup."Gate Entry Nos. FND" := NoSeries.Code;
            WarehouseSetup.MODIFY;
        END;

        //Add Default Location for UserID
        WarehouseEmployee.SETRANGE("User ID", USERID);
        WarehouseEmployee.SETRANGE("Location Code", Location.Code);
        WarehouseEmployee.SETRANGE("Zone Code FND", Zone.Code);
        IF WarehouseEmployee.FINDFIRST THEN BEGIN
            IF NOT WarehouseEmployee.Default THEN BEGIN
                WarehouseEmployee.Default := TRUE;
                WarehouseEmployee.MODIFY;
            END;
        END ELSE BEGIN
            WarehouseEmployee.INIT;
            WarehouseEmployee."User ID" := USERID;
            WarehouseEmployee."Location Code" := Location.Code;
            WarehouseEmployee."Zone Code FND" := Zone.Code;
            WarehouseEmployee.Default := TRUE;
            WarehouseEmployee.INSERT;
        END;

        PurchasesPayablesSetup.GET;
        IF PurchasesPayablesSetup."Requester ID Mandatory FND" THEN BEGIN
            PurchasesPayablesSetup."Requester ID Mandatory FND" := FALSE;
            PurchasesPayablesSetup.MODIFY;
        END;
        //HEI.20<<

        //Step 2 - Required Setup: Either in Location on in Zone "Purchase Gate Entry Mandatory FND" boolean is checked
        Location.TESTFIELD("Purchase Gate Entry Mandat FND", TRUE);

        //Step 3 - Create a Purchase Order with complete information
        PurchaseOrder.OPENNEW;
        PurchaseOrder.NEW;

        PurchaseOrder."No.".ASSISTEDIT;
        PurchaseOrder."Buy-from Vendor No.".SETVALUE(Vendor."No.");
        PurchaseOrder."Location Code".SETVALUE(Location.Code);

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        PurchaseOrder."Route 107FDW".SETVALUE(Route.Code);
        //HEI.20>>
        IF Route."Shipping Agent Mand. APS" AND
           (ShippingAgent.Code <> '') AND
           (PurchaseOrder."Shipping Agent Code 107FDW".VALUE <> ShippingAgent.Code)
        THEN
            PurchaseOrder."Shipping Agent Code 107FDW".SETVALUE(ShippingAgent.Code);


        IF Route."Ship. Agent Serv. Mand. APS" AND
           (ShippingAgentServices.Code <> '') AND
           (PurchaseOrder."LOG Shipping Agent Service 107FDW".VALUE <> ShippingAgentServices.Code)
        THEN
            PurchaseOrder."LOG Shipping Agent Service 107FDW".SETVALUE(ShippingAgentServices.Code);


        IF (PurchaseOrder."Vehicle Code 101FDW".VALUE = '') AND (Truck.Code <> '') THEN
            PurchaseOrder."Vehicle Code 101FDW".SETVALUE(Truck.Code);
        IF (PurchaseOrder."Log Driver 107FDW".VALUE = '') AND (Driver.Code <> '') THEN
            PurchaseOrder."Log Driver 107FDW".SETVALUE(Driver.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.20<<

        PurchaseOrder.PurchLines.NEW;
        PurchaseOrder.PurchLines.Type.SETVALUE(Type::Item); //BC Upgrade ATHUSK01
        PurchaseOrder.PurchLines."No.".SETVALUE(Item."No.");
        PurchaseOrder.PurchLines."Location Code".SETVALUE(Location.Code);
        //PurchaseOrder.PurchLines."Special Order Sales No.".SETVALUE(WORKDATE); //HEI.15
        PurchaseOrder.PurchLines.Quantity.SETVALUE(2);

        //HEI.20>>
        PurchaseOrder.PurchLines.Dimensions.INVOKE;

        //Disable Workflows before Release
        PurchaseHeader.GET(PurchaseHeader."Document Type"::Order, PurchaseOrder."No.".VALUE);
        IF ApprovalsMgmt.IsPurchaseApprovalsWorkflowEnabled(PurchaseHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;
        //HEI.20<<

        //HEI.70>>
        //Check Import PO
        PurchaseHeaderAdditional.RESET;
        PurchaseHeaderAdditional.GET(PurchaseHeader."Document Type"::Order, PurchaseOrder."No.".VALUE);
        IF PurchaseHeaderAdditional."Import Identifier" THEN BEGIN
            PurchaseOrder."Expctd Physical Delvry Date(Imp)".SETVALUE(TODAY);
            PurchaseOrder.PurchLines."Location Code".SETVALUE(PurchasesPayablesSetup."Location Code Imp Proc. FND");
        END;
        //HEI.70<<

        //Step 4 - Release the Order
        PurchaseOrder.Release.INVOKE;

        //Step 5 - In the Search box, enter Gate Entry Inbound, and then choose the related link
        GateEntryInboundList.OPENEDIT;
        GateEntryInbound.OPENNEW;
        GateEntryInbound.NEW;

        //Step 6 - Create new Gate Entry Document, Click in Gate Entry Document No. and press tab.
        GateEntryInbound."Gate Entry Document No.".SETVALUE('');
        GateEntryInbound."Location Code".SETVALUE(Location.Code); //HEI.20

        //Step 8 - In the box of Vehicle No. enter the respective trucks from the list
        GateEntryInbound."Vehicle No.".SETVALUE(PurchaseOrder."Vehicle Code 101FDW".VALUE);//BC UPGRADE KUMARR78 >> Blocking DIT Code

        //Step 8 - In the box of Driver select respective driver from the list.
        GateEntryInbound."Driver Code".SETVALUE(PurchaseOrder."Log Driver 107FDW".VALUE);//BC UPGRADE KUMARR78 >> Blocking DIT Code

        //Step 10 - In the box Document Type chose from the list.
        GateEntryInbound."Document Type".SETVALUE(GateEntry_DocumentType::"Warehouse Receipt");

        //Step 11 - In the field Total Weight on arrival type the weight if applicable.

        //Step 12 - Add all the Items in Line with physical varified Quantity
        GateEntryInbound.GateEntryLine.NEW;
        GateEntryInbound.GateEntryLine.Type.SETVALUE(TypeGE::Item);
        GateEntryInbound.GateEntryLine."No.".SETVALUE(Item."No.");
        GateEntryInbound.GateEntryLine."Quantity on Arrival".SETVALUE(2);
        GateEntryInbound.GateEntryLine."Unit Of Measure Code".SETVALUE(Item."Purch. Unit of Measure"); //HEI.20

        //Step 13 - Click on release document.
        // GateEntryInbound.Action1000000034.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GateEntryInbound."Release".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name
        GateEntryNo := GateEntryInbound."Gate Entry Document No.".VALUE;

        //Step 14 - Create Warehouse receipt document and attached Gate entry after filling all required information
        WarehouseReceipt.TRAP;
        // PurchaseOrder.Action149.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        PurchaseOrder."Create &Whse. Receipt".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name
        WarehouseReceipt."Gate Entry No.".SETVALUE(GateEntryNo);
        //HEI.20>>
        WarehouseReceipt.WhseReceiptLines.FILTER.SETFILTER("Item No.", Item."No.");
        ItemUnitofMeasure.SETRANGE(Code, Item."Purch. Unit of Measure"); //HEI.45
        ItemUnitofMeasure.SETRANGE("Item No.", Item."No.");
        IF ItemUnitofMeasure.FINDFIRST THEN
            ItemTrackingQtyBase := WarehouseReceipt.WhseReceiptLines."Qty. to Receive".ASDECIMAL * ItemUnitofMeasure."Qty. per Unit of Measure"
        ELSE
            //HEI.20<<
            ItemTrackingQtyBase := 2;
        WarehouseReceipt.WhseReceiptLines.ItemTrackingLines.INVOKE;
        //WarehouseReceipt.WhseReceiptLines.FIRST; //HEI.20

        //Step 16 - Modify the Warehouse quantity as it should not match with Gate Entry Quantity
        //WarehouseReceipt.WhseReceiptLines."Qty. to Receive".SETVALUE(1);

        //Step 17 - Post the Warehouse Receipt
        //ASSERTERROR WarehouseReceipt."Post Receipt".INVOKE;

        //Step 18 - Again modify the Warehouse quantity as it should  match with Gate Entry Quantity
        WarehouseReceipt.WhseReceiptLines."Qty. to Receive".SETVALUE(2);

        //Step 19 - Post the Warehouse Receipt
        WarehouseReceipt."Post Receipt".INVOKE;

        //Step 20 - Gate entry is also registerd
        // GateEntryInbound.Action55001.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GateEntryInbound.Register.INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name
        //HEI.08>>
    end;

    [Test]
    [HandlerFunctions('NoSeriesListModalPageHandler,MessageHandler,ConfirmationHandler,ItemTrackingLinesModalPageHandler')]
    procedure LOG082_InboundProcessSalesReturnOrder();
    var
        Location: Record Location;
        Customer: Record Customer;
        Item: Record Item;
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable
        Route: Record Route107FDW;
        Driver: Record Driver107FDW;
        Truck: Record Vehicle101FDW;
        Bin: Record Bin;
        Zone: Record Zone;
        ReturnReason: Record "Return Reason";
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        SalesReturnOrderList: TestPage "Sales Return Order List";
        SalesReturnOrderCard: TestPage "Sales Return Order";
        GateEntryInbound: TestPage "Gate Entry Inbound";
        GateEntryInboundList: TestPage "Gate Entry Inbound List";
        WarehouseReceipt: TestPage "Warehouse Receipt";
        ItemTrackingLines: TestPage "Item Tracking Lines";
        GateEntry_DocumentType: Option " ","Purchase Order","Transfer Order","Sales Return Order","Warehouse Receipt","Sales Order","Purchase Return Order","Warehouse Shipment";
        TypeGE: Option " ",Item,"Fixed Asset","Service Item";
        GateEntryNo: Code[20];
        Workflow: Record Workflow;
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        NoSeries: Record "No. Series";
        WarehouseSetup: Record "Warehouse Setup";
        WarehouseEmployee: Record "Warehouse Employee";
        ItemTrackingCode: Record "Item Tracking Code";
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        SalesReceivablesSetup: Record "Sales & Receivables Setup";
        SalesHeader: Record "Sales Header";
        ItemUnitofMeasure: Record "Item Unit of Measure";
    begin
        ClearVariables('LOG082'); //HEI.31
        //HEI.08<<
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF NOT Customer."Additional RPM Return FND" THEN
            Customer."Additional RPM Return FND" := TRUE;
        Customer.MODIFY;
        //HEI.20<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF NOT Location."Sales Gate Entry Mandatory FND" THEN BEGIN
            Location."Sales Gate Entry Mandatory FND" := TRUE;
            Location.MODIFY;
        END;
        //HEI.20<<

        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF Route."Multiple Order Route" THEN
            Route."Multiple Order Route" := FALSE;
        //HEI.36>>
        //IF Route."Location Code" <> '' THEN
        //Route."Location Code" := '';
        //IF Route."Return Location Code" <> '' THEN
        //Route."Return Location Code" := '';
        Route."Shipping Location" := Location.Code;
        Route."Receipt Location" := Location.Code;
        //HEI.36<<
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.20<<

        //Check default value for Return Reasons
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::"Return Reason");
        ReturnReason.GET(UnitTestingValues.Value);

        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::Zone);
        Zone.GET(Location.Code, UnitTestingValues.Value);
        //HEI.20>>
        IF Zone."Inbound Auto. Registration FND" THEN BEGIN
            Zone."Inbound Auto. Registration FND" := FALSE;
            Zone.MODIFY;
        END;
        //HEI.20<<

        //Check default value for Lot
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::"Lot No. Information");
        LotNoFilter := UnitTestingValues.Value;

        //HEI.20>>
        //Check default value for Truck

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::Vehicle101FDW);
        IF NOT Truck.GET(UnitTestingValues.Value) THEN BEGIN
            Truck.INIT;
            Truck.Code := 'LOG082';
            Truck.INSERT;
        END ELSE
            IF Truck."Status FND" <> Truck."Status FND"::Open THEN BEGIN
                Truck."Status FND" := Truck."Status FND"::Open;
                Truck.MODIFY;
            END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Driver

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::Driver107FDW);
        IF NOT Driver.GET(UnitTestingValues.Value) THEN BEGIN
            Driver.INIT;
            Driver.Code := 'LOG082';
            Driver.INSERT;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::"Shipping Agent Services");
        IF ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value) THEN
            // IF ShippingAgentServices."Allow Shipping Cost Per" <> ShippingAgentServices."Allow Shipping Cost Per"::" " THEN BEGIN
            //     ShippingAgentServices."Allow Shipping Cost Per" := ShippingAgentServices."Allow Shipping Cost Per"::" ";
            //     ShippingAgentServices.MODIFY;
            // END;
            //BC UPGRADE KUMARR78 << Blocking DIT Code

            //Check default value for Gate Entry No. Series
            UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::"No. Series");
        NoSeries.GET(UnitTestingValues.Value);
        IF NOT NoSeries."Manual Nos." THEN BEGIN
            NoSeries."Manual Nos." := TRUE;
            NoSeries.MODIFY;
        END;

        //Disable mandatory Expiration Date
        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        //Add Gate Entry No. Series
        WarehouseSetup.GET;
        IF WarehouseSetup."Gate Entry Nos. FND" = '' THEN
            WarehouseSetup."Gate Entry Nos. FND" := NoSeries.Code;
        IF NOT WarehouseSetup."Allow Collect Lines FND" THEN
            WarehouseSetup."Allow Collect Lines FND" := TRUE;
        WarehouseSetup.MODIFY;

        //Add Default Location for UserID
        WarehouseEmployee.SETRANGE("User ID", USERID);
        WarehouseEmployee.SETRANGE("Location Code", Location.Code);
        WarehouseEmployee.SETRANGE("Zone Code FND", Zone.Code);
        IF WarehouseEmployee.FINDFIRST THEN BEGIN
            IF NOT WarehouseEmployee.Default THEN BEGIN
                WarehouseEmployee.Default := TRUE;
                WarehouseEmployee.MODIFY;
            END;
        END ELSE BEGIN
            WarehouseEmployee.INIT;
            WarehouseEmployee."User ID" := USERID;
            WarehouseEmployee."Location Code" := Location.Code;
            WarehouseEmployee."Zone Code FND" := Zone.Code;
            WarehouseEmployee.Default := TRUE;
            WarehouseEmployee.INSERT;
        END;

        //Disable Credit Limit
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.20<<


        //Step 1 - Required Setup: Either in Location on in Zone "Sales Gate Entry Mandatory FND" boolean is checked
        Location.TESTFIELD("Sales Gate Entry Mandatory FND", TRUE);

        //Step 2 - Create a Sales Return Order with complete information
        SalesReturnOrderCard.OPENNEW;
        SalesReturnOrderCard.NEW;

        SalesReturnOrderCard."No.".ASSISTEDIT;
        SalesReturnOrderCard."Sell-to Customer Name".SETVALUE(Customer."No.");
        // SalesReturnOrderCard.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesReturnOrderCard.ShipmentDateNew.SETVALUE(WORKDATE);
        SalesReturnOrderCard."Location Code".SETVALUE(Location.Code); //HEI.20

        SalesReturnOrderCard.SalesLines.NEW;
        SalesReturnOrderCard.SalesLines."No.".SETVALUE(Item."No.");
        //SalesReturnOrderCard.SalesLines."Location Code".SETVALUE(Location.Code); //HEI.20

        //Check default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG082', COMPANYNAME, DATABASE::Bin);
        Bin.GET(SalesReturnOrderCard.SalesLines."Location Code".VALUE, UnitTestingValues.Value);
        //HEI.20>>
        //SalesReturnOrderCard.SalesLines."Bin Code".SETVALUE(Bin.Code);
        IF Location."Receipt Bin Code" <> Bin.Code THEN
            Location."Receipt Bin Code" := Bin.Code;
        Location.MODIFY;
        //HEI.20<<

        SalesReturnOrderCard.SalesLines.Quantity.SETVALUE(2);
        SalesReturnOrderCard.SalesLines."Return Reason Code".SETVALUE(ReturnReason.Code);

        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::"Return Order", SalesReturnOrderCard."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;
        //HEI.20<<

        //Step 3 - Release the Order
        SalesReturnOrderCard.Release.INVOKE;

        //Step 4 - In the Search box, enter Gate Entry Inbound, and then choose
        GateEntryInboundList.OPENEDIT;
        GateEntryInbound.OPENNEW;
        GateEntryInbound.NEW;

        //Step 5 - Create new Gate Entry Document, Click in Gate Entry Document No. and press tab.
        GateEntryInbound."Gate Entry Document No.".SETVALUE('');
        GateEntryInbound."Location Code".SETVALUE(Location.Code); //HEI.36

        //Step 7 - In the box of Vehicle No. enter the respective trucks from the list
        //HEI.20>>
        //GateEntryInbound."Vehicle No.".SETVALUE(SalesReturnOrderCard."Truck Code".VALUE);
        GateEntryInbound."Vehicle No.".SETVALUE(Truck.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
                                                            //HEI.20<<

        //Step 8 - In the box of Driver select respective driver from the list.
        //HEI.20>>
        //GateEntryInbound."Driver Code".SETVALUE(SalesReturnOrderCard."Driver Code".VALUE);
        GateEntryInbound."Driver Code".SETVALUE(Driver.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        //HEI.20<<

        //Step 9 - In the box Document Type chose from the list.
        GateEntryInbound."Document Type".SETVALUE(GateEntry_DocumentType::"Warehouse Receipt");

        //Step 10 - In the field Total Weight on arrival type the weight if applicable.

        //Step 11 - Add all the Items in Line with physical varified Quantity
        GateEntryInbound.GateEntryLine.NEW;
        GateEntryInbound.GateEntryLine.Type.SETVALUE(TypeGE::Item);
        GateEntryInbound.GateEntryLine."No.".SETVALUE(Item."No.");
        GateEntryInbound.GateEntryLine."Quantity on Arrival".SETVALUE(2);

        //Step 12 - Click on release document.
        // GateEntryInbound.Action1000000034.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GateEntryInbound."Release".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        GateEntryNo := GateEntryInbound."Gate Entry Document No.".VALUE;

        //Step 13 - Create Warehouse receipt document and attached Gate entry after filling all required information
        WarehouseReceipt.TRAP;

        // SalesReturnOrderCard.Action122.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        SalesReturnOrderCard."Create &Whse. Receipt".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name


        //HEI.20>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseReceipt."Shipping Agent Code 107FDW".SETVALUE(ShippingAgent.Code);
        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseReceipt."LOG Shipping Agent Service 107FDW".SetValue(ShippingAgentServices.Code);
        WarehouseReceipt."Log Driver 107FDW".SETVALUE(Driver.Code);
        WarehouseReceipt."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.20<<

        WarehouseReceipt."Gate Entry No.".SETVALUE(GateEntryNo);

        //HEI.20>>
        WarehouseReceipt.WhseReceiptLines.FILTER.SETFILTER("Item No.", Item."No.");
        ItemUnitofMeasure.SETRANGE(Code, Item."Sales Unit of Measure");
        ItemUnitofMeasure.SETRANGE("Item No.", Item."No.");
        IF ItemUnitofMeasure.FINDFIRST THEN
            ItemTrackingQtyBase := WarehouseReceipt.WhseReceiptLines."Qty. to Receive".ASDECIMAL * ItemUnitofMeasure."Qty. per Unit of Measure"
        ELSE
            //HEI.20<<
            ItemTrackingQtyBase := 2;
        WarehouseReceipt.WhseReceiptLines.ItemTrackingLines.INVOKE;
        //WarehouseReceipt.WhseReceiptLines.FIRST; //HEI.20

        //Step 15 - Modify the Warehouse quantity as it should not match with Gate Entry Quantity
        //WarehouseReceipt.WhseReceiptLines."Qty. to Receive".SETVALUE(1);

        //Step 16 - Post the Warehouse Receipt
        //ASSERTERROR WarehouseReceipt."Post Receipt".INVOKE;

        //Step 17 - Again modify the Warehouse quantity as it should  match with Gate Entry Quantity
        WarehouseReceipt.WhseReceiptLines."Qty. to Receive".SETVALUE(2);

        //Step 18 - Post the Warehouse Receipt
        WarehouseReceipt."Post Receipt".INVOKE;

        //Step 19 - Gate entry is also registerd
        // GateEntryInbound.Action55001.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GateEntryInbound.Register.INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name
        //HEI.08>>
    end;

