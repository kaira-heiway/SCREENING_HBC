                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;
        //HEI.22<<

        //HEI.23>>
        //Additional Fee on Reminder Level removed
        ReminderLevel.SETRANGE("Reminder Terms Code", BillToCustomer."Reminder Terms Code");
        ReminderLevel.SETFILTER("Additional Fee (LCY)", '>%1', 0);
        IF ReminderLevel.FINDSET THEN
            REPEAT
                ReminderLevel."Additional Fee (LCY)" := 0;
                ReminderLevel.MODIFY;
            UNTIL ReminderLevel.NEXT = 0
        ELSE BEGIN
            ReminderLevel.SETFILTER("Add. Fee per Line Amount (LCY)", '>%1', 0);
            IF ReminderLevel.FINDFIRST THEN
                REPEAT
                    ReminderLevel."Add. Fee per Line Amount (LCY)" := 0;
                    ReminderLevel.MODIFY;
                UNTIL ReminderLevel.NEXT = 0;
        END;

        //Disable Gate Control
        Zone.SETRANGE("Location Code", Location.Code);
        Zone.SETRANGE("Sales Gate Entry Mandatory FND", TRUE);
        IF Zone.FINDSET THEN
            REPEAT
                Zone."Sales Gate Entry Mandatory FND" := FALSE;
                Zone.MODIFY;
            UNTIL Zone.NEXT = 0;

        IF CustomerPostingGroup.GET(BillToCustomer."Customer Posting Group") THEN
            IF GLAccount.GET(CustomerPostingGroup."Invoice Rounding Account") THEN
                IF GenProductPostingGroup.GET(GLAccount."Gen. Prod. Posting Group") THEN
                    IF GenProductPostingGroup."Auto Insert Default" THEN BEGIN
                        GenProductPostingGroup."Auto Insert Default" := FALSE;
                        GenProductPostingGroup.MODIFY;
                    END;
        //HEI.23<<

        //Step 1: Login

        //Create and Post Invoice with Overdue
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        SalesOrder."No.".ASSISTEDIT;
        // SalesOrder."Document Subtype Code".SETVALUE(DocumentSubtypeCode.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);
        SalesOrder."Location Code".SETVALUE(Location.Code);
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Payment Terms Code".SETVALUE(PaymentTerms.Code);
        //HEI.55>>
        IF COMPANYNAME = '10_WIND_LEE_BR' THEN
            SalesOrder."Posting Date".SETVALUE(WORKDATE)
        ELSE
            SalesOrder."Posting Date".SETVALUE(CALCDATE('<-1M>', WORKDATE));
        //HEI.55<<
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);
        SalesOrder."External Document No.".SETVALUE('Unit Test OTC083');
        SalesOrderNo := SalesOrder."No.".VALUE;

        //HEI.22>>
        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38
        //HEI.22<<

        //Create Sales Line
        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);

        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;

        //Release
        SalesOrder.Release.INVOKE;

        //Create & Post Whse. Shipment
        WarehouseShipment.TRAP;
        // SalesOrder.Action149.INVOKE; //BC UPGRADE KUMARR78 Blocking As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder."Create &Warehouse Shipment".INVOKE; //BC UPGRADE KUMARR78 Adding As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        WarehouseShipment."Posting Date".SETVALUE(CALCDATE('<-1M>', WORKDATE));

        // WarehouseShipment.Action1100076703.INVOKE;//BC UPGRADE KUMARR78 DIT Action
        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke();//BC Upgrade VAMSIU01 Added
        //HEI.22>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseShipment."Shipping Agent Code".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseShipment."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);

        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.22<<

        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"

        //Post Sales Order
        SalesOrder.Post.INVOKE;
        COMMIT;

        //Create Reminder and Issue Reminder
        //HEI.22>>
        //CustomerNoFilter := Customer."No.";
        CustomerNoFilter := BillToCustomer."No.";
        //HEI.22<<
        ReminderList.OPENVIEW;
        ReminderList.CreateReminders.INVOKE;

        Reminder.OPENVIEW;
        //HEI.22>>
        //Reminder.FINDFIRSTFIELD("Customer No.",Customer."No.");
        //Reminder.FINDFIRSTFIELD("Posting Date",WORKDATE);
        Reminder.FILTER.SETFILTER("Customer No.", BillToCustomer."No.");
        Reminder.FILTER.SETFILTER("Posting Date", FORMAT(WORKDATE));
        //HEI.22<<
        DocNo := Reminder."No.".VALUE;
        Reminder.OK.INVOKE;

        //HEI.22>>
        //ReminderList.FINDFIRSTFIELD("No.",DocNo);
        ReminderList.FILTER.SETFILTER("No.", DocNo);
        //HEI.22<<
        ReminderList.Issue.INVOKE;

        //Step 2,3,4: Go to Issued Reminders Page
        IssuedReminder.OPENVIEW;

        //Step 5: Select the Reminder and Send by Email
        //HEI.22>>
        //IssuedReminder.FINDFIRSTFIELD("Pre-Assigned No.",DocNo);
        IssuedReminder.FILTER.SETFILTER("Pre-Assigned No.", DocNo);
        //HEI.22<<
        // IssuedReminder.Action5.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        IssuedReminder."Send by &Email".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //Step 6: Specify the email address of Customer and add body of email, then execute
        //Email Dialog Modal Page Handler
        IssuedReminder.OK.INVOKE;
        //HEI.11<<
    end;

    [Test]
    [HandlerFunctions('NoSeriesListModalPageHandler,ConfirmationHandler,MessageHandler,ShipInvoiceStrMenuHandler,CreateRemindersRequestPageHandler2,IssueReminderRequestPageHandler,ReminderRequestPageHandler')]
    //[HandlerFunctions('NoSeriesListModalPageHandler,ConfirmationHandler,MessageHandler,ShipInvoiceStrMenuHandler,CreateRemindersRequestPageHandler2,IssueReminderRequestPageHandler')]
    procedure OTC084_PrintReminderLetterFromTheProposal();
    var
        Customer: Record Customer;
        Item: Record Item;
        Location: Record Location;
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable
        Route: Record Route107FDW;
        // DocumentSubtypeCode: Record "2014472";//BC UPGRADE KUMARR78 Blocking DIT variable
        DocumentSubtypeCode: Record "Document Subtype Code FND"; // BC Upgrade PATELP08
        PaymentTerms: Record "Payment Terms";
        SalesOrder: TestPage "Sales Order";
        WarehouseShipment: TestPage "Warehouse Shipment";
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        SalesHeader: Record "Sales Header";
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        Workflow: Record Workflow;
        Reminder: TestPage Reminder;
        ReminderList: TestPage "Reminder List";
        ReportSelections: Record "Report Selections";
        IssuedReminder: TestPage "Issued Reminder";
        SalesReceivablesSetup: Record "Sales & Receivables Setup";
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        Truck: Record Vehicle101FDW;
        Driver: Record Driver107FDW;
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        Bin: Record Bin;
        ItemTrackingCode: Record "Item Tracking Code";
        BillToCustomer: Record Customer;
        CustomerAttributes: Record "Customer Attributes FND";
        ReminderLevel: Record "Reminder Level";
        Zone: Record Zone;
        CustomerPostingGroup: Record "Customer Posting Group";
        GLAccount: Record "G/L Account";
        GenProductPostingGroup: Record "Gen. Product Posting Group";
    begin
        ClearVariables('OTC084'); //HEI.31
        //HEI.11>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC084', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.58>>
        IF Customer."Contract Type FND" <> Customer."Contract Type FND"::" " THEN BEGIN
            Customer."Contract Type FND" := Customer."Contract Type FND"::" ";
            Customer.MODIFY;
        END;
        //HEI.58<<
        //HEI.22>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Customer."Purchasing Code" <> '' THEN
        //     Customer."Purchasing Code" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF Customer."Shipping Advice" = Customer."Shipping Advice"::Partial THEN
            Customer."Shipping Advice" := Customer."Shipping Advice"::Complete;
        Customer.MODIFY;

        IF Customer."Bill-to Customer No." <> '' THEN
            BillToCustomer.GET(Customer."Bill-to Customer No.")
        ELSE
            BillToCustomer.GET(Customer."No.");
        //HEI.23>>
        //IF BillToCustomer."Reminder Terms Code" = '' THEN BEGIN
        IF BillToCustomer."Reminder Terms Code" <> 'DOMESTIC' THEN
            //HEI.23<<
            BillToCustomer."Reminder Terms Code" := 'DOMESTIC';
        //HEI.23>>
        IF BillToCustomer."Currency Code" <> '' THEN
            BillToCustomer."Currency Code" := '';
        IF BillToCustomer."Application Method" = BillToCustomer."Application Method"::"Apply to Oldest" THEN
            BillToCustomer."Application Method" := BillToCustomer."Application Method"::Manual;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF BillToCustomer."Free Item" THEN
        //     BillToCustomer."Free Item" := FALSE;
        // IF BillToCustomer."Free Reason Code" <> '' THEN
        //     BillToCustomer."Free Reason Code" := '';
        // IF BillToCustomer."Gen. Bus. Posting Free Group" <> '' THEN
        //     BillToCustomer."Gen. Bus. Posting Free Group" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.23<<
        BillToCustomer.MODIFY;
        //END; //HEI.23
        IF CustomerAttributes.GET(BillToCustomer."No.") THEN BEGIN
            CustomerAttributes."Invoice Email Address" := 'OTC084@heineken.com';
            CustomerAttributes.MODIFY;
            //HEI.61>>
        END ELSE BEGIN
            CustomerAttributes.INIT;
            CustomerAttributes."Customer No." := BillToCustomer."No.";
            CustomerAttributes.INSERT;
            CustomerAttributes."Account Group" := BillToCustomer."Account Group FND";
            CustomerAttributes."Invoice Email Address" := 'OTC084@heineken.com';
            CustomerAttributes.MODIFY;
        END;
        //HEI.61<<
        //HEI.22<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC084', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);
        //HEI.50>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Item."Sales Price Warning" <> Item."Sales Price Warning"::"No Warning" THEN
        //     Item."Sales Price Warning" := Item."Sales Price Warning"::"No Warning";
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        IF Item."Unit Price" = 0 THEN
            Item."Unit Price" := 100;
        Item.MODIFY;
        //HEI.50<<

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC084', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        //HEI.23>>
        IF Location."Sales Gate Entry Mandatory FND" THEN BEGIN
            Location."Sales Gate Entry Mandatory FND" := FALSE;
            Location.MODIFY;
        END;
        //HEI.23<<

        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC084', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //HEI.22>>
        IF Route."Multiple Order Route" THEN
            Route."Multiple Order Route" := FALSE;
        //HEI.36>>
        // Route."Location Code" := Location.Code;
        // Route."Return Location Code" := Location.Code;
        //BC Upgrade VAMSIU01 replaced location code fields from route table with new fields >>
        Route."Shipping Location" := Location.Code;
        Route."Receipt Location" := Location.Code;
        //HEI.36<<
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //END; //HEI.36
        //HEI.22<<

        //Check default value for Document Subtype Code
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC084', COMPANYNAME, DATABASE::"Document Subtype Code FND");
        DocumentSubtypeCode.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Payment Terms
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC084', COMPANYNAME, DATABASE::"Payment Terms");
        PaymentTerms.GET(UnitTestingValues.Value);

        //HEI.22>>
        //Check the default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC084', COMPANYNAME, DATABASE::Bin);
        Bin.SETRANGE(Code, UnitTestingValues.Value);
        Bin.FINDFIRST;

        IF Location."Shipment Bin Code" <> Bin.Code THEN BEGIN
            Location."Shipment Bin Code" := Bin.Code;
            Location.MODIFY;
        END;

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC084', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Ship. Agent Serv. Mand. APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC084', COMPANYNAME, DATABASE::"Shipping Agent Services");
            ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value);
        END;

        //Check the default value for Driver
        IF Route."Driver Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC084', COMPANYNAME, DATABASE::Driver107FDW);
            Driver.GET(UnitTestingValues.Value);
        END;

        //Check the default value for Truck
        IF Route."Vehicle Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC084', COMPANYNAME, DATABASE::Vehicle101FDW);
            Truck.GET(UnitTestingValues.Value);
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Disable Notifications for Credit Limit and Stockout
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Activate CIS System FND" THEN
            SalesReceivablesSetup."Activate CIS System FND" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;

        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Strict Expiration Posting" THEN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;
        //HEI.22<<

        //HEI.23>>
        //Additional Fee on Reminder Level removed
        ReminderLevel.SETRANGE("Reminder Terms Code", BillToCustomer."Reminder Terms Code");
        ReminderLevel.SETFILTER("Additional Fee (LCY)", '>%1', 0);
        IF ReminderLevel.FINDSET THEN
            REPEAT
                ReminderLevel."Additional Fee (LCY)" := 0;
                ReminderLevel.MODIFY;
            UNTIL ReminderLevel.NEXT = 0
        ELSE BEGIN
            ReminderLevel.SETFILTER("Add. Fee per Line Amount (LCY)", '>%1', 0);
            IF ReminderLevel.FINDFIRST THEN
                REPEAT
                    ReminderLevel."Add. Fee per Line Amount (LCY)" := 0;
                    ReminderLevel.MODIFY;
                UNTIL ReminderLevel.NEXT = 0;
        END;

        //Disable Gate Control
        Zone.SETRANGE("Location Code", Location.Code);
        Zone.SETRANGE("Sales Gate Entry Mandatory FND", TRUE);
        IF Zone.FINDSET THEN
            REPEAT
                Zone."Sales Gate Entry Mandatory FND" := FALSE;
                Zone.MODIFY;
            UNTIL Zone.NEXT = 0;

        IF CustomerPostingGroup.GET(BillToCustomer."Customer Posting Group") THEN
            IF GLAccount.GET(CustomerPostingGroup."Invoice Rounding Account") THEN
                IF GenProductPostingGroup.GET(GLAccount."Gen. Prod. Posting Group") THEN
                    IF GenProductPostingGroup."Auto Insert Default" THEN BEGIN
                        GenProductPostingGroup."Auto Insert Default" := FALSE;
                        GenProductPostingGroup.MODIFY;
                    END;
        //HEI.23<<

        //Step 1: Login

        //Create and Post Invoice with Overdue
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        SalesOrder."No.".ASSISTEDIT;
        // SalesOrder."Document Subtype Code".SETVALUE(DocumentSubtypeCode.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);
        SalesOrder."Location Code".SETVALUE(Location.Code);
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Payment Terms Code".SETVALUE(PaymentTerms.Code);
        //HEI.55>>
        IF COMPANYNAME = '10_WIND_LEE_BR' THEN
            SalesOrder."Posting Date".SETVALUE(WORKDATE)
        ELSE
            SalesOrder."Posting Date".SETVALUE(CALCDATE('<-1M>', WORKDATE));
        //HEI.55<<
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);
        SalesOrder."External Document No.".SETVALUE('Unit Test OTC084');
        SalesOrderNo := SalesOrder."No.".VALUE;

        //HEI.22>>
        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38
        //HEI.22<<

        //Create Sales Line
        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        SalesOrder.SalesLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure");//BC UPGRADE VAMSIU01 Added

        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;

        //Release
        SalesOrder.Release.INVOKE;

        //Create & Post Whse. Shipment
        WarehouseShipment.TRAP;
        // SalesOrder.Action149.INVOKE; //BC UPGRADE KUMARR78 Blocking As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder."Create &Warehouse Shipment".INVOKE; //BC UPGRADE KUMARR78 Adding As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        WarehouseShipment."Posting Date".SETVALUE(CALCDATE('<-1M>', WORKDATE));

        // WarehouseShipment.Action1100076703.INVOKE;//BC UPGRADE KUMARR78 DIT Action
        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke();//BC Upgrade VAMSIU01 Added
        //HEI.22>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseShipment."Shipping Agent Code".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseShipment."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);

        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.22<<

        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"

        //Post Sales Order
        SalesOrder.Post.INVOKE;
        COMMIT;

        //Create Reminder and Issue Reminder
        //HEI.22>>
        //CustomerNoFilter := Customer."No.";
        CustomerNoFilter := BillToCustomer."No.";
        //HEI.22<<
        ReminderList.OPENVIEW;
        ReminderList.CreateReminders.INVOKE;

        Reminder.OPENVIEW;
        //HEI.22>>
        //Reminder.FINDFIRSTFIELD("Customer No.",Customer."No.");
        //Reminder.FINDFIRSTFIELD("Posting Date",WORKDATE);
        Reminder.FILTER.SETFILTER("Customer No.", BillToCustomer."No.");
        Reminder.FILTER.SETFILTER("Posting Date", FORMAT(WORKDATE));
        //HEI.22<<
        DocNo := Reminder."No.".VALUE;
        Reminder.OK.INVOKE;

        //HEI.22>>
        //ReminderList.FINDFIRSTFIELD("No.",DocNo);
        ReminderList.FILTER.SETFILTER("No.", DocNo);
        //HEI.22<<
        ReminderList.Issue.INVOKE;

        //Step 2,3,4: Go to Issued Reminders Page
        IssuedReminder.OPENVIEW;

        //Step 5: Select Reminder and click on Print
        //HEI.22>>
        //IssuedReminder.FINDFIRSTFIELD("Pre-Assigned No.",DocNo);
        IssuedReminder.FILTER.SETFILTER("Pre-Assigned No.", DocNo);
        //HEI.22<<

        //Check if Report Selection is configured for Reminder
        ReportSelections.SETRANGE(Usage, ReportSelections.Usage::Reminder);

        //Update the Report ID with 117 - Reminder
        IF ReportSelections.FINDFIRST THEN BEGIN
            ReportSelections.VALIDATE("Report ID", 117);
            ReportSelections.MODIFY;
        END ELSE BEGIN
            ReportSelections.INIT;
            ReportSelections.VALIDATE(Usage, ReportSelections.Usage::Reminder);
            ReportSelections.VALIDATE("Report ID", 117);
            ReportSelections.INSERT;
        END;

        COMMIT;
        // IssuedReminder.Action15.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        IssuedReminder."&Print".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name


        //Step 6: Execute
        //Reminder Modal Page Handler
        IssuedReminder.OK.INVOKE;
        //HEI.11<<
    end;

