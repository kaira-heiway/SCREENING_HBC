            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.17<<

        //Check default value for Document Subtype
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC008', COMPANYNAME, DATABASE::"Document Subtype Code FND");
        DocumentSubtypeCode.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //Step 1: Login

        //Step - Create New Sales Order
        SalesOrderList.OPENEDIT;
        SalesOrder.OPENNEW;
        SalesOrder.NEW;
        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);
        // SalesOrder."Document Subtype Code".SETVALUE(DocumentSubtypeCode.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Document Subtype Code".SETVALUE(DocumentSubtypeCode.Code);
        SalesOrderNo := SalesOrder."No.".VALUE;
        SalesOrder."Location Code".SETVALUE(Location.Code); //HEI.17
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);
        SalesOrder."External Document No.".SETVALUE('Unit Test OTC008');

        //HEI.17>>
        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38
        //HEI.17<<

        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        SalesOrder.SalesLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure");//Bc Upgrade VAMSIU01

        //HEI.17>>
        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;
        //HEI.17<<

        SalesOrder.Release.INVOKE;

        //Step - Create Warehouse Shipment
        // SalesOrder.Action149.INVOKE; //BC UPGRADE KUMARR78 Blocking As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder."Create &Warehouse Shipment".INVOKE; //BC UPGRADE KUMARR78 Adding As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"


        //Open Whse Shipment page
        WarehouseShipment.OPENVIEW;
        WarehouseShipment.FILTER.SETFILTER("Source No. FND", SalesOrder."No.".VALUE);
        // WarehouseShipment.Action1100076703.INVOKE;//BC UPGRADE KUMARR78 DIT Action
        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke();//BC Upgrade VAMSIU01 Added

        //HEI.17>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseShipment."Shipping Agent Code".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseShipment."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        WarehouseShipmentLine.SETRANGE("No.", WarehouseShipment."No.".VALUE);
        WarehouseShipmentLine.SETRANGE("Item No.", WarehouseShipment.WhseShptLines."Item No.".VALUE);
        IF WarehouseShipmentLine.FINDFIRST THEN BEGIN
            Zone.GET(Location.Code, WarehouseShipmentLine."Zone Code");
            IF Zone."Sales Gate Entry Mandatory FND" THEN BEGIN
                Zone."Sales Gate Entry Mandatory FND" := FALSE;
                Zone.MODIFY;
            END;
        END;
        //HEI.17<<

        //Release Whse. Shipment
        // WarehouseShipment.Action45.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        WarehouseShipment."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //Post Whse. Shipment
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"
        //HEI.17>>
        //SalesOrder.OK.INVOKE;
        //SalesOrderList.OK.INVOKE;
        //HEI.17<<
        //Step 1: Login

        //Step 2 - Open Job Queue Entries Page
        JobQueueEntries.OPENVIEW;

        //Step 3 - Create NEW Job Queue
        //JobQueueEntries.NEW; //HEI.17
        JobQueueEntryCard.OPENNEW;
        JobQueueEntryCard.NEW;

        //Step 4 - New queue for Batch Post Sales Orders is created
        JobQueueEntryCard."Object Type to Run".SETVALUE(JobQueueEntry."Object Type to Run"::Codeunit); //HEI.17
        JobQueueEntryCard."Object ID to Run".SETVALUE('88');

        //Steps 5 - Setup reoccurance
        JobQueueEntryCard."Earliest Start Date/Time".SETVALUE(TODAY);
        JobQueueEntryCard."Recurring Job".SETVALUE(TRUE);
        //HEI.17>>
        //COMMIT;
        //JobQueueEntryCard."Report Request Page Options".SETVALUE(TRUE);

        //Run the Report
        //JobQueueEntryCard.Action51.INVOKE;
        //HEI.17<<

        //Close Job Queue Entry Card
        JobQueueEntryCard.OK.INVOKE;

        //HEI.17>>
        //SalesHeader.SETFILTER("No.",SalesOrderNo);
        //COMMIT;
        //REPORT.RUNMODAL(296,FALSE,FALSE,SalesHeader);

        //CAL Limitation errors while testing from JQ. Used manual posting
        SalesOrder.Post.INVOKE;
        //HEI.17<<

        //Find posted invoice
        // PostedSalesInvoices.OPENVIEW;// BC Upgrade KUMARR78-- "Order No."(DIT 1105094122) is not a control on page so test-page filter fails at runtime
        // PostedSalesInvoices.FILTER.SETFILTER("Order No.", SalesOrderNo);// BC Upgrade KUMARR78--
        // PostedSalesInvoices."Order No.".ASSERTEQUALS(SalesOrderNo);// BC Upgrade KUMARR78--
        // PostedSalesInvoices.OK.INVOKE;// BC Upgrade KUMARR78--
        SalesInvoiceHeader.SETRANGE("Order No.", SalesOrderNo);// BC Upgrade KUMARR78++ verify posted invoice via record (matches other OTC tests)
        SalesInvoiceHeader.FINDFIRST;// BC Upgrade KUMARR78++
        //HEI.05>>
    end;

