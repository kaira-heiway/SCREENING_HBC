    procedure OTC152_CreateChequeJournalInHeiLiteNavisonForProcessing();
    var
        Customer: Record Customer;
        GenJournalTemplate: Record "Gen. Journal Template";
        GenJournalBatch: Record "Gen. Journal Batch";
        PaymentMethod: Record "Payment Method";
        GeneralLedgerSetup: Record "General Ledger Setup";
        GeneralJournalTemplates: TestPage "General Journal Templates";
        GeneralJournalBatches: TestPage "General Journal Batches";
        CashReceiptJournal: TestPage "Cash Receipt Journal";
        GenJournalLine: Record "Gen. Journal Line";
        DocumentNo: Code[20];
        GLAccount: Record "G/L Account";
    begin
        ClearVariables('OTC152'); //HEI.31
        //HEI.04>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC152', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF Customer."Application Method" = Customer."Application Method"::"Apply to Oldest" THEN BEGIN
            Customer."Application Method" := Customer."Application Method"::Manual;
            Customer.MODIFY;
        END;
        //HEI.19<<

        //Check default value for Journal Template
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC152', COMPANYNAME, DATABASE::"Gen. Journal Template");
        GenJournalTemplate.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF GenJournalTemplate."SO Cash Application FND" THEN BEGIN
            GenJournalTemplate."SO Cash Application FND" := FALSE;
            GenJournalTemplate.MODIFY;
        END;

        //Check default value for GL Account
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC152', COMPANYNAME, DATABASE::"G/L Account");
        GLAccount.GET(UnitTestingValues.Value);
        //HEI.19<<

        //Check default value for Journal Batch
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC152', COMPANYNAME, DATABASE::"Gen. Journal Batch");
        GenJournalBatch.GET(GenJournalTemplate.Name, UnitTestingValues.Value);

        //Check default value for Movement Type Dimension Value Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC152', COMPANYNAME, DATABASE::"Dimension Value");
        GeneralLedgerSetup.GET;
        DimensionValue.GET(GeneralLedgerSetup."Shortcut Dimension 3 Code", UnitTestingValues.Value);

        //Check default value for Payment Method
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC152', COMPANYNAME, DATABASE::"Payment Method");
        PaymentMethod.GET(UnitTestingValues.Value);

        //HEI.31>>
        //Update Payment Method Code on Customer
        Customer."Payment Method Code" := PaymentMethod.Code;
        Customer.MODIFY;
        //HEI.31>>

        //Disable Gen. Journal Batch Approval Workflow
        //HEI.79>>
        DisableGenJournalBatchApprovalWorkflow(GenJournalBatch);
        //HEI.79<<

        //Step 1: Login

        //Step 2,3: Access Cash Receipt Journal
        GeneralJournalTemplates.OPENVIEW;

        //Step 4: Choose Template
        GeneralJournalBatches.TRAP;
        //HEI.19>>
        //GeneralJournalTemplates.FINDFIRSTFIELD(Name,GenJournalTemplate.Name);
        GeneralJournalTemplates.FILTER.SETFILTER(Name, GenJournalTemplate.Name);
        //HEI.19<<

        // GeneralJournalTemplates."Page General Journal Batches".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GeneralJournalTemplates."Batches".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //Step 5: Choose Batch
        CashReceiptJournal.TRAP;
        //HEI.19>>
        //GeneralJournalBatches.FINDFIRSTFIELD(Name,GenJournalBatch.Name);
        GeneralJournalBatches.FILTER.SETFILTER(Name, GenJournalBatch.Name);
        //HEI.19<<
        GeneralJournalBatches.EditJournal.INVOKE;

        //Remove existing lines in Journal to avoid errors
        GenJournalLine.SETRANGE("Journal Template Name", GenJournalTemplate.Name);
        GenJournalLine.SETRANGE("Journal Batch Name", GenJournalBatch.Name);
        IF GenJournalLine.FINDSET THEN //HEI.19
            GenJournalLine.DELETEALL;

        //Step 6: Create Journal Line
        CashReceiptJournal.NEW;

        //Document Type = Payment
        CashReceiptJournal."Document Type".SETVALUE(1);

        //Document No = (auto)
        DocumentNo := CashReceiptJournal."Document No.".VALUE;
        IF DocumentNo = '' THEN
            //HEI.19>>
            //ERROR('Document No. not setup.');
            CashReceiptJournal."Document No.".SETVALUE('OTC152');
        DocumentNo := CashReceiptJournal."Document No.".VALUE;
        //HEI.19<<

        //Account Type = Customer
        CashReceiptJournal."Account Type".SETVALUE(1);

        //Account No
        CashReceiptJournal."Account No.".SETVALUE(Customer."No.");

        //HEI.19>>
        CashReceiptJournal."External Document No.".SETVALUE('OTC152');
        IF GenJournalBatch."Bal. Account No." = '' THEN BEGIN
            CashReceiptJournal."Bal. Account Type".SETVALUE(0);
            CashReceiptJournal."Bal. Account No.".SETVALUE(GLAccount."No.");
        END;
        //HEI.19<<

        //Amount
        CashReceiptJournal.Amount.SETVALUE(-100);

        //Payment Method = Cheque
        //CashReceiptJournal."Payment Method Code".SETVALUE(PaymentMethod.Code); //HEI.31

        //HEI.19>>
        IF GenJournalBatch."Bal. Account No." = '' THEN BEGIN
            CashReceiptJournal."Bal. Account Type".ASSERTEQUALS(0);
            CashReceiptJournal."Bal. Account No.".ASSERTEQUALS(GLAccount."No.");
        END ELSE BEGIN
            //Bal Account Type (auto - template)
            CashReceiptJournal."Bal. Account Type".ASSERTEQUALS(GenJournalBatch."Bal. Account Type");
            //Bal Account No (auto - template)
            CashReceiptJournal."Bal. Account No.".ASSERTEQUALS(GenJournalBatch."Bal. Account No.");
        END;
        //HEI.19<<

        //Step 7: Add MVMT type if necessary
        // CashReceiptJournal.Action60.INVOKE;Blocking As Action Name Changed
        CashReceiptJournal.Dimensions.INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //Step 8: Post
        CashReceiptJournal.Post.INVOKE;
    end;

    [Test]
    [HandlerFunctions('ConfirmationHandler,MessageHandler')]
    procedure OTC153_PostCustomerChequesOnCustomerAccountBasedOnTheReferenceData();
    var
        Customer: Record Customer;
        Customer2: Record Customer;
        GenJournalTemplate: Record "Gen. Journal Template";
        GenJournalBatch: Record "Gen. Journal Batch";
        PaymentMethod: Record "Payment Method";
        GeneralJournalTemplates: TestPage "General Journal Templates";
        GeneralJournalBatches: TestPage "General Journal Batches";
        CashReceiptJournal: TestPage "Cash Receipt Journal";
        GenJournalLine: Record "Gen. Journal Line";
        GLAccount: Record "G/L Account";
    begin
        ClearVariables('OTC153'); //HEI.31
        //HEI.04>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC153', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF Customer."Application Method" = Customer."Application Method"::"Apply to Oldest" THEN
            Customer."Application Method" := Customer."Application Method"::Manual;
        Customer."Payment Method Code" := PaymentMethod.Code; //HEI.38
        Customer.MODIFY;
        //END; //HEI.38
        //HEI.19<<

        //Check default value for second Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC153', COMPANYNAME, DATABASE::Customer);
        Customer2.GET(UnitTestingValues."Value 2");
        //HEI.19>>
        IF Customer2."No." <> Customer."No." THEN BEGIN //HEI.38
            IF Customer2."Application Method" = Customer2."Application Method"::"Apply to Oldest" THEN
                Customer2."Application Method" := Customer2."Application Method"::Manual;
            Customer2."Payment Method Code" := PaymentMethod.Code; //HEI.38
            Customer2.MODIFY;
        END;
        //HEI.19<<

        //Check default value for Journal Template
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC153', COMPANYNAME, DATABASE::"Gen. Journal Template");
        GenJournalTemplate.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF GenJournalTemplate."SO Cash Application FND" THEN BEGIN
            GenJournalTemplate."SO Cash Application FND" := FALSE;
            GenJournalTemplate.MODIFY;
        END;

        //Check default value for GL Account
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC153', COMPANYNAME, DATABASE::"G/L Account");
        GLAccount.GET(UnitTestingValues.Value);
        //HEI.19<<

        //Check default value for Journal Batch
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC153', COMPANYNAME, DATABASE::"Gen. Journal Batch");
        GenJournalBatch.GET(GenJournalTemplate.Name, UnitTestingValues.Value);

        //Check default value for Payment Method
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC153', COMPANYNAME, DATABASE::"Payment Method");
        PaymentMethod.GET(UnitTestingValues.Value);

        //HEI.31>>
        //Update Payment Method Code on Customer
        //HEI.38>>
        //Customer."Payment Method Code" := PaymentMethod.Code;
        //Customer.MODIFY;
        //Customer2."Payment Method Code" := PaymentMethod.Code;
        //Customer2.MODIFY;
        //HEI.38<<
        //HEI.31>>

        //Disable Gen. Journal Batch Approval
        //HEI.79>>
        DisableGenJournalBatchApprovalWorkflow(GenJournalBatch);
        //HEI.79<<

        //Step 1: Login

        //Step 2,3,4: Access Cash Receipt Journal
        GeneralJournalTemplates.OPENVIEW;

        //Step 5: Choose Template
        GeneralJournalBatches.TRAP;
        //HEI.19>>
        //GeneralJournalTemplates.FINDFIRSTFIELD(Name,GenJournalTemplate.Name);
        GeneralJournalTemplates.FILTER.SETFILTER(Name, GenJournalTemplate.Name);
        //HEI.19<<

        // GeneralJournalTemplates."Page General Journal Batches".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GeneralJournalTemplates."Batches".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //Choose Batch
        CashReceiptJournal.TRAP;
        //HEI.19>>
        //GeneralJournalBatches.FINDFIRSTFIELD(Name,GenJournalBatch.Name);
        GeneralJournalBatches.FILTER.SETFILTER(Name, GenJournalBatch.Name);
        //HEI.19<<
        GeneralJournalBatches.EditJournal.INVOKE;

        //Remove existing lines in Journal to avoid errors
        GenJournalLine.SETRANGE("Journal Template Name", GenJournalTemplate.Name);
        GenJournalLine.SETRANGE("Journal Batch Name", GenJournalBatch.Name);
        IF GenJournalLine.FINDSET THEN //HEI.19
            GenJournalLine.DELETEALL;

        //Step 6: Create Journal Lines and post
        CashReceiptJournal.NEW;
        CashReceiptJournal."Document Type".SETVALUE(1);
        //HEI.19>>
        IF CashReceiptJournal."Document No.".VALUE = '' THEN
            CashReceiptJournal."Document No.".SETVALUE('OTC153');
        IF GenJournalBatch."Bal. Account No." = '' THEN BEGIN
            CashReceiptJournal."Bal. Account Type".SETVALUE(0);
            CashReceiptJournal."Bal. Account No.".SETVALUE(GLAccount."No.");
        END;
        CashReceiptJournal."External Document No.".SETVALUE('OTC153');
        //HEI.19<<
        CashReceiptJournal."Account Type".SETVALUE(1);
        CashReceiptJournal."Account No.".SETVALUE(Customer."No.");
        CashReceiptJournal.Amount.SETVALUE(-100);
        //CashReceiptJournal."Payment Method Code".SETVALUE(PaymentMethod.Code); //HEI.31

        CashReceiptJournal.NEW;
        CashReceiptJournal."Document Type".SETVALUE(1);
        //HEI.19>>
        IF CashReceiptJournal."Document No.".VALUE = '' THEN
            CashReceiptJournal."Document No.".SETVALUE('OTC153');
        IF GenJournalBatch."Bal. Account No." = '' THEN BEGIN
            CashReceiptJournal."Bal. Account Type".SETVALUE(0);
            CashReceiptJournal."Bal. Account No.".SETVALUE(GLAccount."No.");
        END;
        CashReceiptJournal."External Document No.".SETVALUE('OTC153_2');
        //HEI.19<<
        CashReceiptJournal."Account Type".SETVALUE(1);
        CashReceiptJournal."Account No.".SETVALUE(Customer2."No.");
        CashReceiptJournal.Amount.SETVALUE(-200);
        //CashReceiptJournal."Payment Method Code".SETVALUE(PaymentMethod.Code); //HEI.31

        //Post
        CashReceiptJournal.Post.INVOKE;
    end;

