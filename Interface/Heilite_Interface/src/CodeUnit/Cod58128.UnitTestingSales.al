        SalesInvoiceHeader: Record "Sales Invoice Header";
        SalesOrderNoNew: Code[20];
        PostedSalesInvoiceList: TestPage "Posted Sales Invoices";
        PostedSalesInvNo: Code[20];
        PostedSalesInvoice: TestPage "Posted Sales Invoice";
        PostedSalesInvNoNew: Code[20];
        SalesSetup: Record "Sales & Receivables Setup";
        CashCollList: TestPage "Cash Collections List";
        CashCollCard: TestPage "Cash Collections";
        CashCollLines: TestPage "Cash Collection Lines";
        CashCollLineRec: Record "Cash Collection Line FND";
        IssueNo: Code[50];
        PostedIssueNo: Code[50];
        // ShippingTruck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        // ShippingDriver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        ShippingTruck: Record Vehicle101FDW;
        ShippingDriver: Record Driver107FDW;
        ShippingAgent: Record "Shipping Agent";
        IssueCashColl: Report "Issue Cash Collection";
        IssuedCashCollRec: Record "Issue Cash Collection Head FND";
        CashCollIssueReport: Report "Issue Cash Collection";
        SalesReturnOrder: TestPage "Sales Return Order";
        ShippingAgentServices: Record "Shipping Agent Services";
        Location: Record Location;
        Bin: Record Bin;
        BillToCustomer: Record Customer;
        ItemTrackingCode: Record "Item Tracking Code";
        Zone: Record Zone;
        SalesPrice: Record "Sales Price";
    begin
        ClearVariables('OTC091'); //HEI.31
        //HEI.30<<
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC091', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Customer."Purchasing Code" <> '' THEN
        //     Customer."Purchasing Code" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF Customer."Shipping Advice" = Customer."Shipping Advice"::Partial THEN
            Customer."Shipping Advice" := Customer."Shipping Advice"::Complete;
        Customer."Credit Limit (LCY)" := 999999;   //HEI.35
        Customer.MODIFY;

        IF Customer."Bill-to Customer No." <> '' THEN
            BillToCustomer.GET(Customer."Bill-to Customer No.")
        ELSE
            BillToCustomer.GET(Customer."No.");
        IF BillToCustomer."Currency Code" <> '' THEN
            BillToCustomer."Currency Code" := '';
        IF BillToCustomer."Application Method" = BillToCustomer."Application Method"::"Apply to Oldest" THEN
            BillToCustomer."Application Method" := BillToCustomer."Application Method"::Manual;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF BillToCustomer."Free Item" THEN
        //     BillToCustomer."Free Item" := FALSE;
        // IF BillToCustomer."Free Reason Code" <> '' THEN
        //     BillToCustomer."Free Reason Code" := '';
        // IF BillToCustomer."Gen. Bus. Posting Free Group" <> '' THEN
        //     BillToCustomer."Gen. Bus. Posting Free Group" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        BillToCustomer.MODIFY;

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC091', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);
        //HEI.50>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Item."Sales Price Warning" <> Item."Sales Price Warning"::"No Warning" THEN
        //     Item."Sales Price Warning" := Item."Sales Price Warning"::"No Warning";
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        IF Item."Unit Price" = 0 THEN
            Item."Unit Price" := 100;
        Item.MODIFY;
        //HEI.50<<

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC091', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        IF Location."Sales Gate Entry Mandatory FND" THEN BEGIN
            Location."Sales Gate Entry Mandatory FND" := FALSE;
            Location.MODIFY;
        END;

        //Check the default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC091', COMPANYNAME, DATABASE::Bin);
        Bin.SETRANGE(Code, UnitTestingValues.Value);
        Bin.FINDFIRST;

        IF Location."Shipment Bin Code" <> Bin.Code THEN
            Location."Shipment Bin Code" := Bin.Code;
        Location.MODIFY;

        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC091', COMPANYNAME, DATABASE::Route107FDW);
        //Route.GET(UnitTestingValues.Value);         //HEI.37
        IF Route.GET(UnitTestingValues.Value) THEN BEGIN   //HEI.37
            IF Route."Multiple Order Route" THEN
                Route."Multiple Order Route" := FALSE;
            //HEI.36>>
            Route."Shipping Location" := Location.Code;
            Route."Receipt Location" := Location.Code;
            //HEI.36<<
            Route.MODIFY;
        END; //HEI.36  //HEI.37
        //Check default value for Whse. Shipping Truck
        IF Route."Vehicle Mandatory APS" THEN BEGIN     //HEI.35
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC091', COMPANYNAME, DATABASE::Vehicle101FDW);
            ShippingTruck.GET(UnitTestingValues.Value);
        END;      //HEI.35
        //Check default value for Whse. Shipping Driver
        IF Route."Driver Mandatory APS" THEN BEGIN    //HEI.35
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC091', COMPANYNAME, DATABASE::Driver107FDW);
            ShippingDriver.GET(UnitTestingValues.Value);
        END;    //HEI.35
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Shipping Agent
        //IF Route."Shipping Agent Code Mantatory" THEN BEGIN   //HEI.35  //HEI.37
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC091', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;
        //END;    //HEI.35  //HEI.37

        //Check the default value for Shipping Agent Services

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Ship. Agent Serv. Mand. APS" THEN BEGIN    //HEI.35
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC091', COMPANYNAME, DATABASE::"Shipping Agent Services");
            ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value);
        END;    //HEI.35
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Disable Notifications for Credit Limit and Stockout
        SalesSetup.GET;
        IF SalesSetup."Credit Warnings" <> SalesSetup."Credit Warnings"::"No Warning" THEN
            SalesSetup."Credit Warnings" := SalesSetup."Credit Warnings"::"No Warning";
        IF SalesSetup."Stockout Warning" THEN
            SalesSetup."Stockout Warning" := FALSE;
        IF SalesSetup."Activate CIS System FND" THEN
            SalesSetup."Activate CIS System FND" := FALSE;
        IF SalesSetup."Item Avlblty Msg Enable FND" THEN
            SalesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesSetup.MODIFY;

        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Strict Expiration Posting" THEN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        //Disable Gate Control
        Zone.SETRANGE("Location Code", Location.Code);
        Zone.SETRANGE("Sales Gate Entry Mandatory FND", TRUE);
        IF Zone.FINDSET THEN
            REPEAT
                Zone."Sales Gate Entry Mandatory FND" := FALSE;
                Zone.MODIFY;
            UNTIL Zone.NEXT = 0;

        //Step 1: Login

        //Step 2 - Open Sales Order List Page
        SalesOrderList.OPENEDIT;

        //Step 3 - Create NEW Sales Order
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        //Step 4 - AssitEdit to create the Document No. & Add Customer No.
        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);

        //Steps 5, 6 & 7 - Add Route, Shipment Date and External Document No.
        SalesOrder."Location Code".SETVALUE(Location.Code);
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Posting Date".SETVALUE(CALCDATE('<-1M>', WORKDATE));
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);
        //SalesOrder."External Document No.".SETVALUE('Unit Test OTC091_' + SalesOrder."No.".VALUE);  //HEI.33
        SalesOrder."External Document No.".SETVALUE('OTC091_' + SalesOrder."No.".VALUE);  //HEI.33

        //Steps 8 & 10 - Create Sales Line: No., Quantity
        //Step 9 = Location + Bin -> come from setup
        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        SalesOrder.SalesLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure");//BC Upgrade VAMSIU01 added
        //HEI.37<<
        IF SalesOrder.SalesLines."Unit Price".VALUE = '' THEN BEGIN
            CLEAR(SalesPrice);
            SalesPrice.VALIDATE("Item No.", Item."No.");
            SalesPrice.VALIDATE("Sales Type", SalesPrice."Sales Type"::Customer);
            SalesPrice.VALIDATE("Sales Code", Customer."No.");
            SalesPrice.VALIDATE("Unit Price", 1);
            SalesPrice.INSERT(TRUE);

            SalesOrder.SalesLines.Quantity.SETVALUE(2);
        END;
        //HEI.37>>

        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;

        //Assigning Posting No. Series
        SalesSetup.GET;
        SalesHeader."Posting No. Series" := SalesSetup."Posted Invoice Nos.";
        SalesHeader.MODIFY;

        IF Customer."Return Order Mandatory FND" THEN BEGIN
            SalesReturnOrder.TRAP;

            // SalesOrder.Action1100083005.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
            SalesOrder."Cre&ate/Modify Return Order".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

            SalesReturnOrder.CLOSE;
        END;

        //Step 10 - Release Sales Order
        SalesOrder.Release.INVOKE;
        SalesOrderNo := SalesOrder."No.".VALUE;

        //Step 11 - Create Warehouse Shipment
        WarehouseShipment.TRAP;
        // SalesOrder.Action149.INVOKE; //BC UPGRADE KUMARR78 Blocking As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder."Create &Warehouse Shipment".INVOKE; //BC UPGRADE KUMARR78 Adding As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"

        //Step 12 - Open Whse Shipment page
        //Auto-FEFO
        WarehouseShipment."Posting Date".SETVALUE(CALCDATE('<-1M>', WORKDATE));

        //BC Upgrade PATELP08 >> Adding - DIT action 1100076703 autofilled Qty. to Ship before FEFO; the v28 standard FEFO action only assigns lot tracking and does NOT autofill, leaving Qty. to Ship = 0 ("nothing to post"). Restore the standard Autofill Qty. to Ship.
        WarehouseShipment."Autofill Qty. to Ship".INVOKE;
        //BC Upgrade PATELP08 <<

        // WarehouseShipment.Action1100076703.INVOKE;//BC UPGRADE KUMARR78 DIT Action
        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke();//BC Upgrade VAMSIU01 Added

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseShipment."Shipping Agent Code".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseShipment."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(ShippingDriver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(ShippingTruck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Step 13 - Release Whse. Shipment
        // WarehouseShipment.Action45.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        WarehouseShipment."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //Step 14 - Post Whse. Shipment
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"

        //Step 15 - Post Sales Order
        SalesOrder.Post.INVOKE;

        //Find the Posted Sales Invoice
        SalesInvoiceHeader.SETRANGE("Order No.", SalesOrderNo);
        SalesInvoiceHeader.FINDFIRST;

        PostedSalesInvNo := SalesInvoiceHeader."No.";

        //Step 16 - Open the Posted Sales Invoice
        PostedSalesInvoiceList.OPENVIEW;
        PostedSalesInvoiceList.FILTER.SETFILTER("No.", PostedSalesInvNo);
        PostedSalesInvNoNew := PostedSalesInvoiceList."No.".VALUE;
        PostedSalesInvoiceList.VIEW.INVOKE;

        CashCollList.OPENEDIT;
        CashCollCard.OPENNEW;
        CashCollCard.NEW;
        // CashCollCard.v.ASSISTEDIT;//BC UPGRADE KUMARR78 Blocking As Field Name Changed
        //BC Upgrade PATELP08 >> Blocking - Tab50023 AssistEdit calls No. Series.GetNextNo with empty "No. Series Code" (DIT AssistEdit bug); No. is auto-assigned by OnInsert from Reminder Nos.
        // CashCollCard."No.".ASSISTEDIT;//BC UPGRADE KUMARR78 Adding with Change Field Name
        //BC Upgrade PATELP08 <<
        IF Customer."Bill-to Customer No." <> '' THEN
            CashCollCard."Customer No.".SETVALUE(Customer."Bill-to Customer No.")
        ELSE
            CashCollCard."Customer No.".SETVALUE(Customer."No.");

        CashCollCard."Cash Collection lines".NEW;
        CashCollCard."Cash Collection lines".Type.SETVALUE(CashCollLineRec.Type::"Customer Ledger Entry");
        //BC Upgrade PATELP08 >> Blocking - KUMARR78 changed Tab50024 "Document Type" OptionMembers from " ",,Invoice (Invoice=2) to " ",Invoice (Invoice=1). Document No. OnValidate passes this ordinal to Cust. Ledger Entry."Document Type" where 1=Payment, 2=Invoice -> filters for Payment -> invoice CLE excluded -> "no open CLE". Leaving line Document Type=0 skips the filter; invoice found by Customer No.+Open+Document No.
        // CashCollCard."Cash Collection lines"."Document Type".SETVALUE(CashCollLineRec."Document Type"::Invoice);
        //BC Upgrade PATELP08 <<
        CashCollCard."Cash Collection lines"."Document No.".SETVALUE(PostedSalesInvNoNew);

        IF ShippingAgent.Code <> '' THEN                                      //HEI.37
            CashCollCard."Shipping Agent Code".SETVALUE(ShippingAgent.Code);    //HEI.37

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF ShippingTruck.Code <> '' THEN                                      //HEI.37
            CashCollCard."Truck Code".SETVALUE(ShippingTruck.Code);
        IF ShippingDriver.Code <> '' THEN                                     //HEI.37
            CashCollCard."Driver Code".SETVALUE(ShippingDriver.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //CashCollCard."Shipping Agent Code".SETVALUE(ShippingAgent.Code);    //HEI.37

        // IssueNo := CashCollCard.v.VALUE;//BC UPGRADE KUMARR78 Blocking As Field Name Changed
        IssueNo := CashCollCard."No.".VALUE;//BC UPGRADE KUMARR78 Adding with Change Field Name

        // IssueNoNew := CashCollCard.v.VALUE;//BC UPGRADE KUMARR78 Blocking As Field Name Changed
        IssueNoNew := CashCollCard."No.".VALUE;//BC UPGRADE KUMARR78 Adding with Change Field Name

        CashCollCard.OK.INVOKE;
        CashCollList.OK.INVOKE;

        CashCollList.OPENEDIT;
        CashCollList.FILTER.SETFILTER("No.", IssueNo);
        COMMIT;

        CashCollList.Issue.INVOKE;

        IssuedCashCollRec.RESET;
        IssuedCashCollRec.SETFILTER("Pre-Assigned No.", IssueNo);
        IssuedCashCollRec.FINDFIRST;

        //HEI.30>>
    end;

