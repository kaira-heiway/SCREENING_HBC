        // SalesHeader.SETFILTER("External Document No.", DocNo);
        // SalesHeader.FINDFIRST;

        //Step 6:Complete picking, loading and shipping process
        //Step 7:Post warehouse shipment
        //Step 8:Sales order Invoice needs to be created

        //Step 9: Go to other IC Legal entity 1 where PO was created and check in the menu Posted Purchase Receipts if the Warehouse receipt was created and posted.
        //Step 10:"Posted purchase invoice  should be created in the corresponding buying company  (depending on GL setup)
        //The generated posted purchase invoice has Vendor Invoice no from the sales invoice from the other company.
    end;


