        CustomerNo: Code[20];
        GeneralLedgerSetup: Record "General Ledger Setup";
        ApprovalRequestNotSentMsg: Label 'Approval Request not sent.';
    begin
        ClearVariables('SLS010'); //HEI.31
        //HEI.21>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::Customer);
        BillToCustomer.GET(UnitTestingValues.Value);

        //Check default value for Account Group Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Account Group FND");
        AccountGroup.GET(UnitTestingValues.Value);
        AccountGroupCode := AccountGroup.Code;

        //Check default value for Service Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Service Zone");
        ServiceZone.GET(UnitTestingValues.Value);

        //Check default values for Permission Set
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Permission Set");
        PermissionSet.GET(UnitTestingValues.Value);

        //Check default value for Shipment Method
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Shipment Method");
        ShipmentMethod.GET(UnitTestingValues.Value);

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Shipping Agent Services");
        IF ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value) THEN;

        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG081', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);

        //Check default value for Delivery Type
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::DeliveryType107FDW);
        // DeliveryType.GET(DeliveryType.Type::Customer, UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Language
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::Language);
        Language.GET(UnitTestingValues.Value);

        //Check default value for License Type
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"License Type FND");
        IF LicenseType.GET(UnitTestingValues.Value) THEN;

        //Check default value for Business Segment
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Business Segment FND");
        BusinessSegment.GET(UnitTestingValues.Value);

        //Check default value for Business Organizational Segment
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Business Org Segment FND");
        BusinessOrganizationalSegment.GET(UnitTestingValues.Value);

        //Check default value for Customer Type
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Customer Type FND");
        CustomerType.GET(UnitTestingValues.Value);

        //Check default value for Customer Sub-Type/Channel
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Customer Sub-Type FND");
        IF CustomerSubType.GET(UnitTestingValues.Value) THEN;

        //Check default value for Local Customer Sub Type/Channel
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Local Customer Sub-Type FND");
        IF LocalCustomerSubType.GET(UnitTestingValues.Value) THEN;

        //Check default value for Dimension Values
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS010', COMPANYNAME, DATABASE::"Dimension Value");
        GeneralLedgerSetup.GET;
        DimensionValue.GET(GeneralLedgerSetup."Global Dimension 1 Code", UnitTestingValues.Value);
        DimensionValue2.GET(GeneralLedgerSetup."Shortcut Dimension 3 Code", UnitTestingValues."Value 2");
        DimensionValue3.GET(GeneralLedgerSetup."Shortcut Dimension 5 Code", UnitTestingValues."Value 3");

        DimensionValue4.SETRANGE("Dimension Code", GeneralLedgerSetup."Shortcut Dimension 6 Code");
        DimensionValue4.SETRANGE(Blocked, FALSE);
        IF DimensionValue4.FINDFIRST THEN;

        DimensionValue5.SETRANGE("Dimension Code", GeneralLedgerSetup."Shortcut Dimension 7 Code");
        DimensionValue5.SETRANGE(Blocked, FALSE);
        IF DimensionValue5.FINDFIRST THEN;

        //Step 1,2,3 - Logon and Open Customer List
        CustomerList.OPENVIEW;

        //Step 4 - Create new Customer
        //CustomerCard.OPENEDIT;//BC UPGRADE ATHUKS01
        CustomerCard.OpenNew();//BC UPGRADE ATHUKS01
        CustomerCard.NEW;

        //Step 5 - Choose the Customer Template for Outlet Customer
        //Choice is made using CustomerTemplateModalHandler
        CustomerCard."Account Group FND".SETVALUE(AccountGroup.Code);

        //Step 6- Enter data
        //Name
        CustomerCard.Name.SETVALUE('Name SLS010');
        //Search Name
        CustomerCard."Search Name".SETVALUE('Search Name SLS010');
        //Name 2
        CustomerCard."Name 2".SETVALUE('Name2 SLS010');
        //Address
        CustomerCard.Address.SETVALUE('Address SLS010');
        //Address 2
        CustomerCard."Address 2".SETVALUE('Address2 SLS010');
        //City
        CustomerCard.City.SETVALUE('Amsterdam');
        //Country/Region Code
        CompanyInformation.GET;
        CustomerCard."Country/Region Code".SETVALUE(CompanyInformation."Country/Region Code");
        //Blocked comes from template
        //Post Code
        CustomerCard."Post Code".SETVALUE('SLS010');
        //County
        CustomerCard.County.SETVALUE('SLS010');
        //Service Zone Code
        CustomerCard."Service Zone Code".SETVALUE(ServiceZone.Code);

        //Step 7 - Communication
        //Phone No.
        CustomerCard."Phone No.".SETVALUE('012345');
        //Fax No.
        CustomerCard."Fax No.".SETVALUE('0123456');
        //E-Mail
        CustomerCard."E-Mail".SETVALUE('sls010@heineken.com');
        //Bill-to Customer No.
        CustomerCard."Bill-to Customer No.".SETVALUE(BillToCustomer."No.");

        //Shipping
        //Shipment Method Code
        CustomerCard."Shipment Method Code".SETVALUE(ShipmentMethod.Code);
        //Shipping Agent Code
        IF ShippingAgent.Code <> '' THEN
            CustomerCard."Shipping Agent Code".SETVALUE(ShippingAgent.Code);
        //Combine Shipments
        CustomerCard."Combine Shipments".SETVALUE(TRUE);
        //Reserve
        CustomerCard.Reserve.SETVALUE(1);
        //Shipping Advice
        CustomerCard."Shipping Advice".SETVALUE(0);
        //Shipping Time
        CustomerCard."Shipping Time".SETVALUE('1D');
        //Shipping Agent Service Code
        IF ShippingAgentServices.Code <> '' THEN
            CustomerCard."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);
        //Truck Zone

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        //CustomerCard."Truck Zone ".SETVALUE(1);
        CustomerCard."Unload Zone Right 107FDW".SETVALUE(1);
        //Shipment Date Formula
        // CustomerCard."Shipment Date Formula".SETVALUE('1D');
        CustomerCard."Shipping Time".SETVALUE('1D');
        //Require 2 Drivers
        CustomerCard."LOG Two Drivers 107FDW".SETVALUE(TRUE);
        //Customer Delivery Type
        CustomerCard."Delivery Type 107FDW".SETVALUE(DeliveryType.Code);
        //Distance
        //CustomerCard.Distance.SETVALUE(10);
        //Route
        CustomerCard."Default Route 107FDW".SETVALUE(Route.Code);
        //Delivery Note Copies
        // CustomerCard."Delivery Note Copies".SETVALUE(2);

        //Delivery Sequence
        //CustomerCard."Delivery Sequence".SETVALUE(5);
        CustomerCard."LOG DeliveryTimes 107FDW".SETVALUE(5);
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //Foreing Trade
        //Language Code
        CustomerCard."Language Code".SETVALUE(Language.Code);
        //VAT Registration No.
        CustomerCard."VAT Registration No.".SETVALUE('123456');

        //Drink-It
        //Tax Registration Number
        CustomerCard."Tax Registration Number".SETVALUE(10);
        //Tax Registration No.
        // CustomerCard."Tax Registration No.".SETVALUE('12345');//BC UPGRADE KUMARR78 >> Blocking DIT Code
        //Customer DDeposit Group
        // CustomerCard."Customer DDeposit Group Code".SETVALUE('DOM');//BC UPGRADE KUMARR78 >> Blocking DIT Code

        //Step 8 - Not Visible
        //Location Code
        CustomerCard."Location Code".SETVALUE(Location.Code);
        //Tax Office Code
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF TaxOffice."No." <> '' THEN
            CustomerCard."Tax Office Code 102FDW".SETVALUE(TaxOffice."No.");//BC UPGRADE ATHUKS01 
                                                                            // BC UPGRADE KUMARR78 << Blocking DIT Code
                                                                            //Approval for Alcohol
        CustomerCard."Approval Of Alcohol".SETVALUE(TRUE);
        //Picking Type
        // CustomerCard."Picking Type".SETVALUE(1);//BC UPGRADE KUMARR78 >> Blocking DIT Code

        CustomerNo := CustomerCard."No.".VALUE;
        CustomerCard.OK.INVOKE;

        CustomerCard.OPENEDIT;
        CustomerCard.FILTER.SETFILTER("No.", CustomerNo);
        //Customer Attributes
        CustomerAttributesCard.TRAP;
        CustomerCard."Customer Attributes".INVOKE;
        //CustomerAttributesCard.OPENEDIT;
        //Different City
        CustomerAttributesCard."Different City".SETVALUE('Paris');
        //District
        CustomerAttributesCard.District.SETVALUE('SLS010');
        //House number 1
        CustomerAttributesCard."House No. 1".SETVALUE('1');
        //House number Supplement (2)
        CustomerAttributesCard."House Supplement 2".SETVALUE('0');
        //Name 3
        CustomerAttributesCard."Name 3".SETVALUE('Name 3 SLS010');
        //Name 4
        CustomerAttributesCard."Name 4".SETVALUE('Name 4 SLS010');
        //Street 3
        CustomerAttributesCard."Street 3".SETVALUE('Street 3 SLS010');
        //Street 4
        CustomerAttributesCard."Street 4".SETVALUE('Street 4 SLS010');
        //Street 5
        CustomerAttributesCard."Street 5".SETVALUE('Street 5 SLS010');
        //Authorization Group
        CustomerAttributesCard."Authorization Group".SETVALUE(PermissionSet."Role ID");
        //Flag for Deletion
        CustomerAttributesCard."Flag for Deletion".SETVALUE(TRUE);
        //Account Group comes from template
        //C/O Name
        CustomerAttributesCard."C/O Name".SETVALUE('C/O Name SLS010');
        //Tax Number 1
        CustomerAttributesCard."Tax Number 1".SETVALUE('1');
        //Tax Number 2
        CustomerAttributesCard."Tax Number 2".SETVALUE('2');
        //Tax Number 3
        CustomerAttributesCard."Tax Number 3".SETVALUE('3');
        //Tax Number 4
        CustomerAttributesCard."Tax Number 4".SETVALUE('4');

        //Licenses
        //Country
        CustomerAttributesCard."Country License".SETVALUE(CompanyInformation."Country/Region Code");
        //License nr.
        CustomerAttributesCard."License No.".SETVALUE(10);
        //License Type
        IF LicenseType.Code <> '' THEN
            CustomerAttributesCard."License Type".SETVALUE(LicenseType.Code);
        //License valid from
        CustomerAttributesCard."License Valid from".SETVALUE(TODAY);
        //License valid to
        CustomerAttributesCard."License Valid to".SETVALUE(TODAY);
        //Payment valid from
        CustomerAttributesCard."Payment valid from".SETVALUE(TODAY);
        //Payment valid to
        CustomerAttributesCard."Payment valid to".SETVALUE(TODAY);

        //Sales
        //Customer Type
        CustomerAttributesCard."Customer Type".SETVALUE(CustomerType.Code);
        //Business Segment
        CustomerAttributesCard."Business Segment".SETVALUE(BusinessSegment.Code);
        //Business Organizational Segment
        CustomerAttributesCard."Business OrganizationalSegment".SETVALUE(BusinessOrganizationalSegment.Code);
        //Customer Sub-Type/Channel
        IF CustomerSubType.Code <> '' THEN
            CustomerAttributesCard."Customer Sub-Type".SETVALUE(CustomerSubType.Code);
        //Local Customer Sub Type/Channel
        IF LocalCustomerSubType.Code <> '' THEN
            CustomerAttributesCard."Local Customer Sub-Type".SETVALUE(LocalCustomerSubType.Code);

        CustomerAttributesCard.OK.INVOKE;

        //Dimensions
        // CustomerCard."Page Default Dimensions".INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        CustomerCard.Dimensions.INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name


        //Step 9 - Automated Control MDM-Customer-C-06
        //Review General - Number of Customer"
        CustomerCard."No.".ASSERTEQUALS(CustomerNo);

        //Step 10 - Send approval request
        //HEI.57>>
        IF NOT (COMPANYNAME = 'Brasco') THEN
            CustomerCard.SendApprovalRequest.INVOKE;
        //HEI.57<<
        MESSAGE(ApprovalRequestNotSentMsg);

        //Step 11- Close the customer Card
        CustomerCard.OK.INVOKE;

        //Step 12 - Automated Control MDM-Customer-C-03
        //Error should come if any mandatory field is not updated on closing the page

        //HEI.21<<
    end;

