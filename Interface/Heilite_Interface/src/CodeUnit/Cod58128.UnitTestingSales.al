        ReportSelections.VALIDATE("Report ID", 53005);

        ReportSelections.INSERT;
        //END; //HEI.17

        //Run the Report
        // SalesOrder.Action224.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        SalesOrder."Print Confirmation".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //Close Sales Order Page
        SalesOrder.OK.INVOKE;

        //HEI.04<<
    end;

