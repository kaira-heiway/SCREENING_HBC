    procedure RT_OTC023_CheckBillingPostingFlows_Corrections_DebitOrCredit();
    var
        Customer: Record Customer;
        BillToCustomer: Record Customer;
        Item: Record Item;
        Location: Record Location;
        GeneralPostingSetup: Record "General Posting Setup";
        CustomerPostingGroup: Record "Customer Posting Group";
        VATPostingSetup: Record "VAT Posting Setup";
        SalesLine: Record "Sales Line";
        SalesCrMemoHeader: Record "Sales Cr.Memo Header";
        SalesCreditMemos: TestPage "Sales Credit Memos";
        SalesCreditMemo: TestPage "Sales Credit Memo";
        PostedSalesCreditMemos: TestPage "Posted Sales Credit Memos";
        PostedSalesCreditMemo: TestPage "Posted Sales Credit Memo";
        GeneralLedgerEntries: TestPage "General Ledger Entries";
        VATEntries: TestPage "VAT Entries";
        Navigate: TestPage Navigate;
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        Quantity: Decimal;
        SalesCrMemoNo: Code[20];
        CADAmount: Decimal;
        SalesHeader: Record "Sales Header";
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        Workflow: Record Workflow;
        VATAmount: Decimal;
        Bin: Record Bin;
        Zone: Record Zone;
        BinContent: Record "Bin Content";
        EbfCombination: Record "Ebf Combination FND";
        EBMSInterfaceSetup: Record "EBMS Interface Setup INT";
    begin
        ClearVariables('OTC023'); //HEI.31
        //HEI.04>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC023', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.15>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Customer."Purchasing Code" <> '' THEN
        //     Customer."Purchasing Code" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF NOT Customer."Additional RPM Return FND" THEN
            Customer."Additional RPM Return FND" := TRUE;
        Customer.MODIFY;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF BillToCustomer.GET(Customer."Bill-to Customer No.") THEN BEGIN
        //     IF BillToCustomer."Free Item" THEN
        //         BillToCustomer."Free Item" := FALSE;
        //     IF BillToCustomer."Free Reason Code" <> '' THEN
        //         BillToCustomer."Free Reason Code" := '';
        //     IF BillToCustomer."Gen. Bus. Posting Free Group" <> '' THEN
        //         BillToCustomer."Gen. Bus. Posting Free Group" := '';
        //     BillToCustomer.MODIFY;
        // END ELSE BEGIN
        //     BillToCustomer.GET(Customer."No.");
        //     IF BillToCustomer."Free Item" THEN
        //         BillToCustomer."Free Item" := FALSE;
        //     IF BillToCustomer."Free Reason Code" <> '' THEN
        //         BillToCustomer."Free Reason Code" := '';
        //     IF BillToCustomer."Gen. Bus. Posting Free Group" <> '' THEN
        //         BillToCustomer."Gen. Bus. Posting Free Group" := '';
        //     BillToCustomer.MODIFY;
        // END;
        if BillToCustomer.GET(Customer."No.") then;//BC Upgrade VAMSIU01
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.15<<

        //HEI.73>>
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Enable EBMS Interface FND" THEN BEGIN
            SalesReceivablesSetup."Enable EBMS Interface FND" := FALSE;
            SalesReceivablesSetup.MODIFY;
        END;
        IF EBMSInterfaceSetup.GET THEN BEGIN
            EBMSInterfaceSetup."EBMS Interface Enabled" := FALSE;
            EBMSInterfaceSetup.MODIFY;
        END;
        //HEI.73<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC023', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC023', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);

        GeneralPostingSetup.GET(BillToCustomer."Gen. Bus. Posting Group", Item."Gen. Prod. Posting Group");
        CustomerPostingGroup.GET(BillToCustomer."Gen. Bus. Posting Group");
        VATPostingSetup.GET(BillToCustomer."Gen. Bus. Posting Group", Item."VAT Prod. Posting Group");

        //HEI.15>>
        //Check the default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC017', COMPANYNAME, DATABASE::Zone);
        IF Zone.GET(Location.Code, UnitTestingValues.Value) THEN
            IF Zone."Sales Gate Entry Mandatory FND" THEN BEGIN
                Zone."Sales Gate Entry Mandatory FND" := FALSE;
                Zone.MODIFY;
            END;

        //Check the default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC023', COMPANYNAME, DATABASE::Bin);
        Bin.SETRANGE(Code, UnitTestingValues.Value);
        Bin.FINDFIRST;

        IF Location."Default Bin Code" <> Bin.Code THEN
            Location."Default Bin Code" := Bin.Code;
        IF Location."Receipt Bin Code" <> Bin.Code THEN
            Location."Receipt Bin Code" := Bin.Code;
        IF Location."Sales Gate Entry Mandatory FND" THEN
            Location."Sales Gate Entry Mandatory FND" := FALSE;
        Location.MODIFY;

        BinContent.SETRANGE("Location Code", Location.Code);
        BinContent.SETRANGE("Item No.", Item."No.");
        BinContent.SETRANGE("Zone Code", Zone.Code);
        BinContent.SETRANGE("Bin Code", Bin.Code);
        IF BinContent.FINDFIRST THEN
            IF NOT BinContent.Default THEN BEGIN
                BinContent.Default := TRUE;
                BinContent.MODIFY;
            END;
        //HEI.15<<
        //HEI.57>>
        //HEI.64>>
        //HEI.65>>
        IF COMPANYNAME = '10_SURIN_BROUWERIJ' THEN BEGIN
            EbfCombination.RESET;
            EbfCombination.SETCURRENTKEY("GL Account No.", "Dimension Code", "Dimension Value Code");
            EbfCombination.SETFILTER("Combination Restriction", '%1|%2', EbfCombination."Combination Restriction"::"Allowed with Warn", EbfCombination."Combination Restriction"::"Not Allowed");
            EbfCombination.MODIFYALL("Combination Restriction", 0);
        END;
        //HEI.65<<
        //HEI.57<<
        //HEI.64<<
        //Step 1: Login

        //Step 2: Create and post a Sales Credit Memo
        SalesCreditMemos.OPENVIEW;

        SalesCreditMemo.OPENNEW;
        SalesCreditMemo.NEW;

        SalesCreditMemo."Sell-to Customer Name".SETVALUE(Customer."No.");
        SalesCreditMemo."Location Code".SETVALUE(Location.Code);
        SalesCreditMemo."Currency Code".SETVALUE(''); //HEI.15

        SalesCreditMemo.SalesLines.NEW;
        SalesCreditMemo.SalesLines.Type.SETVALUE(Type::Item);
        SalesCreditMemo.SalesLines."No.".SETVALUE(Item."No.");
        //HEI.15>>
        IF SalesCreditMemo.SalesLines."Location Code".VALUE = Location.Code THEN
            SalesCreditMemo.SalesLines."Location Code".SETVALUE('');
        SalesCreditMemo.SalesLines."Location Code".SETVALUE(Location.Code);
        //HEI.15<<
        SalesCreditMemo.SalesLines.Quantity.SETVALUE(1);
        //HEI.15>>
        IF SalesCreditMemo.SalesLines."Unit Price".ASDECIMAL = 0 THEN
            SalesCreditMemo.SalesLines."Unit Price".SETVALUE(10);
        SalesCrMemoNo := SalesCreditMemo."No.".VALUE;
        //HEI.15<<

        SalesLine.RESET;
        SalesLine.SETRANGE("Document Type", SalesLine."Document Type"::"Credit Memo");
        SalesLine.SETRANGE("Document No.", SalesCrMemoNo);
        SalesLine.SETRANGE("No.", Item."No.");
        IF SalesLine.FINDFIRST THEN
            CADAmount := SalesLine."CAD Amount FND";

        //Release & Post
        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::"Credit Memo", SalesCrMemoNo);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;

        SalesCreditMemo.Release.INVOKE;
        SalesCreditMemo.Post.INVOKE;
        SalesCreditMemos.CLOSE;

        SalesCrMemoHeader.SETRANGE("Pre-Assigned No.", SalesCrMemoNo);
        SalesCrMemoHeader.FINDFIRST;

        //Step 3,4: Search and Open Posted Sales Credit Memos
        PostedSalesCreditMemos.OPENVIEW;
        PostedSalesCreditMemos.FILTER.SETFILTER("No.", SalesCrMemoHeader."No.");

        //Step 5,6: Search the posted document and Open Posted Sales Credit Memo
        PostedSalesCreditMemo.OPENVIEW;
        PostedSalesCreditMemo.FILTER.SETFILTER("No.", SalesCrMemoHeader."No.");

        PostedSalesCreditMemo.SalesCrMemoLines.FINDFIRSTFIELD("No.", Item."No.");

        //Step 7,8: Go to Actions -> Navigate
        Navigate.TRAP;
        //  PostedSalesCreditMemo.Action51.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        PostedSalesCreditMemo."&Navigate".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name.


        //Step 9: Open G/L Entries
        Navigate.FILTER.SETFILTER("Table Name", 'G/L Entry');
        GeneralLedgerEntries.TRAP;

        //Drilldown on No. Of Records will open the Page
        Navigate."No. of Records".DRILLDOWN;

        //Step 10: Check posting flows and GL Account
        //Sales Account
        GeneralLedgerEntries.FILTER.SETFILTER("G/L Account No.", GeneralPostingSetup."Sales Credit Memo Account");
        GeneralLedgerEntries.Amount.ASSERTEQUALS(PostedSalesCreditMemo.SalesCrMemoLines."Line Amount".ASDECIMAL);

        //Sales VAT Account
        IF GeneralLedgerEntries.FINDFIRSTFIELD("G/L Account No.", VATPostingSetup."Sales VAT Account") THEN BEGIN
            GeneralLedgerEntries.Amount.ASSERTEQUALS(PostedSalesCreditMemo.SalesCrMemoLines."Total VAT Amount".ASDECIMAL);
            VATAmount := PostedSalesCreditMemo.SalesCrMemoLines."Total VAT Amount".ASDECIMAL;
        END;

        //Customer Receivable Account
        /*GeneralLedgerEntries.FILTER.SETFILTER("G/L Account No.",CustomerPostingGroup."Receivables Account");
        GeneralLedgerEntries.Amount.ASSERTEQUALS(-PostedSalesCreditMemo.SalesCrMemoLines."Total Amount Incl. VAT".ASDECIMAL);*/

        //Step 11: Open VAT Entries
        IF VATAmount <> 0 THEN BEGIN
            Navigate.FILTER.SETFILTER("Table Name", 'VAT Entry');
            VATEntries.TRAP;

            //Drilldown on No. Of Records will open the Page
            Navigate."No. of Records".DRILLDOWN;

            //Step 12: Check posting flows and VAT GL Account
            VATEntries.FILTER.SETFILTER("VAT Bus. Posting Group", VATPostingSetup."VAT Bus. Posting Group");
            VATEntries.FILTER.SETFILTER("VAT Prod. Posting Group", VATPostingSetup."VAT Prod. Posting Group");
            VATEntries.Amount.ASSERTEQUALS(VATAmount - CADAmount);
        END;

        //Step 13: Close the Navigate page
        Navigate.OK.INVOKE;

        //Step 14: Close the other pages
        PostedSalesCreditMemo.OK.INVOKE;

        //HEI.04<<

    end;

