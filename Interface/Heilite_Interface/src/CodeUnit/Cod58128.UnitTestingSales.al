            SalesReceivablesSetup."Activate CIS System FND" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.15<<
        IF InventorySetup.GET THEN
            InventorySetup.MODIFYALL("Location Mandatory", FALSE);//HEI.63>>

        //Step 1: Login

        //before Step 2 - create new Sales Return Order
        // SalesReturnOrderList.OPENNEW;
        // SalesReturnOrderList.NEW;
        SalesReturnOrder.OPENNEW;
        SalesReturnOrder."No.".ASSISTEDIT;
        SalesReturnOrder."Sell-to Customer Name".SETVALUE(Customer.Name);//BC Upgrade VAMSIU01 added

        SalesReturnOrder."Location Code".SETVALUE(Location.Code);
        SalesReturnOrder."Route 107FDW".SETVALUE(Route.Code);
        SalesReturnOrder.ShipmentDateNew.SETVALUE(WORKDATE);
        SalesReturnOrder."External Document No.".SETVALUE('Unit Test LOG023');

        SalesReturnOrder.SalesLines.NEW;
        SalesReturnOrder.SalesLines.Type.SETVALUE(2);
        SalesReturnOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesReturnOrder.SalesLines.Quantity.SETVALUE(2);
        SalesReturnOrder.SalesLines."Return Reason Code".SETVALUE(ReturnReason.Code);
        SalesReturnOrder.Release.INVOKE;
        RoutePlanningWorkSheetRec.GET(SalesReturnOrder."Route Planning No. 107FDW".VALUE);
        SalesReturnOrder.OK.INVOKE;

        //Step 2: Open Route Planning Worksheet
        RoutePlanningWorksheet.OPENEDIT;

        //Step 3 - Filter on Date = Today, Filter on Route
        // RoutePlanningWorksheet.DateFilter.SETVALUE(WORKDATE);//BC Upgrade VAMSIU01 Blocked
        // RoutePlanningWorksheet.RouteFilter.SETVALUE(Route.Code);//BC Upgrade VAMSIU01 Blocked

        RoutePlanningWorksheet."Date Filter".SETVALUE(WORKDATE);//BC Upgrade VAMSIU01 added
        RoutePlanningWorksheet."Route Filter".SETVALUE(Route.Code);//BC Upgrade VAMSIU01 added

        //Step 4 - Warehouse Receipt created.
        //HEI.55>>
        //RoutePlanningWorksheet.GOTORECORD(RoutePlanningWorkSheetRec);
        RoutePlanningWorksheet.FILTER.SETFILTER("No.", RoutePlanningWorkSheetRec."No.");
        //HEI.55<<
        //RoutePlanningWorksheet.Action1101000004.INVOKE;//BC Upgrade VAMSIU01 Blocked
        RoutePlanningWorksheet."LoG Create/Modify Warehouse Receipt 107FDW".INVOKE;//BC Upgrade VAMSIU01 Added
        RoutePlanningWorksheet.Close();//BC Upgrade VAMSIU01 Added

        //Step 5 - Warehouse Receipt opened.
        //RoutePlanningWorksheet.Action1101000007.INVOKE;//BC UPGRADE KUMARR Blocking DIT Code

        WarehouseReceipts.OpenEdit();
        WarehouseReceiptCard.TRAP;
        WarehouseReceipts.Filter.SetFilter("Route Planning No. 107FDW", RoutePlanningWorkSheetRec."No.");
        WarehouseReceipts.EDIT.INVOKE;
        //Step 6 - "On Lines FastTab, add Zone Code & Bin Code."
        WarehouseReceiptCard.WhseReceiptLines.FIRST;

        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG023', COMPANYNAME, DATABASE::Zone);
        Zone.GET(WarehouseReceiptCard."Location Code".VALUE, UnitTestingValues.Value);

        //HEI.15>>
        IF Zone."Sales Gate Entry Mandatory FND" THEN BEGIN
            Zone."Sales Gate Entry Mandatory FND" := FALSE;
            Zone.MODIFY;
        END;
        //HEI.15<<

        /*WarehouseReceiptCard.WhseReceiptLines."Zone Code".SETVALUE(Zone.Code);
        
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG023',COMPANYNAME,DATABASE::Bin);
        
        Bin.RESET;
        Bin.SETRANGE("Location Code", WarehouseReceiptCard."Location Code".VALUE);
        Bin.SETRANGE(Code, UnitTestingValues.Value);
        Bin.SETRANGE("Zone Code", Zone.Code);
        Bin.FINDFIRST;
        
        WarehouseReceiptCard.WhseReceiptLines."Bin Code".SETVALUE(Bin.Code);*/

        //HEI.15>>
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseReceiptCard."Shipping Agent Code 107FDW".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseReceiptCard."LOG Shipping Agent Service 107FDW".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseReceiptCard."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseReceiptCard."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //HEI.15<<

        //Step 7 - On Actions Tab, select Truck Unloading Note.
        ReportSelections.RESET;
        ReportSelections.SETRANGE(Usage, ReportSelections.Usage::"Unloading Note(Whse. Receipt)");
        ReportSelections.SETFILTER("Report ID", '<>0');
        IF ReportSelections.FINDFIRST THEN;

        //Step 8 - On Lines FastTab, modify Qty. to Receive to register the quantity differences from the Customer..
        //EVALUATE(QtyToReceive, WarehouseReceiptCard.WhseReceiptLines."Qty. to Receive".VALUE);
        WarehouseReceiptCard.WhseReceiptLines."Qty. to Receive".SETVALUE(1);

        //Step 9, 10 - On Lines FastTab, select Backorder type: No Backorder for partial receipts or Backorder to leave open the warehouse receipt until the warehouse receive stocks.
        //EVALUATE(BackOrderInitialValue, WarehouseReceiptCard.WhseReceiptLines."Backorder Type".VALUE);
        //WarehouseReceiptCard.WhseReceiptLines."Backorder Type".SETVALUE(0);
        //WarehouseReceiptCard.WhseReceiptLines."Backorder Type".SETVALUE(1);
        // WarehouseReceiptCard.WhseReceiptLines."Backorder Type".SETVALUE(2);//BC UPGRADE KUMARR >> Blocking DIT Code
        //WarehouseReceiptCard.WhseReceiptLines."Backorder Type".SETVALUE(BackOrderInitialValue);

        //Step 11, 12 - Select Item Tracking Code
        ItemTrackingQtyBase := WarehouseReceiptCard.WhseReceiptLines."Qty. to Receive".ASDECIMAL * WarehouseReceiptCard.WhseReceiptLines."Qty. per Unit of Measure".ASDECIMAL;
        WarehouseReceiptCard.WhseReceiptLines.ItemTrackingLines.INVOKE;

        //Step 13 - Add Return Reason Code
        // WarehouseReceiptCard.WhseReceiptLines."Return Reason Code".SETVALUE(ReturnReason.Code);//BC UPGRADE KUMARR >> Blocking DIT Code

        //Step 14 - On Actions Tab, click on Return Control.
        //WarehouseReceiptCard.Action1101000006.INVOKE;//BC UPGRADE KUMARR >> Blocking DIT Code

        //Step 15 - Add 'Counted Quantity' to Return Control
        // logic in WhseReturnControlTotalModalPageHandler

        //Step 16 - Post Receipt
        WarehouseReceiptCard."Post Receipt".INVOKE;

        //HEI.03>>

    end;

    [Test]

    [HandlerFunctions('NoSeriesListModalPageHandler,MessageHandler,ShipInvoiceStrMenuHandler,WhseShipPageHandler,WhseRcptPageHandler,ConfirmationHandler,ItemTrackingLinesModalPageHandler')]//BC Upgrade KUMARR78 added ItemTrackingLinesModalPageHandler

    procedure LOG035_TransferOrderProcess();
    var
        TransferFromLocation: Record Location;
        TransferToLocation: Record Location;
        InTransitLocation: Record Location;
        Item: Record Item;
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        TransferList: TestPage "Transfer Orders";
        TransferOrder: TestPage "Transfer Order";
        WarehouseShipment: TestPage "Warehouse Shipment";
        WarehouseReceipt: TestPage "Warehouse Receipt";
        ReportSelections: Record "Report Selections";
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT Variable.
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT Variable.
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT Variable.
        Route: Record Route107FDW;
        Truck: Record Vehicle101FDW;
        Driver: Record Driver107FDW;
        Bin: Record Bin;
        Bin2: Record Bin;
        Zone: Record Zone;
        Zone2: Record Zone;
        BinContent: Record "Bin Content";
        BinContent2: Record "Bin Content";
        ItemTrackingCode: Record "Item Tracking Code";

        RouteCode: Code[20];
        SalesReceivablesSetup: Record "Sales & Receivables Setup";
        BinFound: Boolean;
        WarehouseShipmentHeader: Record "Warehouse Shipment Header";
        InventoryPostingSetup: Record "Inventory Posting Setup";
        InventoryPostingSetup2: Record "Inventory Posting Setup";
        WarehouseEntry: Record "Warehouse Entry";//BC Upgrade PATELP08
        WarehouseEntry2: Record "Warehouse Entry";//BC Upgrade PATELP08
        TransferLine: Record "Transfer Line";//BC Upgrade PATELP08
        //BC UPGRADE KUMARR78 <<
        LotNoInformation: Record "Lot No. Information";
        BestLotNo: Code[50];
        BestQtyBase: Decimal;
        BestLot: Code[50];
    //BC UPGRADE KUMARR78 >>


    begin
        ClearVariables('LOG035'); //HEI.31
        //HEI.01>>
        //Check default value for Transfer-from Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG035', COMPANYNAME, DATABASE::Location);
        TransferFromLocation.GET(UnitTestingValues.Value);
        //HEI.17>>
        IF TransferFromLocation."Transfer Gate Entry Mandat FND" THEN
            TransferFromLocation."Transfer Gate Entry Mandat FND" := FALSE;
        IF TransferFromLocation."Zone Mandatory FND" THEN
            TransferFromLocation."Zone Mandatory FND" := FALSE;
        TransferFromLocation.MODIFY;
        //HEI.17<<

        //Check default value for Transfer-to Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG035', COMPANYNAME, DATABASE::Location);
        TransferToLocation.GET(UnitTestingValues."Value 2");
        //HEI.17>>
        IF TransferToLocation."Transfer Gate Entry Mandat FND" THEN
            TransferToLocation."Transfer Gate Entry Mandat FND" := FALSE;
        IF TransferToLocation."Zone Mandatory FND" THEN
            TransferToLocation."Zone Mandatory FND" := FALSE;
        TransferToLocation.MODIFY;
        //HEI.17<<

        //Check default value for In-Transit Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG035', COMPANYNAME, DATABASE::Location);
        InTransitLocation.GET(UnitTestingValues."Value 3");
        //HEI.17>>
        IF InTransitLocation."Zone Mandatory FND" THEN
            InTransitLocation."Zone Mandatory FND" := FALSE;
        InTransitLocation.MODIFY;
        //HEI.17<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG035', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        IF UnitTestingValues.GET('LOG035', COMPANYNAME, DATABASE::"Shipping Agent") THEN
            IF ShippingAgent.GET(UnitTestingValues.Value) THEN
                IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                    ShippingAgent."Own Logistics FND" := TRUE;
                    ShippingAgent.MODIFY;
                END;

        //Check the default value for Shipping Agent Services
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG035', COMPANYNAME, DATABASE::"Shipping Agent Services");
        IF ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value) THEN;

        //HEI.17>>
        //Check the default value for Truck
        //BC UPGRADE KUMARR >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG035', COMPANYNAME, DATABASE::Vehicle101FDW);
        IF Truck.GET(UnitTestingValues.Value) THEN;

        //Check the default value for Driver
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG035', COMPANYNAME, DATABASE::Driver107FDW);
        IF Driver.GET(UnitTestingValues.Value) THEN;
        //BC UPGRADE KUMARR << Blocking DIT Code

        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG035', COMPANYNAME, DATABASE::Zone);
        Zone.GET(TransferFromLocation.Code, UnitTestingValues.Value);
        IF Zone."Transf.Gate EntryMandatory FND" THEN BEGIN
            Zone."Transf.Gate EntryMandatory FND" := FALSE;
            Zone.MODIFY;
        END;

        //Check the default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG035', COMPANYNAME, DATABASE::Bin);
        Bin.GET(TransferFromLocation.Code, UnitTestingValues.Value);

        IF TransferFromLocation."Shipment Bin Code" <> Bin.Code THEN BEGIN
            TransferFromLocation."Shipment Bin Code" := Bin.Code;
            TransferFromLocation.MODIFY;
        END;

        IF TransferToLocation."Receipt Bin Code" = '' THEN BEGIN
            Bin2.SETRANGE("Location Code", TransferToLocation.Code);
            IF Bin2.FINDSET THEN BEGIN
                Zone2.SETRANGE("Location Code", TransferToLocation.Code);
                Zone2.SETRANGE(Code, Bin2."Zone Code");
                IF Zone2.FINDFIRST THEN BEGIN
                    IF Zone2."Use As In-Transit FND" THEN
                        Zone2."Use As In-Transit FND" := FALSE;
                    IF Zone2."Default Receipt Bin Code FND" <> Bin2.Code THEN
                        Zone2."Default Receipt Bin Code FND" := Bin2.Code;
                    IF Zone2."Transf.Gate EntryMandatory FND" THEN
                        Zone2."Transf.Gate EntryMandatory FND" := FALSE;
                    Zone2.MODIFY;
                END;
                TransferToLocation."Receipt Bin Code" := Bin2.Code;
                TransferToLocation.MODIFY;
            END;
        END;

        BinContent.SETRANGE("Location Code", TransferFromLocation.Code);
        BinContent.SETRANGE("Item No.", Item."No.");
        BinContent.SETRANGE(Default, TRUE);
        IF BinContent.FINDFIRST THEN BEGIN
            IF BinContent."Bin Code" <> Bin.Code THEN
                BinContent.Default := FALSE;
            BinContent.MODIFY;
        END;

        BinContent2.SETRANGE("Location Code", TransferFromLocation.Code);
        BinContent2.SETRANGE("Item No.", Item."No.");
        BinContent2.SETRANGE("Bin Code", Bin.Code);
        BinContent2.FINDFIRST;
        BinContent2.Default := TRUE;
        BinContent2.MODIFY;
        //HEI.58>>
        IF InventoryPostingSetup.GET(TransferFromLocation.Code, Item."Inventory Posting Group") THEN BEGIN
            IF InventoryPostingSetup."Inventory Account" <> '' THEN BEGIN
                InventoryPostingSetup2.GET(InTransitLocation.Code, Item."Inventory Posting Group");
                IF InventoryPostingSetup2."Inventory Account" = '' THEN
                    InventoryPostingSetup2."Inventory Account" := InventoryPostingSetup."Inventory Account";
                InventoryPostingSetup2.MODIFY;
            END ELSE BEGIN
                InventoryPostingSetup2.RESET;
                InventoryPostingSetup2.SETFILTER("Inventory Account", '<>%1', '');
                IF InventoryPostingSetup2.FINDFIRST THEN
                    InventoryPostingSetup.MODIFYALL("Inventory Account", InventoryPostingSetup2."Inventory Account");
            END;
        END;
        IF InventoryPostingSetup.GET(TransferToLocation.Code, Item."Inventory Posting Group") THEN BEGIN
            IF InventoryPostingSetup."Inventory Account" <> '' THEN BEGIN
                InventoryPostingSetup2.GET(InTransitLocation.Code, Item."Inventory Posting Group");
                IF InventoryPostingSetup2."Inventory Account" = '' THEN
                    InventoryPostingSetup2."Inventory Account" := InventoryPostingSetup."Inventory Account";
                InventoryPostingSetup2.MODIFY;
            END ELSE BEGIN
                InventoryPostingSetup2.RESET;
                InventoryPostingSetup2.SETFILTER("Inventory Account", '<>%1', '');
                IF InventoryPostingSetup2.FINDFIRST THEN
                    InventoryPostingSetup.MODIFYALL("Inventory Account", InventoryPostingSetup2."Inventory Account");
            END;
        END;
        //HEI.58<<
        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Strict Expiration Posting" THEN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.17<<

        //Step 1: Login

        //Step 2 - Open Transfer List Page
        TransferList.OPENEDIT;

        //Step 3 - Create NEW Transfer Order
        TransferOrder.OPENNEW;
        TransferOrder.NEW;

        //Step 4 - AssitEdit to create the Document No. and add Transfer-From Code
        TransferOrder."No.".ASSISTEDIT;
        TransferOrder."Transfer-from Code".SETVALUE(TransferFromLocation.Code);

        //Step 5 - Add Transfer-to Code
        TransferOrder."Transfer-to Code".SETVALUE(TransferToLocation.Code);

        //Step 6 - Add In-Transit Code
        TransferOrder."In-Transit Code".SETVALUE(InTransitLocation.Code);

        //Step 7 - Add Shipping Agent Code, and Shipping Agent Service Code
        //HEI.17>>
        //BC UPGRADE KUMARR >> Blocking DIT Code
        IF TransferOrder."Route 107FDW".VALUE <> '' THEN BEGIN
            RouteCode := TransferOrder."Route 107FDW".VALUE;
            Route.GET(TransferOrder."Route 107FDW".VALUE);
            IF Route."Multiple Order Route" THEN
                Route."Multiple Order Route" := FALSE;
            IF Route.Driver <> '' THEN
                Route.Driver := '';
            IF Route.Vehicle <> '' THEN
                Route.Vehicle := '';
            Route.MODIFY;

            TransferOrder."Route 107FDW".SETVALUE('');
            TransferOrder."Route 107FDW".SETVALUE(RouteCode);
        END;
        //BC UPGRADE KUMARR << Blocking DIT Code

        IF ShippingAgent.Code <> '' THEN
            //HEI.17<<
            TransferOrder."Shipping Agent Code".SETVALUE(ShippingAgent.Code);
        IF ShippingAgentServices.Code <> '' THEN //HEI.17
            TransferOrder."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        //HEI.17>>
        //BC UPGRADE KUMARR >> Blocking DIT Code
        IF Driver.Code <> '' THEN
            TransferOrder."Log Driver 107FDW".SETVALUE(Driver.Code);
        IF Truck.Code <> '' THEN
            TransferOrder."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR << Blocking DIT Code
        //HEI.17<<

        //Step 8 - Add Item No. on lines
        TransferOrder.TransferLines.NEW;
        TransferOrder.TransferLines."Item No.".SETVALUE(Item."No.");

        //Step 9 - Add Columns: Transfer-from Code, Transfer-from Bin Code, Transfer-To Code and Transfer-To Bin Code
        //Fields not visible on the page cannt be used on Unit Tests

        //Step 10 - Add Quantity
        TransferOrder.TransferLines.Quantity.SETVALUE(1);
        TransferOrder.TransferLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure");//BC Upgrade KUMARR78 08-06-2026++

        //BC Upgrade KUMARR78 >> Assign lot tracking on the TRANSFER ORDER line. The legacy DIT Auto-FEFO ran on the Transfer Order and auto-assigned a lot; KUMARR78 replaced it with the sales-oriented WarehouseShipment."&Automatic FEFO Tracking for Order" action, which does NOT assign tracking to a transfer line and spawns a blank-"Item No." line that crashes the Aptean IntlInventoryHook101FDW (No.=''). Pick a lot that physically has warehouse stock in the source SHIPMENT BIN (Bin.Code) - not just at the location - so the whse register has bin content to consume, then assign it via the outbound ("Shipment") Item Tracking action.
        BestLotNo := '';
        BestQtyBase := 0;

        LotNoInformation.RESET;
        LotNoInformation.SETRANGE("Item No.", Item."No.");
        LotNoInformation.SETFILTER("Lot No.", '<>%1', '');
        LotNoInformation.SETRANGE(Blocked, false);
        LotNoInformation.SETFILTER("Expiration Date 101FDW", '>=%1', TODAY);
        IF LotNoInformation.FINDSET THEN
            REPEAT
                WarehouseEntry.RESET;
                WarehouseEntry.SETRANGE("Item No.", Item."No.");
                WarehouseEntry.SETRANGE("Location Code", TransferFromLocation.Code);
                WarehouseEntry.SETRANGE("Bin Code", Bin.Code);
                WarehouseEntry.SETRANGE("Lot No.", LotNoInformation."Lot No.");
                WarehouseEntry.CALCSUMS("Qty. (Base)");

                IF WarehouseEntry."Qty. (Base)" >= 1 THEN
                    IF WarehouseEntry."Qty. (Base)" > BestQtyBase THEN BEGIN
                        BestQtyBase := WarehouseEntry."Qty. (Base)";
                        BestLotNo := LotNoInformation."Lot No.";
                    END;
            UNTIL LotNoInformation.NEXT = 0;

        LotNoFilter := BestLotNo;
        ItemTrackingQtyBase := 1;
        TransferOrder.TransferLines.Shipment.INVOKE;//"Shipment" = outbound Item Tracking Lines action on the Transfer Order Subform
        //BC Upgrade KUMARR78 <<

        //Step 11 - Release TO and create Whse. Shipment
        //Release TO

        // TransferOrder."Codeunit Release Transfer Document".INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        TransferOrder."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name


        //Auto-FEFO
        // TransferOrder.Action1111000002.INVOKE;//BC UPGRADE KUMARR78 DIT Action

        //Create Whse. Shipment
        // TransferOrder.Action5778.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.

        TransferOrder."Create Whse. S&hipment".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //Open Whse Shipment page
        WarehouseShipment.OPENVIEW;
        WarehouseShipment.FILTER.SETFILTER("Source No. FND", TransferOrder."No.".VALUE);

        //BC Upgrade KUMARR78 >> Removed sales-only WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke(): on a transfer it does not assign tracking and spawned the blank-"Item No." line that crashed the Aptean IntlInventory hook. Lot tracking is now assigned on the Transfer Order line above. Autofill Qty. to Ship (the legacy DIT FEFO did this implicitly).
        WarehouseShipment."Autofill Qty. to Ship".INVOKE;
        //BC Upgrade KUMARR78 <<
        //Release Whse. Shipment

        // WarehouseShipment.Action45.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        WarehouseShipment."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //BC Upgrade KUMARR78 >> Remove any blank-"Item No." transfer line before posting. The Aptean IntlInventoryHook101FDW runs on every Transfer Shipment Line during posting and does Item.GET("Item No.") with NO blank guard, throwing "The Item does not exist. No.=''". A blank (description/phantom) transfer line produces no whse-shipment line but is still posted by TransferOrder-Post Shipment, feeding the unguarded hook. The real item line (with assigned lot) is kept.
        TransferLine.RESET;
        TransferLine.SETRANGE("Document No.", TransferOrder."No.".VALUE);
        TransferLine.SETRANGE("Item No.", '');
        IF NOT TransferLine.ISEMPTY THEN
            TransferLine.DELETEALL(FALSE);
        //BC Upgrade KUMARR78 <<

        //Post Whse. Shipment
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"

        //Step 12 - Print Transfer Order
        //Check if Report Selection is configured
        /*ReportSelections.SETRANGE(Usage,ReportSelections.Usage::Inv1);
        ReportSelections.FINDFIRST;
        
        //Update the Report ID with 5703 - Transfer Order
        IF ReportSelections.FINDFIRST THEN BEGIN
          ReportSelections.VALIDATE("Report ID",5703);
          ReportSelections.MODIFY;
        END ELSE BEGIN
          ReportSelections.INIT;
          ReportSelections.VALIDATE(Usage,ReportSelections.Usage::Inv1);
          ReportSelections.VALIDATE("Report ID",5703);
          ReportSelections.INSERT;
        END;
        */

        //Print the Report
        //Action cannot be used due to CAL functions are limited during write transactions
        //TransferOrder.Action69.INVOKE;

        //Step 13 - Create Whse. Receipt
        // TransferOrder.Action84.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.

        TransferOrder."Create &Whse. Receipt".INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.


        //Step 14 - Open Whse. Receipt
        WarehouseReceipt.OPENVIEW;
        WarehouseReceipt.FILTER.SETFILTER("Source No. FND", TransferOrder."No.".VALUE);

        //Step 15 - Post and Print Transfer Order
        //Post
        WarehouseReceipt."Post Receipt".INVOKE;
        //Post & Print
        //WarehouseReceipt.Action47.INVOKE;

        //Step 16 - Press OK
        //Page is automayically closed
        //HEI.01<<

    end;




