            //HEI.19>>
            // UserSetup3.SETRANGE("Unlimited Cr. Limit Customer", TRUE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
            IF UserSetup3.FINDFIRST THEN BEGIN
                UserSetup4.GET(USERID);
                // UserSetup4."Credit Limit Approver ID" := UserSetup3."User ID";//BC UPGRADE KUMARR78 >> Blocking DIT Code
