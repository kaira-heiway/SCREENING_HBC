                        UserSetup.Substitute := USERID;
                        UserSetup.MODIFY;
                    UNTIL ApprovalEntry.NEXT = 0;
                //HEI.83<<

                //Delegate Approval Request
                ApprovalsMgmt.DelegateApprovalRequests(ApprovalEntry);
                //HEI.78<<

                //Reject Approval Entry
                //HEI.78>>
                //SalesOrder.Reject.INVOKE;
                ApprovalEntry.SETRANGE("Table ID", 36);
                ApprovalEntry.SETRANGE("Document No.", SalesHeader."No.");
                ApprovalEntry.SETRANGE(Status, ApprovalEntry.Status::Open);
                IF ApprovalEntry.FINDSET THEN
                    REPEAT
                        SalesOrder.Reject.INVOKE;
                    UNTIL ApprovalEntry.NEXT = 0;
                //HEI.78<<
                SalesOrder.Status.ASSERTEQUALS(0);
                //HEI.19>>
            END ELSE
                MESSAGE('Nothing to approve');
            //HEI.19<<
        END ELSE BEGIN

            //Step 2,3,4: Go to Requests to Approve
            RequeststoApprove.OPENVIEW;

            //Step 5,6: Reject entry
            IF RequeststoApprove.FIRST THEN
                RequeststoApprove.Reject.INVOKE
            //HEI.19>>
            ELSE
                MESSAGE('No requests to approve.');
            //HEI.19<<
        END;
        //HEI.06<<

    end;

