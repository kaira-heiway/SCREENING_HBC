        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.22<<

        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"

        //Post Sales Order
        SalesOrder.Post.INVOKE;
        COMMIT;

        SalesInvoiceHeader.SETRANGE("Order No.", SalesOrderNo);
        SalesInvoiceHeader.FINDFIRST;

        //Step 2,3,4: Go to Reminders Page
        ReminderList.OPENEDIT;

        //Step 5: (Choose) Create Reminders
        //HEI.22>>
        //CustomerNoFilter := Customer."No.";
        CustomerNoFilter := BillToCustomer."No.";
        //HEI.22<<
        ReminderList.CreateReminders.INVOKE;

        //Step 6: Select single or multiple line in the reminder and delete
        //Delete trigger is not enabled for Test Pages. So record will be deleted from the table
        ReminderLine.SETRANGE(Type, ReminderLine.Type::"Customer Ledger Entry");
        ReminderLine.SETRANGE("Document Type", ReminderLine."Document Type"::Invoice);
        ReminderLine.SETRANGE("Document No.", SalesInvoiceHeader."No.");
        if ReminderLine.FindFirst then //BC Upgrade ATHUKS01
            ReminderLine.DELETE;

        //Check Reminder created
        Reminder.OPENVIEW;
        //HEI.21>>
        //Reminder.FINDFIRSTFIELD("Customer No.",Customer."No.");
        //Reminder.FINDFIRSTFIELD("Posting Date",WORKDATE);
        Reminder.FILTER.SETFILTER("Customer No.", BillToCustomer."No.");
        Reminder.FILTER.SETFILTER("Posting Date", FORMAT(WORKDATE));
        //HEI.21<<
        Reminder.OK.INVOKE;
        //HEI.11<<
    end;

