    [HandlerFunctions('NoSeriesListModalPageHandler,MessageHandler,ConfirmationHandler,ItemTrackingLinesModalPageHandler2,DimensionSetEntriesModalPageHandler')]
    procedure LOG076_AutomaticRegistryInboundGateEntry();
    var
        Location: Record Location;
        Vendor: Record Vendor;
        Item: Record Item;
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable
        Route: Record Route107FDW;
        Bin: Record Bin;
        Zone: Record Zone;
        ReturnReason: Record "Return Reason";
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT variable
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT variable
        Driver: Record Driver107FDW;
        Truck: Record Vehicle101FDW;
        PurchaseOrder: TestPage "Purchase Order";
        GateEntryInbound: TestPage "Gate Entry Inbound";
        GateEntryInboundList: TestPage "Gate Entry Inbound List";
        WarehouseReceipt: TestPage "Warehouse Receipt";
        ItemTrackingLines: TestPage "Item Tracking Lines";
        GateEntry_DocumentType: Option " ","Purchase Order","Transfer Order","Sales Return Order","Warehouse Receipt","Sales Order","Purchase Return Order","Warehouse Shipment";
        TypeGE: Option " ",Item,"Fixed Asset","Service Item";
        GateEntryNo: Code[20];
        Workflow: Record Workflow;
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        PurchaseHeader: Record "Purchase Header";
        NoSeries: Record "No. Series";
        WarehouseSetup: Record "Warehouse Setup";
        WarehouseEmployee: Record "Warehouse Employee";
        ItemUnitofMeasure: Record "Item Unit of Measure";
        ItemTrackingCode: Record "Item Tracking Code";
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        PurchasesPayablesSetup: Record "Purchases & Payables Setup";
        GeneralLedgerSetup: Record "General Ledger Setup";
    begin
        ClearVariables('LOG076'); //HEI.31
        //HEI.08<<
        //Check default value for Vendor
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::Vendor);
        Vendor.GET(UnitTestingValues.Value);

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);
        //HEI.20>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Item."Strength 3 Code 101FDW" = 'EXT.[%W/W]' THEN BEGIN
            Item."Strength 3 Code 101FDW" := '';
            Item.MODIFY;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.20<<

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF NOT Location."Purchase Gate Entry Mandat FND" THEN
            Location."Purchase Gate Entry Mandat FND" := TRUE;
        IF NOT Location."Enable Inbound Validation FND" THEN
            Location."Enable Inbound Validation FND" := TRUE;
        IF NOT Location."InBound Auto Registration FND" THEN
            Location."InBound Auto Registration FND" := TRUE;
        Location.MODIFY;
        //HEI.20<<

        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //HEI.20>>
        IF Route."Multiple Order Route" THEN
            Route."Multiple Order Route" := FALSE;
        //HEI.36>>
        //IF Route."Location Code" <> '' THEN
        //Route."Location Code" := '';
        Route."shipping location" := Location.Code;
        Route."receipt location" := Location.Code;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.36<<
        //HEI.71>>
        // IF COMPANYNAME = '10_SURIN_BROUWERIJ' THEN BEGIN //HEI.77
        //HEI.77>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // PurchasesPayablesSetup.GET;
        // IF (PurchasesPayablesSetup."Excluded Incoterms" <> '') AND NOT (Route."Shipment Method Code" IN [PurchasesPayablesSetup."Excluded Incoterms"]) THEN BEGIN
        //     //HEI.77<<
        //     IF Route."Shipment Method Code" <> '' THEN
        //         Route."Shipment Method Code" := '';
        // END;
        //HEI.71<<
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.20<<

        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::Zone);
        Zone.GET(Location.Code, UnitTestingValues.Value);
        //HEI.20>>
        IF NOT Zone."Purch. GateEntry Mandatory FND" THEN
            Zone."Purch. GateEntry Mandatory FND" := TRUE;
        IF Zone."Inbound Auto. Registration FND" THEN
            Zone."Inbound Auto. Registration FND" := FALSE;
        Zone.MODIFY;
        //HEI.02<<

        //Check default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::Bin);
        Bin.GET(Location.Code, UnitTestingValues.Value);
        //HEI.20>>
        IF Location."Receipt Bin Code" <> Bin.Code THEN
            Location."Receipt Bin Code" := Bin.Code;
        Location.MODIFY;
        //HEI.20<<

        //Check default value for Lot
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::"Lot No. Information");
        LotNoFilter := UnitTestingValues.Value;

        //HEI.20>>
        //Check default value for Truck

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::Vehicle101FDW);
        IF NOT Truck.GET(UnitTestingValues.Value) THEN BEGIN
            Truck.INIT;
            Truck.Code := 'LOG076';
            Truck.INSERT;
        END ELSE
            IF Truck."Status FND" <> Truck."Status FND"::Open THEN BEGIN
                Truck."Status FND" := Truck."Status FND"::Open;
                Truck.MODIFY;
            END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Driver

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::Driver107FDW);
        IF NOT Driver.GET(UnitTestingValues.Value) THEN BEGIN
            Driver.INIT;
            Driver.Code := 'LOG076';
            Driver.INSERT;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // UnitTestingValues.RESET;
        // UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::"Shipping Agent Services");
        // IF ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value) THEN
        //     IF ShippingAgentServices."Allow Shipping Cost Per" <> ShippingAgentServices."Allow Shipping Cost Per"::" " THEN BEGIN
        //         ShippingAgentServices."Allow Shipping Cost Per" := ShippingAgentServices."Allow Shipping Cost Per"::" ";
        //         ShippingAgentServices.MODIFY;
        //     END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for CCC Dimension Value Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::"Dimension Value");
        GeneralLedgerSetup.GET;
        IF DimensionValue.GET(GeneralLedgerSetup."Cost Center Dimension Code FND", UnitTestingValues.Value) THEN;

        //Check default value for Gate Entry No. Series
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG076', COMPANYNAME, DATABASE::"No. Series");
        NoSeries.GET(UnitTestingValues.Value);

        //Disable mandatory Expiration Date
        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;

        //Add Gate Entry No. Series
        WarehouseSetup.GET;
        IF WarehouseSetup."Gate Entry Nos. FND" = '' THEN BEGIN
            WarehouseSetup."Gate Entry Nos. FND" := NoSeries.Code;
            WarehouseSetup.MODIFY;
        END;

        //Add Default Location for UserID
        WarehouseEmployee.RESET;
        WarehouseEmployee.SETRANGE("User ID", USERID);
        WarehouseEmployee.SETRANGE("Location Code", Location.Code);
        IF WarehouseEmployee.FINDFIRST THEN BEGIN
            // BC Upgrade PATELP08 >> Always persist warehouse employee setup for this user/location
            IF WarehouseEmployee."Zone Code FND" <> Zone.Code THEN
                WarehouseEmployee."Zone Code FND" := Zone.Code;
            IF NOT WarehouseEmployee.Default THEN
                WarehouseEmployee.Default := TRUE;
            WarehouseEmployee.MODIFY;
            // BC Upgrade PATELP08 <<
        END ELSE BEGIN
            WarehouseEmployee.INIT;
            WarehouseEmployee."User ID" := USERID;
            WarehouseEmployee."Location Code" := Location.Code;
            WarehouseEmployee."Zone Code FND" := Zone.Code;
            WarehouseEmployee.Default := TRUE;
            WarehouseEmployee.INSERT;
        END;

        PurchasesPayablesSetup.GET;
        IF PurchasesPayablesSetup."Requester ID Mandatory FND" THEN BEGIN
            PurchasesPayablesSetup."Requester ID Mandatory FND" := FALSE;
            PurchasesPayablesSetup.MODIFY;
        END;
        //HEI.20<<

        //Step 1 - Log on to  HeiLite with the right user name and password

        //Step 2 - "Required Setup Either in Location on in Zone ""Inbound Automatic Registration"" boolean is checked"
        Location.TESTFIELD("InBound Auto Registration FND", TRUE);
        //Zone.TESTFIELD("Inbound Automatic Registration",TRUE); //HEI.20

        //Step 3"Required Setup: In Location on ""Enable inbound validation"" boolean is not checked"
        Location.TESTFIELD("Enable Inbound Validation FND", TRUE);

        //Step 4"Required Setup Either in Location on in Zone ""Purchase Gate Entry Mandatory FND"" boolean is checked"
        Location.TESTFIELD("Purchase Gate Entry Mandat FND", TRUE);
        Zone.TESTFIELD("Purch. GateEntry Mandatory FND", TRUE);

        //Step 5 - Create a Purchase Order with complete information
        PurchaseOrder.OPENNEW;
        PurchaseOrder.NEW;

        PurchaseOrder."No.".ASSISTEDIT;
        PurchaseOrder."Buy-from Vendor No.".SETVALUE(Vendor."No.");
        PurchaseOrder."Location Code".SETVALUE(Location.Code);
        // PurchaseOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        PurchaseOrder."Route 107FDW".SETVALUE(Route.Code);
        //HEI.20>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Ship. Agent Serv. Mand. APS" AND
           (ShippingAgent.Code <> '') AND
           (PurchaseOrder."Shipping Agent Code 107FDW".VALUE <> ShippingAgent.Code)
        THEN
            PurchaseOrder."Shipping Agent Code 107FDW".SETVALUE(ShippingAgent.Code);

        IF Route."Shipping Agent Mand. APS" AND
           (ShippingAgentServices.Code <> '') AND
           (PurchaseOrder."LOG Shipping Agent Service 107FDW".VALUE <> ShippingAgentServices.Code)
        THEN
            PurchaseOrder."LOG Shipping Agent Service 107FDW".SETVALUE(ShippingAgentServices.Code);

        IF (PurchaseOrder."LOG Vehicle Code 107FDW".VALUE = '') AND (Truck.Code <> '') THEN
            PurchaseOrder."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        IF (PurchaseOrder."Log Driver 107FDW".VALUE = '') AND (Driver.Code <> '') THEN
            PurchaseOrder."Log Driver 107FDW".SETVALUE(Driver.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.20<<

        PurchaseOrder.PurchLines.NEW;
        PurchaseOrder.PurchLines.Type.SETVALUE(Type::Item); // BC Upgrade PATELP08 >> Ensure purchase line type is Item before validating No. to avoid Standard Text lookup
        PurchaseOrder.PurchLines."No.".SETVALUE(Item."No.");
        PurchaseOrder.PurchLines."Location Code".SETVALUE(Location.Code);
        //PurchaseOrder.PurchLines."Special Order Sales No.".SETVALUE(WORKDATE); //HEI.15
        PurchaseOrder.PurchLines.Quantity.SETVALUE(2);

        //HEI.20>>
        PurchaseOrder.PurchLines.Dimensions.INVOKE;

        //Disable Workflows before Release
        PurchaseHeader.GET(PurchaseHeader."Document Type"::Order, PurchaseOrder."No.".VALUE);
        IF ApprovalsMgmt.IsPurchaseApprovalsWorkflowEnabled(PurchaseHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;
        //HEI.20<<

        //HEI.70>>
        //Check Import PO
        PurchaseHeaderAdditional.RESET;
        PurchaseHeaderAdditional.GET(PurchaseHeader."Document Type"::Order, PurchaseOrder."No.".VALUE);
        IF PurchaseHeaderAdditional."Import Identifier" THEN BEGIN
            PurchaseOrder."Expctd Physical Delvry Date(Imp)".SETVALUE(TODAY);
            PurchaseOrder.PurchLines."Location Code".SETVALUE(PurchasesPayablesSetup."Location Code Imp Proc. FND");
        END;
        //HEI.70<<

        //Step 6 - Release the Order
        PurchaseOrder.Release.INVOKE;

        //Step 7 - In the Search box, enter Gate Entry Inbound, and then choose the related link
        GateEntryInboundList.OPENEDIT;
        GateEntryInbound.OPENNEW;
        GateEntryInbound.NEW;

        //Step 8 - Create new Gate Entry Document, Click in Gate Entry Document No. and press tab.
        GateEntryInbound."Gate Entry Document No.".SETVALUE('');
        GateEntryInbound."Location Code".SETVALUE(Location.Code); //HEI.20
        //Step 9 - If User has not Gate entry creation Permission in User Setup the he will not able to create Gate Entry

        //Step 10 - In the box of Vehicle No. enter the respective trucks from the list
        // GateEntryInbound."Vehicle No.".SETVALUE(PurchaseOrder."Truck Code".VALUE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        GateEntryInbound."Vehicle No.".SETVALUE(PurchaseOrder."LOG Vehicle Code 107FDW".VALUE);

        //Step 11 - In the box of Driver select respective driver from the list.
        // GateEntryInbound."Driver Code".SETVALUE(PurchaseOrder."Driver Code".VALUE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        GateEntryInbound."Driver Code".SETVALUE(PurchaseOrder."Log Driver 107FDW".VALUE);

        //Step 12 - In the box Document Type chose from the list.
        GateEntryInbound."Document Type".SETVALUE(GateEntry_DocumentType::"Warehouse Receipt");

        //Step 13 - In the field Total Weight on arrival type the weight if applicable.

        //Step 14 - Add all the Items in Line with physical varified Quantity
        GateEntryInbound.GateEntryLine.NEW;
        GateEntryInbound.GateEntryLine.Type.SETVALUE(TypeGE::Item);
        //GateEntryInbound.GateEntryLine.FIRST; // BC Upgrade PATELP08 >> Refresh current gate entry line context after setting type
        GateEntryInbound.GateEntryLine."No.".SETVALUE(Item."No.");
        GateEntryInbound.GateEntryLine."Quantity on Arrival".SETVALUE(2);
        GateEntryInbound.GateEntryLine."Unit Of Measure Code".SETVALUE(Item."Purch. Unit of Measure"); //HEI.20

        //Step 15 - Click on release document.

        // GateEntryInbound.Action1000000034.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GateEntryInbound."Release".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        GateEntryNo := GateEntryInbound."Gate Entry Document No.".VALUE;

        //Step 16 - Create Warehouse receipt document and attached Gate entry after filling all required information
        WarehouseReceipt.TRAP;
        // PurchaseOrder.Action149.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        PurchaseOrder."Create &Whse. Receipt".INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name


        WarehouseReceipt."Gate Entry No.".SETVALUE(GateEntryNo);

        //HEI.20>>
        WarehouseReceipt.WhseReceiptLines.FILTER.SETFILTER("Item No.", Item."No.");
        //++ Zone, Bin, Quantity should be setup before Item Tracking
        WarehouseReceipt.WhseReceiptLines."Qty. to Receive".SETVALUE(2);
        //WarehouseReceipt.WhseReceiptLines."Zone Code".SETVALUE(Zone.Code);
        //WarehouseReceipt.WhseReceiptLines."Bin Code".SETVALUE(Bin.Code);

        ItemUnitofMeasure.SETRANGE(Code, Item."Purch. Unit of Measure"); //HEI.45
        ItemUnitofMeasure.SETRANGE("Item No.", Item."No.");
        IF ItemUnitofMeasure.FINDFIRST THEN
            ItemTrackingQtyBase := WarehouseReceipt.WhseReceiptLines."Qty. to Receive".ASDECIMAL * ItemUnitofMeasure."Qty. per Unit of Measure"
        ELSE
            //HEI.20<<
            ItemTrackingQtyBase := 2;
        WarehouseReceipt.WhseReceiptLines.ItemTrackingLines.INVOKE;

        //HEI.20>>
        //-- Zone, Bin, Quantity should be setup before Item Tracking
        //WarehouseReceipt.WhseReceiptLines.FIRST;
        //WarehouseReceipt.WhseReceiptLines."Qty. to Receive".SETVALUE(2);
        //WarehouseReceipt.WhseReceiptLines."Zone Code".SETVALUE(Zone.Code);
        //WarehouseReceipt.WhseReceiptLines."Bin Code".SETVALUE(Bin.Code);
        //HEI.20<<

        //Step 18 - Post the Warehouse Receipt
        WarehouseReceipt."Post Receipt".INVOKE;
        //    WarehouseReceipt.Close; // BC Upgrade PATELP08 >> Close trapped Warehouse Receipt page after posting to avoid page cannot be closed error

        //Step 19 - Gate entry is also registerd

        // GateEntryInbound.Action55001.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changed
        GateEntryInbound.Register.INVOKE;//BC UPGRADE KUMARR78 Adding with Change Action Name

        //HEI.08>>
    end;

