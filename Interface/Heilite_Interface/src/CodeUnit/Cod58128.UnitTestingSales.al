        //Step 1: Login

        //Step 2 - Open Sales Order List Page
        //SalesOrderList.OPENEDIT; //HEI.64>>

        //Step 3 - Create NEW Sales Order
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        //Step 4 - AssitEdit to create the Document No. & Add Customer No.
        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >>
        //SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer No.".SETVALUE(Customer."No.");
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);

        //Steps 5, 6 & 7 - Add Route, Shipment Date and External Document No.
        //SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78>> Blocking As DIT Field Was Used
        SalesOrder."Route 107FDW".SETVALUE(Route.Code);//BC Upgrade VAMSIU01 Replaced Route field with new route field
