        //Status from Certified to “Under Development “.

        SalesPurchaseConditionRuleCard.OpenNew();
        Evaluate(ConditionRule, SalesPurchaseConditionRuleCard."Rule No.".Value());

        SalesPurchaseConditionRuleCard."Calculation Code".SetValue(ConditionCalc.Code);
        SalesPurchaseConditionRuleCard."Source Type".SetValue(4);
        SalesPurchaseConditionRuleCard."Source No.".SetValue(GroupCustomer.Code);
        SalesPurchaseConditionRuleCard."Item Type".SetValue(3);
        SalesPurchaseConditionRuleCard."Item No.".SetValue(GroupItem.Code);
        SalesPurchaseConditionRuleCard.Status.Setvalue(2);
        //Step2:Added Rates for Item
        SalesPurchaseConditionRuleCard.RateLines.New();
        SalesPurchaseConditionRuleCard.RateLines."Starting Date".SETVALUE(WORKDATE);
        SalesPurchaseConditionRuleCard.RateLines."Minimum Quantity".SETVALUE(10);
        SalesPurchaseConditionRuleCard.RateLines."Unit of Measure Code".SETVALUE(FreeItemUOM.Code);
        SalesPurchaseConditionRuleCard.RateLines."Item No.".SetValue(FreeItem."No.");
        SalesPurchaseConditionRuleCard.RateLines."Free Quantity".SETVALUE(1);


        //Step 3: Delete Promotion//
        RateLines.Setrange(ConditionRuleNo, ConditionRule);
        if RateLines.FindFirst() then
            RateLines.Delete();

        //BC UPGRADE ATHUKS01<<


        //HEI.26>>
    end;

