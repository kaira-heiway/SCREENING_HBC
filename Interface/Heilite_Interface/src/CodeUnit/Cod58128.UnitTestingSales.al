        SalesOrder."Route 107FDW".SETVALUE(Route.Code);// BC Upgrade VAMSIU01 Replaced Route field
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE); // BC Upgrade VAMSIU01 Replaced ShipmentDatenew field with Shipment date field.
        SalesOrder."External Document No.".SETVALUE('Unit Test OTC053');

        //HEI.17>>
