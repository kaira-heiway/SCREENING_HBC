        //IF ReportSelections.FINDFIRST THEN BEGIN
        //ReportSelections.VALIDATE("Report ID",50257);
        //ReportSelections.MODIFY;
        //END ELSE BEGIN
        IF ReportSelections.FINDSET THEN
