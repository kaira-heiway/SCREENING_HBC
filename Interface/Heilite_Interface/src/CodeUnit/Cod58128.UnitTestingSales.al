    begin
        ClearVariables('OTC096'); //HEI.31
        //HEI.06>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC096', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.19>>

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Customer."Purchasing Code" <> '' THEN
        //     Customer."Purchasing Code" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF Customer."Shipping Advice" = Customer."Shipping Advice"::Partial THEN
            Customer."Shipping Advice" := Customer."Shipping Advice"::Complete;
        Customer.MODIFY;
        //HEI.19<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC096', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check default value for Route
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC096', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC096', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        IF Location."Sales Gate Entry Mandatory FND" THEN BEGIN
            Location."Sales Gate Entry Mandatory FND" := FALSE;
            Location.MODIFY;
        END;

        //HEI.36>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        Route."shipping location" := Location.Code;
        Route."receipt location" := Location.Code;
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.36<<

        //Check default value for Document Subtype

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC096', COMPANYNAME, DATABASE::"Document Subtype Code FND");
        DocumentSubtypeCode.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.19>>
        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN
            IF ItemTrackingCode."Strict Expiration Posting" THEN BEGIN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
                ItemTrackingCode.MODIFY;
            END;

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Multiple Order Route" THEN BEGIN
            Route."Multiple Order Route" := FALSE;
            Route.MODIFY;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC096', COMPANYNAME, DATABASE::Zone);
        Zone.GET(Location.Code, UnitTestingValues.Value);
        IF Zone."Sales Gate Entry Mandatory FND" THEN BEGIN
            Zone."Sales Gate Entry Mandatory FND" := FALSE;
            Zone.MODIFY;
        END;

        //Check the default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC096', COMPANYNAME, DATABASE::Bin);
        Bin.GET(Location.Code, UnitTestingValues.Value);

        IF Location."Shipment Bin Code" <> Bin.Code THEN
            Location."Shipment Bin Code" := Bin.Code;
        Location.MODIFY;

        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC096', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Ship. Agent Serv. Mand. APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC096', COMPANYNAME, DATABASE::"Shipping Agent Services");
            ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value);
        END;

        //Check the default value for Driver
        IF Route."Driver Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC096', COMPANYNAME, DATABASE::Driver107FDW);
            Driver.GET(UnitTestingValues.Value);
        END;

        //Check the default value for Truck
        IF Route."Vehicle Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('OTC096', COMPANYNAME, DATABASE::Vehicle101FDW);
            Truck.GET(UnitTestingValues.Value);
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Disable Notifications for Credit Limit and Stockout
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Activate CIS System FND" THEN
            SalesReceivablesSetup."Activate CIS System FND" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.19<<

        //Step 1: Login

        //Step 2: Create Order with back dated Posting Date
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        SalesOrder."No.".ASSISTEDIT;
        SalesOrder."Document Subtype Code".SETVALUE(DocumentSubtypeCode.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);
        SalesOrder."Location Code".SETVALUE(Location.Code); //HEI.19
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Posting Date".SETVALUE('01012021');

        //HEI.19>>
        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38
             //HEI.19<<

        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        SalesOrder.SalesLines."Unit of Measure Code".SetValue(Item."Base Unit of Measure"); // BC Upgrade PATELP08 ADDED - base UoM so Auto-FEFO can assign the lot
        //SalesOrder.SalesLines."Location Code".SETVALUE(Location.Code); //HEI.19

        //Send for approval
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            //HEI.19>>

            //HEI.81>>

            // UserSetup5.SETRANGE("Unlimited Deposit Limit Cust.", TRUE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
            IF UserSetup5.FINDFIRST THEN
                DepositLimitApproverID := UserSetup5."User ID";
            //HEI.81<<

            // UserSetup3.SETRANGE("Unlimited Cr. Limit Customer", TRUE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
            IF UserSetup3.FINDFIRST THEN BEGIN
                UserSetup4.GET(USERID);
                // UserSetup4."Credit Limit Approver ID" := UserSetup3."User ID";//BC UPGRADE KUMARR78 >> Blocking DIT Code
                //HEI.81>>
                // UserSetup4."Deposit Limit Approver ID" := UserSetup3."User ID";//HEI.78
                // UserSetup4."Deposit Limit Approver ID" := DepositLimitApproverID;//BC UPGRADE KUMARR78 >> Blocking DIT Code
                //HEI.81<<
                UserSetup4."Approver ID" := UserSetup3."User ID";
                UserSetup4.MODIFY;
            END;
            //HEI.19<<
            SalesOrder.SendApprovalRequest.INVOKE;
            ApprovalEntries.TRAP;
            SalesOrder.Approvals.INVOKE;

            //HEI.19>>
            ApprovalEntries.FILTER.SETFILTER(Status, '1');
            IF (ApprovalEntries."Approver ID".VALUE <> '') AND
               (ApprovalEntries."Approver ID".VALUE <> USERID)
            THEN BEGIN
                //HEI.19<<
                //HEI.83>>
                /*UserSetup.GET(ApprovalEntries."Approver ID".VALUE);
                UserSetup.Substitute := USERID;
                UserSetup."Deposit Substitute" := USERID;//HEI.78
                UserSetup.MODIFY;*/
                //HEI.83<<

                //Update Approval Limit for USERID

                //BC UPGRADE KUMARR78 >> Blocking DIT Code
                // UserSetup2.GET(USERID);
                // IF NOT UserSetup2."Unlimited Sales Approval" OR NOT UserSetup2."Unlimited Cr. Limit Customer" OR
                //    NOT UserSetup2."Unlimited Deposit Limit Cust." OR NOT UserSetup2."Unlimited Overdue Approval"
                // THEN BEGIN
                //     UserSetup2."Unlimited Sales Approval" := TRUE;
                //     UserSetup2."Unlimited Cr. Limit Customer" := TRUE;
                //     UserSetup2."Unlimited Deposit Limit Cust." := TRUE;
                //     UserSetup2."Unlimited Overdue Approval" := TRUE;
                //     UserSetup2.MODIFY;
                // END;
                //BC UPGRADE KUMARR78 << Blocking DIT Code

                //HEI.78>>
                //ApprovalEntries.Action35.INVOKE;

                //Update Substitute for Approver ID = USERID
                ApprovalEntry.SETCURRENTKEY("Table ID", "Document No.", Status);  //HEI.83
                ApprovalEntry.SETRANGE("Table ID", 36);
                ApprovalEntry.SETRANGE("Document No.", SalesHeader."No.");
                ApprovalEntry.SETRANGE(Status, ApprovalEntry.Status::Open);
                //HEI.83>>
                //UserSetup.GET(ApprovalEntries."Approver ID".VALUE);
                IF ApprovalEntry.FINDSET(FALSE) THEN
                    REPEAT
                        UserSetup.GET(ApprovalEntry."Approver ID");
                        UserSetup.Substitute := USERID;
                        // UserSetup."Deposit Substitute" := USERID;//BC UPGRADE KUMARR78 >> Blocking DIT Code
                        UserSetup.MODIFY;
                    UNTIL ApprovalEntry.NEXT = 0;
                //HEI.83<<

                //Delegate Approval Request
                ApprovalsMgmt.DelegateApprovalRequests(ApprovalEntry);
                //HEI.78<<


                //Approve Approval Entry
                //HEI.78>>
                //ApprovalEntries.Action35.INVOKE;
                ApprovalEntry.SETRANGE("Table ID", 36);
                ApprovalEntry.SETRANGE("Document No.", SalesHeader."No.");
                ApprovalEntry.SETRANGE(Status, ApprovalEntry.Status::Open);
                IF ApprovalEntry.FINDSET THEN
                    REPEAT
                        SalesOrder.Approve.INVOKE;
                    UNTIL ApprovalEntry.NEXT = 0;
                //HEI.78<<
            END; //HEI.19
        END ELSE
            SalesOrder.Release.INVOKE;

        //Create Warehouse Shipment
        WarehouseShipment.TRAP;
        // SalesOrder.Action149.INVOKE; //BC UPGRADE KUMARR78 Blocking As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder."Create &Warehouse Shipment".INVOKE; //BC UPGRADE KUMARR78 Adding As Changing Action Button Name From Action149 to "Create &Warehouse Shipment"
        SalesOrder.OK.INVOKE; //HEI.19
                              // WarehouseShipment.Action1100076703.INVOKE;//BC UPGRADE KUMARR78 DIT Action

        //HEI.19>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseShipment."Shipping Agent Code".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseShipment."Shipping Agent Service Code".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseShipment."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseShipment."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.19<<

        WarehouseShipment."&Automatic FEFO Tracking for Order".Invoke(); // BC Upgrade PATELP08 ADDED - assigns lot tracking before posting

        // WarehouseShipment.Action45.INVOKE;//BC UPGRADE KUMARR78 Blocking to Change Action.
        WarehouseShipment."Re&lease".INVOKE;//BC UPGRADE KUMARR78 Adding with Changed Action Name

        //Post Whse. Shipment
        // WarehouseShipment.Action25.INVOKE;//BC UPGRADE KUMARR78 Blocking As Action Name Changes From Action25 To "P&ost Shipment"
        WarehouseShipment."P&ost Shipment".INVOKE;//BC UPGRADE KUMARR78 Adding As Action Name Changes From Action25 To "P&ost Shipment"

        //Step 3: Create second Order
        //HEI.19>>
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Activate CIS System FND" THEN
            SalesReceivablesSetup."Activate CIS System FND" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;

        SalesOrder.OPENNEW;
        //HEI.19<<
        SalesOrder.NEW;

        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);
        SalesOrder."Location Code".SETVALUE(Location.Code); //HEI.19
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        //HEI.19>>
        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38
             //HEI.19<<

        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(2);
        //SalesOrder.SalesLines."Location Code".SETVALUE(Location.Code); //HEI.19

        //Step 4: Receive Error for Release due to overdue
        //ASSERTERROR just if Workflow is enabled
        //SalesReceivablesSetup.GET; //HEI.19

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF SalesReceivablesSetup."Automatic Document Approval" THEN BEGIN
        //     SalesReceivablesSetup."Automatic Document Approval" := FALSE;
        //     SalesReceivablesSetup.MODIFY;
        // END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        // BC Upgrade PATELP08 >> The overdue-blocking on release is DIT functionality removed in BC,
        // so SalesOrder.Release.INVOKE no longer errors. Guard the ASSERTERROR with the approval
        // workflow check (same pattern as OTC095/OTC097); otherwise the ASSERTERROR fails with
        // "An error was expected inside an ASSERTERROR statement."
        // IF WorkflowManagement.CanExecuteWorkflow(SalesHeader, WorkflowEventHandling.RunWorkflowOnSendSalesDocForApprovalCodeOverdue) THEN BEGIN //BC UPGRADE KUMARR78 >> Blocking DIT Event Removed.
        // ASSERTERROR SalesOrder.Release.INVOKE;

        // IF GETLASTERRORTEXT <> DocumentApprovalNeededErr THEN
        //     ERROR('Unexpected Error: %1', GETLASTERRORTEXT)
        // end;//BC UPGRADE KUMARR78 << Blocking End for Being which was using Removed DIT Event.
        // ELSE
        //     IF NOT ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN //HEI.19
        //         SalesOrder.Release.INVOKE;
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
        END ELSE
            SalesOrder.Release.INVOKE;
        // BC Upgrade PATELP08 <<
        //HEI.06<<

    end;

