        DocumentApprovalNeededErr: TextConst ENU = 'This document can only be released when the approval process is complete.', FRA = 'Ce document ne peut être lancé que lorsque le processus d''approbation est terminé.';
        InvoiceNo: Code[20];
        OrderNo: Code[20];
        AmttoPay: Decimal;
        GLAccount: Record "G/L Account";
        UserSetup: Record "User Setup";
        SalesReceivablesSetup: Record "Sales & Receivables Setup";
        Workflow: Record Workflow;
        ApprovalEntry: Record "Approval Entry";
    begin
        ClearVariables('OTC106'); //HEI.31
        //HEI.06>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC106', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF Customer."Bill-to Customer No." <> '' THEN
            BillToCustomer.GET(Customer."Bill-to Customer No.")
        ELSE
            BillToCustomer.GET(Customer."No.");

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Customer."Purchasing Code" <> '' THEN
        //     Customer."Purchasing Code" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF Customer."Shipping Advice" = Customer."Shipping Advice"::Partial THEN
            Customer."Shipping Advice" := Customer."Shipping Advice"::Complete;
        IF BillToCustomer."Application Method" = BillToCustomer."Application Method"::"Apply to Oldest" THEN
            BillToCustomer."Application Method" := BillToCustomer."Application Method"::Manual;
        Customer.MODIFY;
        //HEI.19<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC106', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check default value for Route

        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC106', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.69>>
        //HEI.19>>
        // IF Route."Multiple Order Route" THEN BEGIN
        //  Route."Multiple Order Route" := FALSE;
        //  Route.MODIFY;
        // END;
        //HEI.19<<
        //HEI.69<<

        //HEI.76>>
        IF COMPANYNAME = 'Brasco' THEN BEGIN
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;
        //HEI.76<<

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC106', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);

        //HEI.36>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        Route."shipping location" := Location.Code;
        Route."receipt location" := Location.Code;
        //HEI.69>>
        IF Route."Multiple Order Route" THEN
            Route."Multiple Order Route" := FALSE;
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.69<<

        //Check default value for Journal Template
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC106', COMPANYNAME, DATABASE::"Gen. Journal Template");
        GenJournalTemplate.GET(UnitTestingValues.Value);
        //HEI.19>>
        IF GenJournalTemplate."SO Cash Application FND" THEN
            GenJournalTemplate."SO Cash Application FND" := FALSE;
        IF GenJournalTemplate."RPM Payment FND" THEN
            GenJournalTemplate."RPM Payment FND" := FALSE;
        GenJournalTemplate.MODIFY;


        //Check default value for GL Account
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC106', COMPANYNAME, DATABASE::"G/L Account");
        GLAccount.GET(UnitTestingValues.Value);
        //HEI.19<<

        //Check default value for Journal Batch
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC106', COMPANYNAME, DATABASE::"Gen. Journal Batch");
        GenJournalBatch.GET(GenJournalTemplate.Name, UnitTestingValues.Value);

        //Check default value for Payment Method
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC106', COMPANYNAME, DATABASE::"Payment Method");
        PaymentMethod.GET(UnitTestingValues.Value);

        //Update user Setup
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // UserSetup.GET(USERID);
        // //HEI.78>>
        // IF NOT UserSetup."Unlimited Deposit Limit Cust." THEN BEGIN
        //     UserSetup."Unlimited Deposit Limit Cust." := TRUE;
        //     UserSetup.MODIFY;
        // END;
        // //HEI.78<<
        // IF NOT UserSetup."Unlimited Cr. Limit Customer" THEN BEGIN
        //     UserSetup."Unlimited Cr. Limit Customer" := TRUE;
        //     UserSetup.MODIFY;
        // END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Disable Notifications for Credit Limit and Stockout
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Activate CIS System FND" THEN
            SalesReceivablesSetup."Activate CIS System FND" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.19<<

        //Disable Gen. Journal Batch Approval Workflow
        //HEI.80>>
        DisableGenJournalBatchApprovalWorkflow(GenJournalBatch);
        //HEI.80<<

        //Step 1: Login

        //Access Customer Card and setup Customer Credit Limit to low value
        // CustomerList.OPENVIEW; //HEI.69
        CustomerCard.OPENEDIT;
        //HEI.19>>
        //CustomerCard.FINDFIRSTFIELD("No.",Customer."No.");
        CustomerCard.FILTER.SETFILTER("No.", Customer."No.");
        //HEI.19<<
        CustomerCard."Credit Limit (LCY)".SETVALUE(10);
        CustomerCard.Close();// BC Upgrade PATELP08 close card while topmost; never closed later -> teardown 'page cannot be closed'

        //Step 2,3,4,5: Create Sales Order blocked for Credit Limit
        SalesOrder.OPENNEW;
        SalesOrder.NEW;

        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);
        SalesOrder."Location Code".SETVALUE(Location.Code); //HEI.19
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);

        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        //SalesOrder.SalesLines."Location Code".SETVALUE(Location.Code); //HEI.19

        //BC UPGRADE KUMARR78 >> Blocking DIT Event Removed.
        // IF WorkflowManagement.CanExecuteWorkflow(SalesHeader, WorkflowEventHandling.RunWorkflowOnSendSalesDocForApprovalCodeCredit) THEN
        //     SalesOrder.SendApprovalRequest.INVOKE
        // //HEI.19>>
        // ELSE
        //     MESSAGE('No approval request sent.');
        //BC UPGRADE ATHUKS01>>
        IF WorkflowManagement.CanExecuteWorkflow(SalesHeader, WorkflowEventHandling.RunWorkflowOnSendSalesDocForApprovalCode) THEN
            SalesOrder.SendApprovalRequest.INVOKE
        //HEI.19>>
        ELSE
            MESSAGE('No approval request sent.');
        //BC UPGRADE ATHUKS01<<
        //  BC UPGRADE KUMARR78 << Blocking DIT Event Removed.

        //HEI.19<<
        OrderNo := SalesOrder."No.".VALUE;
        SalesOrder.Close();// BC Upgrade PATELP08 close order in-body like OTC098; OK.INVOKE left 1st instance unclosable before variable reuse -> teardown error

        //Step 6,7,8: Go to Customer Ledger Entries to see if open entries exist
        CustomerLedgerEntries.OPENVIEW;
        //HEI.19>>
        //CustomerLedgerEntries.FILTER.SETFILTER("Customer No.",Customer."No.");
        CustomerLedgerEntries.FILTER.SETFILTER("Customer No.", Customer."Bill-to Customer No.");
        //HEI.19<<
        CustomerLedgerEntries.FILTER.SETFILTER(Open, 'TRUE');
        CustomerLedgerEntries.FILTER.SETFILTER("Document Type", '2');
        IF CustomerLedgerEntries."Remaining Amt. (LCY)".ASDECIMAL <> 0 THEN //HEI.19
            EVALUATE(AmttoPay, CustomerLedgerEntries."Remaining Amt. (LCY)".VALUE);
        IF AmttoPay > 0 THEN
            InvoiceNo := CustomerLedgerEntries."Document No.".VALUE;// BC Upgrade PATELP08 capture before closing ledger page
        CustomerLedgerEntries.Close();// BC Upgrade PATELP08 close ledger while topmost (always); else teardown 'page cannot be closed' when AmttoPay<=0
        IF AmttoPay > 0 THEN BEGIN

            //Step 9,10: Apply Payment as per remittance advice
            //Create and apply Payment
            GeneralJournalTemplates.OPENVIEW;
            GeneralJournalBatches.TRAP;
            //HEI.19>>
            //GeneralJournalTemplates.FINDFIRSTFIELD(Name,GenJournalTemplate.Name);
            GeneralJournalTemplates.FILTER.SETFILTER(Name, GenJournalTemplate.Name);
            //HEI.19<<
            // GeneralJournalTemplates."Page General Journal Batches".INVOKE; //BC UPGRADE KUMARR78 >> Blocking DIT Code
            GeneralJournalTemplates."Batches".INVOKE;// BC Upgrade PATELP08 restore batches navigation (renamed action, as in OTC152) so TRAP opens page & stack stays valid
            CashReceiptJournal.TRAP;
            //HEI.19>>
            //GeneralJournalBatches.FINDFIRSTFIELD(Name,GenJournalBatch.Name);
            GeneralJournalBatches.FILTER.SETFILTER(Name, GenJournalBatch.Name);
            //HEI.19<<
            GeneralJournalBatches.EditJournal.INVOKE;

            //Remove existing lines in Journal to avoid errors
            GenJournalLine.RESET;
            GenJournalLine.SETRANGE("Journal Template Name", GenJournalTemplate.Name);
            GenJournalLine.SETRANGE("Journal Batch Name", GenJournalBatch.Name);
            IF GenJournalLine.FINDSET THEN //HEI.19
                GenJournalLine.DELETEALL;

            //Create Journal Line
            CashReceiptJournal.NEW;
            CashReceiptJournal."Document Type".SETVALUE(1);
            //HEI.19>>
            IF CashReceiptJournal."Document No.".VALUE = '' THEN
                CashReceiptJournal."Document No.".SETVALUE('OTC106');
            CashReceiptJournal."External Document No.".SETVALUE('OTC106');
            IF GenJournalBatch."Bal. Account No." = '' THEN BEGIN
                CashReceiptJournal."Bal. Account Type".SETVALUE(0);
                CashReceiptJournal."Bal. Account No.".SETVALUE(GLAccount."No.");
            END;
            //HEI.19<<
            CashReceiptJournal."Account Type".SETVALUE(1);
            //HEI.19>>
            //CashReceiptJournal."Account No.".SETVALUE(Customer."No.");
            CashReceiptJournal."Account No.".SETVALUE(BillToCustomer."No.");
            //HEI.19<<
            CashReceiptJournal.Amount.SETVALUE(-AmttoPay);
            //HEI.51>>
            //CashReceiptJournal."Payment Method Code".SETVALUE(PaymentMethod.Code);
            GenJournalLine.RESET;
            GenJournalLine.SETRANGE("Journal Template Name", GenJournalTemplate.Name);
            GenJournalLine.SETRANGE("Journal Batch Name", GenJournalBatch.Name);
            IF GenJournalLine.FINDFIRST THEN
                GenJournalLine."Payment Method Code" := PaymentMethod.Code;
            //HEI.51<<
            CashReceiptJournal."Applies-to Doc. Type".SETVALUE(2); //HEI.19
            CashReceiptJournal."Applies-to Doc. No.".SETVALUE(InvoiceNo);

            CashReceiptJournal.Post.INVOKE;
            CashReceiptJournal.Close();// BC Upgrade PATELP08 close journals while topmost (LIFO) before SalesOrder opens on top; else teardown 'page cannot be closed'
            GeneralJournalBatches.Close();// BC Upgrade PATELP08 close batches (now topmost)
            GeneralJournalTemplates.Close();// BC Upgrade PATELP08 close templates (now topmost)

            //Update Customer Credit Limit to cover the other Open entries
            IF Customer.FIND THEN BEGIN
                Customer."Credit Limit (LCY)" := 999999;
                // Customer."Deposit Limit (LCY)" := 99999999;//HEI.78 //BC UPGRADE KUMARR78 >> Blocking DIT Code
                Customer.MODIFY;
            END;
        END;

        //Step 11,12,13: Go to Sales Order
        SalesHeader.RESET;
        SalesHeader.GET(SalesHeader."Document Type"::Order, OrderNo);
        IF SalesHeader.Status = SalesHeader.Status::"Pending Approval" THEN BEGIN
            SalesOrder.OPENVIEW;// BC Upgrade PATELP08 view: order is read-only after Release; edit page can't close at teardown
            //HEI.69>>
            SalesOrder.FILTER.SETFILTER("Document Type", FORMAT(SalesHeader."Document Type"::Order));
            SalesOrder.FILTER.SETFILTER("No.", OrderNo);
            //  SalesOrder.GOTORECORD(SalesHeader);
            //HEI.69<<

            //Step 14: Check if Order is still blocked
            SalesOrder.CancelApprovalRequest.INVOKE;

            SalesOrder.Release.INVOKE;
            //HEI.57>>
            IF NOT (COMPANYNAME = 'Brasco') THEN
                SalesOrder.Status.ASSERTEQUALS(1);
            //HEI.57<<
            COMMIT;// BC Upgrade PATELP08 commit released order before close so page isn't dirty (matches OTC098); else teardown 'page cannot be closed'
            SalesOrder.Close();// BC Upgrade PATELP08 close reopened order while ConfirmHandler active; teardown has no handler
        END
        //HEI.19>>
        ELSE
            MESSAGE('Nothing to approve.');
        //HEI.19<<
        COMMIT;// BC Upgrade PATELP08 flush write txn before teardown (runs in BOTH branches); else open txn blocks page close -> 'page cannot be closed'
        //HEI.06<<
    end;

    [Test]
    [HandlerFunctions('NoSeriesListModalPageHandler,ConfirmationHandler')]
    procedure OTC107_AccessOrdersReleasedInThePast_Archive();
    var
        Customer: Record Customer;
        Item: Record Item;
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable
        Route: Record Route107FDW;
        Location: Record Location;
        Type: Option " ","G/L Account",Item,Resource,"Fixed Asset","Charge (Item)";
        SalesOrder: TestPage "Sales Order";
        SalesOrderArchives: TestPage "Sales Order Archives";
        SalesOrderArchive: TestPage "Sales Order Archive";
        SalesHeader: Record "Sales Header";
        SalesHeaderArchive: Record "Sales Header Archive";
        ApprovalsMgmt: Codeunit "Approvals Mgmt.";
        Workflow: Record Workflow;
        SalesReceivablesSetup: Record "Sales & Receivables Setup";
    begin
        ClearVariables('OTC107'); //HEI.31
        //HEI.06>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC107', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.19>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        // IF Customer."Purchasing Code" <> '' THEN
        //     Customer."Purchasing Code" := '';
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        IF Customer."Shipping Advice" = Customer."Shipping Advice"::Partial THEN
            Customer."Shipping Advice" := Customer."Shipping Advice"::Complete;
        Customer.MODIFY;
        //HEI.19<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC107', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check default value for Route
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC107', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('OTC107', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);
        //HEI.19>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        IF Route."Multiple Order Route" THEN BEGIN
            Route."Multiple Order Route" := FALSE;
            Route.MODIFY;
        END;
        //BC UPGRADE KUMARR78 << Blocking DIT Code

        //HEI.36>>
        //BC UPGRADE KUMARR78 >> Blocking DIT Code
        Route."shipping location" := Location.Code;
        Route."receipt location" := Location.Code;
        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking DIT Code
        //HEI.36<<

        //Disable Notifications for Credit Limit and Stockout
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Activate CIS System FND" THEN
            SalesReceivablesSetup."Activate CIS System FND" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.19<<

        //Step 1: Login

        //Create NEW Sales Order
        SalesOrder.OPENNEW;
        SalesOrder.NEW;
        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 >>
        SalesOrder."Sell-to Customer Name".SetValue(Customer.Name);
        SalesOrder."Location Code".SETVALUE(Location.Code); //HEI.19
        // SalesOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Route 107FDW".SETVALUE(Route.Code); // BC Upgrade PATELP08 ADDED
        SalesOrder."Requested Delivery Date".SETVALUE(WORKDATE);
        // SalesOrder.ShipmentDateNew.SETVALUE(WORKDATE);//BC UPGRADE KUMARR78 >> Blocking DIT Code
        SalesOrder."Shipment Date".SETVALUE(WORKDATE);

        SalesOrder.SalesLines.NEW;
        SalesOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesOrder.SalesLines."No.".SETVALUE(Item."No.");
        //SalesOrder.SalesLines."Location Code".SETVALUE(Location.Code); //HEI.19
        SalesOrder.SalesLines.Quantity.SETVALUE(1);

        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);

        //Disable Workflows before Release
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;

        //Sales Order Archieve is created on Reopen => Release, Reopen
        SalesOrder.Release.INVOKE;
        SalesOrder.Reopen.INVOKE;
        SalesOrder.OK.INVOKE;

        //Step 2,3,4: Go to Sales Order Archieve
        //Find the Sales Header Archieve for the Released Order
        SalesHeaderArchive.SETRANGE("Document Type", SalesHeader."Document Type"::Order);
        SalesHeaderArchive.SETRANGE("No.", SalesHeader."No.");
        SalesHeaderArchive.FINDFIRST;

        //Open Sales Order Archieve page
        SalesOrderArchives.OPENVIEW;
        SalesOrderArchive.OPENVIEW;

        //Step 5: Export to Excel
        //Built-in functionality. Cannot be tested automatically
        //HEI.19>>
        //SalesOrderArchive.GOTORECORD(SalesHeaderArchive);
        SalesOrderArchive.FILTER.SETFILTER("No.", SalesHeaderArchive."No.");
        //HEI.19<<
        SalesOrderArchive.OK.INVOKE;
        //HEI.06<<
    end;

