        GenJournalTemplate.GET(UnitTestingValues.Value);
        IF GenJournalTemplate."No. Series" <> '' THEN BEGIN
            GenJournalTemplate."No. Series" := '';
            GenJournalTemplate.MODIFY;
        END;

        //Check default value for GL Account
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOGNEW22', COMPANYNAME, DATABASE::"G/L Account");
        GLAccount.GET(UnitTestingValues.Value);
        IF GLAccount."VAT Prod. Posting Group" = '' THEN BEGIN
            //HEI.29>>
            //VATProductPostingGroup.FINDFIRST;
            //GLAccount."VAT Prod. Posting Group" := VATProductPostingGroup.Code;
            //HEI.36>>
            VATPostingSetup3.SETFILTER("Purchase VAT Account", '<>%1', '');
            VATPostingSetup3.SETRANGE("VAT Calculation Type", VATPostingSetup3."VAT Calculation Type"::"Normal VAT");
            //HEI.36<<
            IF VATPostingSetup3.FINDFIRST THEN //HEI.38
                GLAccount."VAT Prod. Posting Group" := VATPostingSetup3."VAT Prod. Posting Group"
            //HEI.38>>
            ELSE
                GLAccount."VAT Prod. Posting Group" := 'NO_VAT';
            //HEI.38<<
            GLAccount.MODIFY;
        END;

        //HEI.29>>
        //Update VAT Posting Setup
        IF NOT VATPostingSetup.GET(GLAccount."VAT Bus. Posting Group", GLAccount."VAT Prod. Posting Group") THEN BEGIN
            VATPostingSetup2.SETRANGE("VAT Prod. Posting Group", GLAccount."VAT Prod. Posting Group");
            IF VATPostingSetup2.FINDFIRST THEN BEGIN
                VATPostingSetup.INIT;
                VATPostingSetup := VATPostingSetup2;
                VATPostingSetup."VAT Bus. Posting Group" := GLAccount."VAT Bus. Posting Group";
                VATPostingSetup.INSERT;
            END;
        END;

        //Update EBF Combination
        //HEI.64>>
