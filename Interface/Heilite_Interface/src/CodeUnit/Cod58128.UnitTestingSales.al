        //HEI.22<<
        Reminder.ReminderLines."Remaining Amount".ASSERTEQUALS(CustLedgerEntry."Remaining Amount");
        Reminder.OK.INVOKE;

        //Step 7: Issue Reminders
        //HEI.22>>
        //ReminderList.FINDFIRSTFIELD("No.",DocNo);
        ReminderList.FILTER.SETFILTER("No.", DocNo);
        //HEI.22<<
        RemainingAmount := ReminderList."Remaining Amount".ASDECIMAL;

        ReminderList.Issue.INVOKE;
        ReminderList.OK.INVOKE;

        //Check created Issue Reminder
        IssuedReminder.OPENVIEW;
        IssuedReminder.FILTER.SETFILTER("Pre-Assigned No.", DocNo);
        IssuedReminderNo := IssuedReminder."No.".VALUE;

        //Check Remaining Amount from Issued Reminder
        IssuedReminderList.OPENVIEW;
        //HEI.22>>
        //IssuedReminderList.FINDFIRSTFIELD("No.",IssuedReminderNo);
        IssuedReminderList.FILTER.SETFILTER("No.", IssuedReminderNo);
        //HEI.22<<
        IssuedReminderList."Remaining Amount".ASSERTEQUALS(RemainingAmount);

        //HEI.11<<
    end;

