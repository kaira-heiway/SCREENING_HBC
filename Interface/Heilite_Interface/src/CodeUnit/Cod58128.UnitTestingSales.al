        MESSAGE(ApprovalWkflNotEnabledMsg);
        //HEI.38<<

        commit();
        //HEI.19>>
        SalesOrder.Close();

        SalesOrder.OPENNEW;
        //HEI.19<<

        //Create Order with Status = Released
        SalesOrder.NEW;
        SalesOrder."No.".ASSISTEDIT;
