        SalesReceivablesSetup: Record "Sales & Receivables Setup";
        ItemUnitofMeasure: Record "Item Unit of Measure";
        // Truck: Record "2014068";//BC UPGRADE KUMARR78 Blocking DIT Variable.
        // Driver: Record "2014063";//BC UPGRADE KUMARR78 Blocking DIT Variable.
        Truck: Record Vehicle101FDW;
        Driver: Record Driver107FDW;
        ShippingAgent: Record "Shipping Agent";
        ShippingAgentServices: Record "Shipping Agent Services";
        ItemTrackingCode: Record "Item Tracking Code";
    begin
        ClearVariables('LOG021'); //HEI.31
        //HEI.01>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);
        //HEI.15>>
        //BC UPGRADE KUMARR78 >> Blocking Due to DIT Field
        // IF Customer."Purchasing Code" <> '' THEN
        //     Customer."Purchasing Code" := '';
        //BC UPGRADE KUMARR78 << Blocking Due to DIT Field
        IF Customer."Return Order Mandatory FND" THEN
            Customer."Return Order Mandatory FND" := FALSE;
        //HEI.17>>
        IF NOT Customer."Additional RPM Return FND" THEN
            Customer."Additional RPM Return FND" := TRUE;
        //HEI.17<<
        Customer.MODIFY;
        //HEI.15<<

        //Check default value for Item
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::Item);
        Item.GET(UnitTestingValues.Value);

        //Check default value for Location
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::Location);
        Location.GET(UnitTestingValues.Value);

        //Check default value for Route
        //BC UPGRADE KUMARR78 >> Blocking Due to DIT Field
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::Route107FDW);
        Route.GET(UnitTestingValues.Value);

        // //HEI.36>>
        // Route."Location Code" := Location.Code;
        // Route."Return Location Code" := Location.Code;
        Route."Shipping Location" := Location.Code;
        Route."Receipt Location" := Location.Code;

        Route.MODIFY;
        //BC UPGRADE KUMARR78 << Blocking Due to DIT Field
        //HEI.36<<

        //Check default value for Return Reason Code
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::"Return Reason");
        ReturnReason.GET(UnitTestingValues.Value);

        //Check default value for Zone
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::Zone);
        Zone.GET(Location.Code, UnitTestingValues.Value);
        //HEI.17>>
        IF Zone."Sales Gate Entry Mandatory FND" THEN BEGIN
            Zone."Sales Gate Entry Mandatory FND" := FALSE;
            Zone.MODIFY;
        END;
        //HEI.17<<

        //Check default value for Bin
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::Bin);
        Bin.GET(Location.Code, UnitTestingValues.Value);
        //HEI.17>>
        IF Location."Receipt Bin Code" <> Bin.Code THEN
            Location."Receipt Bin Code" := Bin.Code;
        IF Location."Sales Gate Entry Mandatory FND" THEN
            Location."Sales Gate Entry Mandatory FND" := FALSE;
        Location.MODIFY;
        //HEI.17<<

        //Check default value for Lot
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::"Lot No. Information");
        LotNoFilter := UnitTestingValues.Value;

        //HEI.17>>
        //Check the default value for Shipping Agent
        UnitTestingValues.RESET;
        UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::"Shipping Agent");
        IF ShippingAgent.GET(UnitTestingValues.Value) THEN
            IF NOT ShippingAgent."Own Logistics FND" THEN BEGIN
                ShippingAgent."Own Logistics FND" := TRUE;
                ShippingAgent.MODIFY;
            END;

        //Check the default value for Shipping Agent Services
        //BC UPGRADE KUMARR78 >> Blocking Due to DIT Field
        IF Route."Ship. Agent Serv. Mand. APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::"Shipping Agent Services");
            ShippingAgentServices.GET(ShippingAgent.Code, UnitTestingValues.Value);
        END;

        //Check the default value for Driver
        IF Route."Driver Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::Driver107FDW);
            Driver.GET(UnitTestingValues.Value);
        END;

        //Check the default value for Truck
        IF Route."Vehicle Mandatory APS" THEN BEGIN
            UnitTestingValues.RESET;
            UnitTestingValues.GET('LOG021', COMPANYNAME, DATABASE::Vehicle101FDW);
            Truck.GET(UnitTestingValues.Value);
        END;
        //BC UPGRADE KUMARR78 << Blocking Due to DIT Field

        //Disable Notifications for Credit Limit and Stockout
        SalesReceivablesSetup.GET;
        IF SalesReceivablesSetup."Credit Warnings" <> SalesReceivablesSetup."Credit Warnings"::"No Warning" THEN
            SalesReceivablesSetup."Credit Warnings" := SalesReceivablesSetup."Credit Warnings"::"No Warning";
        IF SalesReceivablesSetup."Stockout Warning" THEN
            SalesReceivablesSetup."Stockout Warning" := FALSE;
        IF SalesReceivablesSetup."Activate CIS System FND" THEN
            SalesReceivablesSetup."Activate CIS System FND" := FALSE;
        IF SalesReceivablesSetup."Item Avlblty Msg Enable FND" THEN
            SalesReceivablesSetup."Item Avlblty Msg Enable FND" := FALSE;
        SalesReceivablesSetup.MODIFY;
        //HEI.17<<

        //Step 1: Login

        //Step 2 - Open Sales Return Order List Page
        SalesReturnOrderList.OPENEDIT;

        //Step 3 - Create a new Sales Return Order
        SalesReturnOrder.OPENNEW;
        SalesReturnOrderList.NEW;

        //AssitEdit to create the Document No. & Add Customer No.
        SalesReturnOrder."No.".ASSISTEDIT;

        SalesReturnOrder."Sell-to Customer Name".SetValue(Customer.Name);

        //Add Location, Route, Shipment Date and External Document No.
        SalesReturnOrder."Location Code".SETVALUE(Location.Code);
        // SalesReturnOrder.Route.SETVALUE(Route.Code);//BC UPGRADE KUMARR78 >> Blocking Due to DIT Field
        SalesReturnOrder."Route 107FDW".SETVALUE(Route.Code);
        SalesReturnOrder.ShipmentDateNew.SETVALUE(WORKDATE);
        SalesReturnOrder."External Document No.".SETVALUE('Unit Test LOG021');

        //Create Sales Return Line: No., Quantity
        SalesReturnOrder.SalesLines.NEW;
        SalesReturnOrder.SalesLines.Type.SETVALUE(Type::Item);
        SalesReturnOrder.SalesLines."No.".SETVALUE(Item."No.");
        SalesReturnOrder.SalesLines.Quantity.SETVALUE(2);

        //Step 4 - Select Return Reason Code
        SalesReturnOrder.SalesLines."Return Reason Code".SETVALUE(ReturnReason.Code);

        //Step 5 - Release the Sales Return Order
        SalesReturnOrder.Release.INVOKE;

        //Step 6 - Create Whse. Receipt
        WarehouseReceipt.TRAP;
        // SalesReturnOrder.Action122.INVOKE;//BC UPGRADE KUMARR78 Replacing Action122 With Action Button Name.
        SalesReturnOrder."Create &Whse. Receipt".INVOKE; //BC UPGRADE KUMARR78 Replacing Action122 With "Create &Whse. Receipt"


        //HEI.017>>
        //BC UPGRADE KUMARR78 >> Blocking Due to DIT Field
        IF Route."Shipping Agent Mand. APS" THEN
            WarehouseReceipt."Shipping Agent Code 107FDW".SETVALUE(ShippingAgent.Code);

        IF Route."Ship. Agent Serv. Mand. APS" THEN
            WarehouseReceipt."LOG Shipping Agent Service 107FDW".SETVALUE(ShippingAgentServices.Code);

        IF Route."Driver Mandatory APS" THEN
            WarehouseReceipt."Log Driver 107FDW".SETVALUE(Driver.Code);

        IF Route."Vehicle Mandatory APS" THEN
            WarehouseReceipt."LOG Vehicle Code 107FDW".SETVALUE(Truck.Code);
        //BC UPGRADE KUMARR78 << Blocking Due to DIT Field

        IF ItemTrackingCode.GET(Item."Item Tracking Code") THEN BEGIN
            IF ItemTrackingCode."Strict Expiration Posting" THEN
                ItemTrackingCode."Strict Expiration Posting" := FALSE;
            IF ItemTrackingCode."Man. Expir. Date Entry Reqd." THEN
                ItemTrackingCode."Man. Expir. Date Entry Reqd." := FALSE;
            ItemTrackingCode.MODIFY;
        END;
        //HEI.17<<

        //Go to the Whse. Receipt Line
        WarehouseReceipt.WhseReceiptLines.FIRST;

        //Step 7 - Add Zone and Bin
        //Zone and Bin are not visible on Page
        //WarehouseReceipt.WhseReceiptLines."Zone Code".SETVALUE(Zone.Code);
        //WarehouseReceipt.WhseReceiptLines."Bin Code".SETVALUE(Bin.Code);

        //Step 8 - Print Truck Unloading Note
        //Check if Report Selection is configured for Truck Unloading Note
        /*ReportSelections.RESET;
        ReportSelections.SETRANGE(Usage,ReportSelections.Usage::"Unloading Note(Whse. Receipt)");
        ReportSelections.SETFILTER("Report ID",'<>0');
        
        //Update the Report ID with 50264 - UnLoading Note STD
        IF ReportSelections.FINDFIRST THEN BEGIN
          ReportSelections.VALIDATE("Report ID",50264);
          ReportSelections.MODIFY;
        END ELSE BEGIN
          ReportSelections.INIT;
          ReportSelections.VALIDATE(Usage,ReportSelections.Usage::"Unloading Note(Whse. Receipt)");
          ReportSelections.VALIDATE("Report ID",50264);
          ReportSelections.INSERT;
        END;
        */

        //Print the Report
        //Action cannot be used due to CAL functions are limited during write transactions
        //WarehouseReceipt.Action55000.INVOKE;

        //Step 9 - Modify Qty. to Receive
        WarehouseReceipt.WhseReceiptLines."Qty. to Receive".SETVALUE(1);

        //Step 10,11 - Add Backorder Type and Select 'No Backorder'
        // WarehouseReceipt.WhseReceiptLines."Backorder Type".SETVALUE(BackOrderType::"No Backorder");//BC UPGRADE KUMARR78 Blocking Due to variable Removed


        //Step 12, 13 - Select Item Tracking Code
        //HEI.17>>
        ItemUnitofMeasure.SETRANGE(Code, Item."Sales Unit of Measure");
        ItemUnitofMeasure.SETRANGE("Item No.", Item."No.");
        IF ItemUnitofMeasure.FINDFIRST THEN
            ItemTrackingQtyBase := WarehouseReceipt.WhseReceiptLines."Qty. to Receive".ASDECIMAL * ItemUnitofMeasure."Qty. per Unit of Measure"
        ELSE
            //HEI.17<<
            ItemTrackingQtyBase := 1;
        WarehouseReceipt.WhseReceiptLines.ItemTrackingLines.INVOKE;

        //Step 14 - Add Return Reason Code
        // WarehouseReceipt.WhseReceiptLines."Return Reason Code".SETVALUE(ReturnReason.Code);//BC UPGRADE KUMARR78 Blocking DIT.

        //Step 15,16 - Open Return Control and add 'Counted Quantity' to Return Control
        // WarehouseReceipt.Action55002.INVOKE;//BC UPGRADE KUMARR78 DIT Action


        //Step 17 - Post Receipt
        WarehouseReceipt."Post Receipt".INVOKE;
        //HEI.02<<

    end;

