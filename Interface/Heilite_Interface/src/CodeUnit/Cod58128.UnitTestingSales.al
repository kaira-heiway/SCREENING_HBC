        SalesOrder.SalesLines.EXPAND(TRUE);

        //Step 12 - Availabilty Check
        // IF SalesOrder."Sales Line FactBox"."Item Availability".ASDECIMAL > 0 THEN;//BC UPGRADE KUMARR78>> Blocking As Action Was Removed.

        //Step 13 - Credit Limit and Overdue Limit Check
        // IF SalesOrder."Customer Details FactBox"."Credit Limit (LCY)".ASDECIMAL = Customer."Credit Limit (LCY)" THEN;//BC UPGRADE KUMARR78>> Blocking As Action Was Removed.

        //Step 14 - Attach links
        //Not needed - standard NAV functionality

        //Disable Workflows before Release
        SalesHeader.GET(SalesHeader."Document Type"::Order, SalesOrder."No.".VALUE);
        IF ApprovalsMgmt.IsSalesApprovalsWorkflowEnabled(SalesHeader) THEN BEGIN
            Workflow.SETRANGE(Enabled, TRUE);
            IF Workflow.FINDSET THEN
                REPEAT
                    Workflow.Enabled := FALSE;
                    Workflow.MODIFY;
                UNTIL Workflow.NEXT = 0;
        END;

        //HEI.15>>
        IF SalesReceivablesSetup."SO Mandatory For Cash Cust FND" THEN BEGIN
            SalesOrder."Applies-to Doc. Type".SETVALUE(1);
            SalesOrder."Applies-to Doc. No.".SETVALUE('Payment_Test');
        END; //HEI.27 //HEI.38
             //HEI.15<<

        //Step 15 - Send Approval Request or Release
        SalesOrder.Release.INVOKE;

        //Step 16 - Print Sales Order Confirmation
        //Check if Report Selection is configured for Order
        ReportSelections.SETRANGE(Usage, ReportSelections.Usage::"S.Order");
        ReportSelections.SETRANGE("Document Subtype Code FND", SalesOrder."Document Subtype Code".VALUE);

        //Update the Report ID with 50257 - Order Confirmation STD
        IF ReportSelections.FINDFIRST THEN BEGIN
            ReportSelections.VALIDATE("Report ID", 53005);//BC Upgrade VAMSIU01 50257-53005
            ReportSelections.MODIFY;
        END ELSE BEGIN
            ReportSelections.INIT;
            ReportSelections.VALIDATE(Usage, ReportSelections.Usage::"S.Order");
            ReportSelections.VALIDATE("Document Subtype Code FND", SalesOrder."Document Subtype Code".VALUE);
            ReportSelections.VALIDATE("Report ID", 53005);//BC Upgrade VAMSIU01 50257-53005
            ReportSelections.INSERT;
        END;

        //Close Sales Order Page
        SalesOrder.OK.INVOKE;
        //HEI.01<<

    end;

