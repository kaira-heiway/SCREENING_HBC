        SalesOrder.SalesLines.Quantity.SETVALUE(1);
        //SalesOrder.SalesLines."Location Code".SETVALUE(Location.Code); //HEI.19

        //Check Status = Open
        SalesOrder.Status.ASSERTEQUALS(0);
        SalesOrder.Close(); //HEI.19

        commit();

        //Create Order with Status = Pending Approval
        SalesOrder.OPENNEW; //HEI.19
        SalesOrder.NEW;
        SalesOrder."No.".ASSISTEDIT;
        // BC Upgrade PATELP08 >>
