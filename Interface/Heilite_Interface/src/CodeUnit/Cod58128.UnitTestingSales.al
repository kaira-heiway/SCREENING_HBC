        //BC UPGRADE KUMARR78 << Blocking DIT Code 
        //HEI.36<<

        //HEI.19>>
        //Update user Setup

        //BC UPGRADE KUMARR78 >> Blocking DIT Code 
        // UserSetup.GET(USERID);
        // IF NOT UserSetup."Unlimited Cr. Limit Customer" THEN BEGIN
        //     UserSetup."Unlimited Cr. Limit Customer" := TRUE;
