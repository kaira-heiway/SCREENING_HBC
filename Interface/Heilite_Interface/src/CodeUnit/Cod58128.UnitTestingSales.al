    procedure SLS011_InactivateACustomer_Temporary();
    var
        Customer: Record Customer;
        BlockedReason: Record "Blocked Reason FND";
        CustomerList: TestPage "Customer List";
        CustomerCard: TestPage "Customer Card";
        SalesOrderList: TestPage "Sales Order List";
        SalesOrder: TestPage "Sales Order";
        CustBlockedErr: TextConst ENU = 'Validation error for Field: Sell-to Customer Name,  Message = ''You cannot create this type of document when Customer %1 is blocked with type All (Select Refresh to discard errors)''', FRA = 'Vous ne pouvez pas %1 ce type de document lorsque le client %2 est bloqué avec le type %3';
    begin
        ClearVariables('SLS011'); //HEI.31
        //HEI.09>>
        //Check default value for Customer
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS011', COMPANYNAME, DATABASE::Customer);
        Customer.GET(UnitTestingValues.Value);

        //Check default value for Blocked Reason
        UnitTestingValues.RESET;
        UnitTestingValues.GET('SLS011', COMPANYNAME, DATABASE::"Blocked Reason FND");
        BlockedReason.GET(UnitTestingValues.Value);

        //Step 1,2,3,4 - Open Customer Card
        CustomerList.OPENVIEW;

        CustomerCard.OPENEDIT;
        //HEI.21>>
        //CustomerCard.FINDFIRSTFIELD("No.",Customer."No.");
        CustomerCard.FILTER.SETFILTER("No.", Customer."No.");
        //HEI.21<<

        //Step 5 - Set Blocked = All
        CustomerCard.Blocked.SETVALUE(3);
        CustomerCard."Blocked Reason Code".SETVALUE(BlockedReason.Code);

        //Step 6 - Close Customer Card
        CustomerCard.Close();

        //Step 7,8 - Open Sales Order Card page
        SalesOrderList.OPENVIEW;
        SalesOrder.OPENNEW;

        //Step 9 - Create new Sales Order
        SalesOrder.NEW;
        SalesOrder."No.".ASSISTEDIT;

        //Step 10,11 - Add Sell-to Customer No (blocked) and receive error
        //ASSERTERROR 
        // BC Upgrade PATELP08 >>
        // SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");
        // BC Upgrade PATELP08 <<
        ASSERTERROR SalesOrder."Sell-to Customer Name".SETVALUE(Customer."No.");


        IF GETLASTERRORTEXT <> STRSUBSTNO(CustBlockedErr, Customer."No.") THEN
            ERROR('Unexpected Error: %1', GETLASTERRORTEXT);

        SalesOrder.OK.INVOKE;

        //HEI.09<<
    end;

