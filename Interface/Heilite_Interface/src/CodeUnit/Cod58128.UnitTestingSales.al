    [ModalPageHandler]
    procedure DimensionSetEntriesModalPageHandler(var EditDimensionSetEntries: TestPage "Edit Dimension Set Entries");
    var
        DefaultDimension: Record "Default Dimension";
        DefaultDimensionValue: Record "Dimension Value";
        ItemCharge: Record "Item Charge";
        GLAccount: Record "G/L Account";
        Customer: Record Customer;
        GeneralPostingSetup: Record "General Posting Setup";
    begin
        //HEI.04>>
        IF NOT EditDimensionSetEntries.FINDFIRSTFIELD("Dimension Code", DimensionValue."Dimension Code") THEN BEGIN
            EditDimensionSetEntries.NEW;
            EditDimensionSetEntries."Dimension Code".SETVALUE(DimensionValue."Dimension Code");
            EditDimensionSetEntries.DimensionValueCode.SETVALUE(DimensionValue.Code);
        END;

        IF NOT EditDimensionSetEntries.FINDFIRSTFIELD("Dimension Code", DimensionValue2."Dimension Code") THEN BEGIN
            EditDimensionSetEntries.NEW;
            EditDimensionSetEntries."Dimension Code".SETVALUE(DimensionValue2."Dimension Code");
            EditDimensionSetEntries.DimensionValueCode.SETVALUE(DimensionValue2.Code);
        END;

        IF NOT EditDimensionSetEntries.FINDFIRSTFIELD("Dimension Code", DimensionValue3."Dimension Code") THEN BEGIN
            EditDimensionSetEntries.NEW;
            EditDimensionSetEntries."Dimension Code".SETVALUE(DimensionValue3."Dimension Code");
            EditDimensionSetEntries.DimensionValueCode.SETVALUE(DimensionValue3.Code);
        END;

        //HEI.15>>
        IF NOT EditDimensionSetEntries.FINDFIRSTFIELD("Dimension Code", DimensionValue4."Dimension Code") THEN BEGIN
            EditDimensionSetEntries.NEW;
            EditDimensionSetEntries."Dimension Code".SETVALUE(DimensionValue4."Dimension Code");
            EditDimensionSetEntries.DimensionValueCode.SETVALUE(DimensionValue4.Code);
        END;

        IF (ItemChargeNo <> '') AND (CustomerNoFilter <> '') THEN BEGIN
            ItemCharge.GET(ItemChargeNo);
            Customer.GET(CustomerNoFilter);

            IF ItemCharge."Gen. Prod. Posting Group" <> '' THEN BEGIN
                GeneralPostingSetup.GET(Customer."Gen. Bus. Posting Group", ItemCharge."Gen. Prod. Posting Group");
                GLAccount.GET(GeneralPostingSetup."Sales Account");

                DefaultDimension.RESET;
                DefaultDimension.SETRANGE("Table ID", 15);
                DefaultDimension.SETRANGE("No.", GLAccount."No.");
                DefaultDimension.SETRANGE("Value Posting", DefaultDimension."Value Posting"::"Code Mandatory");
                IF DefaultDimension.FINDSET THEN
                    REPEAT
                        DefaultDimensionValue.RESET;
                        DefaultDimensionValue.SETRANGE("Dimension Code", DefaultDimension."Dimension Code");
                        DefaultDimensionValue.SETRANGE(Blocked, FALSE);
                        IF DefaultDimensionValue.FINDFIRST THEN BEGIN
                            IF NOT EditDimensionSetEntries.FINDFIRSTFIELD("Dimension Code", DefaultDimensionValue."Dimension Code") THEN BEGIN
                                EditDimensionSetEntries.NEW;
                                EditDimensionSetEntries."Dimension Code".SETVALUE(DefaultDimensionValue."Dimension Code");
                                EditDimensionSetEntries.DimensionValueCode.SETVALUE(DefaultDimensionValue.Code);
                            END;
                        END;
                    UNTIL DefaultDimension.NEXT = 0;
            END;
        END;
        //HEI.15<<

        //HEI.21>>
        IF NOT EditDimensionSetEntries.FINDFIRSTFIELD("Dimension Code", DimensionValue5."Dimension Code") THEN BEGIN
            EditDimensionSetEntries.NEW;
            EditDimensionSetEntries."Dimension Code".SETVALUE(DimensionValue5."Dimension Code");
            EditDimensionSetEntries.DimensionValueCode.SETVALUE(DimensionValue5.Code);
        END;
        //HEI.22<<

        EditDimensionSetEntries.OK.INVOKE;
        //HEI.04<<
    end;

    [ModalPageHandler]
    procedure ItemChargeAssignmentSalesModalPageHandler(var ItemChargeAssignmentSales: TestPage "Item Charge Assignment (Sales)");
    begin
        //HEI.04>>
        ItemChargeAssignmentSales.GetShipmentLines.INVOKE;
        ItemChargeAssignmentSales.SuggestItemChargeAssignment.INVOKE;
