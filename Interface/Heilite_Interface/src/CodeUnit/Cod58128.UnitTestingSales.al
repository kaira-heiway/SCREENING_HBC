    procedure OTC053_CreateProformaInvoice_ManuallyFromTheOrder();
    var
        Customer: Record Customer;
        Item: Record Item;
        // Route: Record "2014072";//BC UPGRADE KUMARR78 Blocking DIT variable
        Route: Record Route107FDW;//BC Upgrade VAMSIU01
